# Umami analytics (optional)
# Either set these here / in Cloudflare, OR set the fallback in src/config/analytics.ts
# so the value lives in the repo and won't disappear after redeploys.
#
# Get your values from: Umami dashboard → Websites → your site
# PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
