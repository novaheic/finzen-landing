---
/**
 * Hero.astro — Homepage philosophy-first hero.
 * This is the opening statement. Sets tone for the entire page.
 *
 * Content is placeholder — final copy TBD.
 * Structure: tagline → headline → subtext → CTA → contextual angle links
 */

import { APP_URL } from '@/data/pages';
---

<section class="w-full min-h-[70vh] flex flex-col items-center justify-center px-6 py-24 bg-gradient-to-b from-white to-stone-50">
  <div class="max-w-3xl mx-auto text-center space-y-6">

    <!-- Eyebrow / Tagline -->
    <p class="text-sm font-medium text-emerald-700 uppercase tracking-widest">
      {/* COPY PLACEHOLDER: A brief, calm tagline. "Financial mindfulness" or similar. */}
      Financial mindfulness. Daily.
    </p>

    <!-- Main Headline -->
    <h1 class="text-3xl md:text-5xl lg:text-6xl font-semibold text-stone-800 leading-tight tracking-tight">
      {/* COPY PLACEHOLDER: The core hook. Reframes what a finance app is. */}
      Spend 3 minutes a day.<br />
      Gain a lifetime of clarity.
    </h1>

    <!-- Subtext -->
    <p class="text-base md:text-xl text-stone-500 leading-relaxed max-w-2xl mx-auto">
      {/* COPY PLACEHOLDER: Expand on the promise. Calm, not hype. */}
      Finzen is a personal finance app built around one idea: manual awareness compounds into
      calm, clear financial understanding. No bank connections. No automation. Just you.
    </p>

    <!-- Primary CTA -->
    <div class="pt-4">
      <a
        href={APP_URL}
        class="inline-flex items-center gap-2 px-7 py-3.5 bg-emerald-700 text-white text-base font-medium rounded-xl hover:bg-emerald-800 transition-colors shadow-sm"
      >
        Start Your Practice
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Contextual angle links (not all — curated) -->
    <div class="pt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
      <a href="/daily-expense-tracker" class="text-sm text-stone-400 hover:text-emerald-700 transition-colors">
        Daily habit →
      </a>
      <a href="/privacy-first-finance-app" class="text-sm text-stone-400 hover:text-emerald-700 transition-colors">
        Privacy first →
      </a>
      <a href="/visual-financial-insights" class="text-sm text-stone-400 hover:text-emerald-700 transition-colors">
        See your money →
      </a>
    </div>
  </div>
</section>
