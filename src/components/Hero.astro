---
/**
 * Hero.astro — Homepage hero. Consolidation hook.
 * This is the opening statement. Sets tone for the entire page.
 *
 * Content is provisional — final copy TBD during beta.
 * Structure: tagline → headline → subtext → CTA → contextual angle links
 *
 * Narrative intent: "Stop juggling. One app does it all."
 * Layered with calm, mindful tone — not hype.
 */

import { APP_URL } from '@/data/pages';
---

<section class="w-full min-h-[70vh] flex flex-col items-center justify-center px-6 py-24 bg-gradient-to-b from-[#ECECEC] to-neutral-200 dark:from-[#1B1B1B] dark:to-neutral-900">
  <div class="max-w-3xl mx-auto text-center space-y-6">

    <!-- Eyebrow / Tagline -->
    <p class="text-sm font-medium text-neutral-900 dark:text-neutral-100 uppercase tracking-widest">
      Personal finance. All in one place.
    </p>

    <!-- Main Headline — consolidation hook -->
    <h1 class="text-3xl md:text-5xl lg:text-6xl font-semibold text-neutral-900 dark:text-neutral-100 leading-tight tracking-tight">
      Budget. Track. Invest.<br />
      Finally, one place for all of it.
    </h1>

    <!-- Subtext — expand the promise -->
    <p class="text-base md:text-xl text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl mx-auto">
      Finzen combines envelope budgeting, spending tracking, and portfolio management
      into one beautifully simple app. Privacy-first. No bank connections. Just a clear,
      complete picture of your finances.
    </p>

    <!-- Primary CTA -->
    <div class="pt-4">
      <a
        href={APP_URL}
        class="inline-flex items-center gap-2 px-7 py-3.5 bg-[#0a0a0a] text-white text-base font-medium rounded-xl hover:bg-neutral-800 dark:bg-white dark:text-[#1B1B1B] dark:hover:bg-neutral-200 transition-colors shadow-sm"
      >
        Get Started Free
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Contextual angle links -->
    <div class="pt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
      <a href="/privacy-first-finance-app" class="text-sm text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors">
        Privacy first →
      </a>
      <a href="/visual-financial-insights" class="text-sm text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors">
        See your money →
      </a>
      <a href="/manual-personal-finance-app" class="text-sm text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors">
        Why manual →
      </a>
    </div>
  </div>
</section>
