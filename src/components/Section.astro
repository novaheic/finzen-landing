---
/**
 * Section.astro — Generic content section wrapper.
 * Handles consistent padding, max-width, and optional heading.
 *
 * Usage:
 *   <Section heading="Why Manual Tracking Works" subheading="Optional subtitle">
 *     <p>Content here...</p>
 *   </Section>
 *
 *   <Section heading="Features" align="center">
 *     ...
 *   </Section>
 */

interface Props {
  /** Section heading (renders as <h2>) */
  heading?: string;
  /** Optional subheading below the heading */
  subheading?: string;
  /** Text alignment */
  align?: 'left' | 'center';
  /** Background variant */
  bg?: 'white' | 'stone' | 'dark' | 'gradient-soft' | 'liquidity';
  /** Additional CSS classes on the outer wrapper */
  class?: string;
}

const {
  heading,
  subheading,
  align = 'left',
  bg = 'white',
  class: extraClass = '',
} = Astro.props;

const bgClasses = {
  white: 'bg-white dark:bg-neutral-900',
  stone: 'bg-[#ECECEC] dark:bg-[#1B1B1B]',
  dark: 'bg-neutral-900 dark:bg-neutral-900 text-white',
  'gradient-soft': 'bg-gradient-to-b from-[#ECECEC] to-white dark:from-[#1B1B1B] dark:to-[#171717]',
  liquidity: 'bg-white dark:bg-[#171717]',
};

const alignClasses = {
  left: 'text-left',
  center: 'text-center',
};
---

<section class={`w-full py-16 md:py-24 ${bgClasses[bg]} ${extraClass} text-neutral-800 dark:text-neutral-200`}>
  <div class={`max-w-4xl mx-auto px-6 ${alignClasses[align]}`}>

    {heading && (
      <div class="mb-10 space-y-3">
        <h2 class={`text-2xl md:text-3xl font-semibold ${bg === 'dark' ? 'text-white' : 'text-neutral-900 dark:text-neutral-100'} leading-tight`}>
          {heading}
        </h2>
        {subheading && (
          <p class={`text-base md:text-lg ${bg === 'dark' ? 'text-neutral-300' : 'text-neutral-500 dark:text-neutral-400'} leading-relaxed max-w-2xl ${align === 'center' ? 'mx-auto' : ''}`}>
            {subheading}
          </p>
        )}
      </div>
    )}

    <slot />
  </div>
</section>
