---
/**
 * CTABlock.astro — Reusable call-to-action section.
 * Used at the bottom of homepage and angle pages.
 * Accepts custom heading and optional subtext.
 *
 * Usage:
 *   <CTABlock
 *     heading="Start your daily practice"
 *     subtext="No credit card. No bank connection. Just clarity."
 *   />
 */

import { APP_URL } from '@/data/pages';

interface Props {
  heading: string;
  subtext?: string;
  buttonLabel?: string;
}

const {
  heading,
  subtext,
  buttonLabel = 'Get Started Free',
} = Astro.props;
---

<section class="w-full py-20 md:py-28 px-6 bg-[#ECECEC] dark:bg-[#1B1B1B]">
  <div class="max-w-2xl mx-auto text-center space-y-5">

    <h2 class="text-2xl md:text-4xl font-semibold text-neutral-900 dark:text-neutral-100 leading-tight">
      {heading}
    </h2>

    {subtext && (
      <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
        {subtext}
      </p>
    )}

    <div class="pt-2">
      <a
        href={APP_URL}
        class="inline-flex items-center gap-2 px-7 py-3.5 bg-[#0a0a0a] text-white text-base font-medium rounded-xl hover:bg-neutral-800 dark:bg-white dark:text-[#1B1B1B] dark:hover:bg-neutral-200 transition-colors shadow-sm"
      >
        {buttonLabel}
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>
