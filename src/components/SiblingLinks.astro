---
/**
 * SiblingLinks.astro — "Continue exploring" links between angle pages.
 * Renders at the bottom of each angle page, above the CTA.
 * Accepts an array of slugs and looks up metadata from pages.ts.
 *
 * Usage:
 *   <SiblingLinks slugs={['simpleMoneyTracking', 'manualFinanceApp']} />
 */

import { pages } from '@/data/pages';

interface Props {
  /** Array of keys from the pages registry */
  slugs: string[];
}

const { slugs } = Astro.props;

const linkedPages = slugs
  .map((key) => pages[key])
  .filter(Boolean);
---

{linkedPages.length > 0 && (
  <section class="w-full py-10 px-6">
    <div class="max-w-3xl mx-auto">
      <p class="text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider mb-4">
        Continue exploring
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        {linkedPages.map((page) => (
          <a
            href={`/${page.slug}`}
            class="flex-1 p-4 border border-neutral-200 dark:border-neutral-700 rounded-lg hover:border-neutral-400 dark:hover:border-neutral-500 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors group"
          >
            <p class="text-sm font-medium text-neutral-800 dark:text-neutral-200 group-hover:text-neutral-900 dark:group-hover:text-white transition-colors">
              {page.footerLabel}
            </p>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5 line-clamp-2">
              {page.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
