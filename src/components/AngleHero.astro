---
/**
 * AngleHero.astro — Hero variant for angle pages.
 * Each angle page has its own H1 and positioning.
 * This component accepts props to customize per page.
 *
 * Usage:
 *   <AngleHero
 *     title="Daily Expense Tracker"
 *     subtitle="Build a 3-minute financial habit that compounds."
 *     keyword="daily expense tracker"
 *   />
 */

import { APP_URL } from '@/data/pages';

interface Props {
  /** Page-specific H1 — contains the primary keyword */
  title: string;
  /** Positioning statement below the title */
  subtitle: string;
  /** Primary keyword (for internal reference; title should contain it) */
  keyword?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="w-full py-20 md:py-28 px-6 bg-gradient-to-b from-stone-50 to-white">
  <div class="max-w-3xl mx-auto text-center space-y-5">

    <!-- Eyebrow -->
    <p class="text-sm font-medium text-emerald-700 uppercase tracking-widest">
      Finzen
    </p>

    <!-- Main H1 — unique per angle page, keyword-rich -->
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-semibold text-stone-800 leading-tight tracking-tight">
      {title}
    </h1>

    <!-- Positioning subtitle -->
    <p class="text-base md:text-lg text-stone-500 leading-relaxed max-w-xl mx-auto">
      {subtitle}
    </p>

    <!-- CTA -->
    <div class="pt-4">
      <a
        href={APP_URL}
        class="inline-flex items-center gap-2 px-6 py-3 bg-emerald-700 text-white text-sm font-medium rounded-xl hover:bg-emerald-800 transition-colors"
      >
        Get Started Free
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>
