---
/**
 * AngleHero.astro — Hero variant for angle pages.
 * Each angle page has its own H1 and positioning.
 * This component accepts props to customize per page.
 *
 * Usage:
 *   <AngleHero
 *     title="Daily Expense Tracker"
 *     subtitle="Build a 3-minute financial habit that compounds."
 *     keyword="daily expense tracker"
 *   />
 */

import { APP_URL } from '@/data/pages';

interface Props {
  /** Page-specific H1 — contains the primary keyword */
  title: string;
  /** Positioning statement below the title */
  subtitle: string;
  /** Primary keyword (for internal reference; title should contain it) */
  keyword?: string;
  /** Optional eyebrow text above title (defaults to "Finzen") */
  eyebrow?: string;
}

const { title, subtitle, eyebrow = 'Finzen' } = Astro.props;
---

<section class="w-full py-20 md:py-28 px-6 bg-gradient-to-b from-[#ECECEC] to-neutral-200 dark:from-[#1B1B1B] dark:to-neutral-900">
  <div class="max-w-3xl mx-auto text-center space-y-5">

    <!-- Eyebrow -->
    <p class="text-sm font-medium text-neutral-900 dark:text-neutral-100 uppercase tracking-widest">
      {eyebrow}
    </p>

    <!-- Main H1 — unique per angle page, keyword-rich -->
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-semibold text-neutral-900 dark:text-neutral-100 leading-tight tracking-tight">
      {title}
    </h1>

    <!-- Positioning subtitle -->
    <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-xl mx-auto">
      {subtitle}
    </p>

    <!-- CTA -->
    <div class="pt-4">
      <a
        href={APP_URL}
        class="hero-cta inline-flex items-center gap-2 px-6 py-3 bg-[#0a0a0a] text-white text-sm font-medium rounded-xl hover:-translate-y-1 hover:shadow-[0_10px_40px_rgba(0,0,0,0.2)] dark:bg-white dark:text-[#1B1B1B] dark:hover:-translate-y-1 dark:hover:shadow-[0_12px_32px_rgba(0,0,0,0.65)] transition-all duration-200"
      >
        Launch Finzen
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* Shine effect: light mode only */
  .hero-cta {
    position: relative;
    overflow: hidden;
  }
  .hero-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 0%,
      transparent 45%,
      rgba(255, 255, 255, 0.35) 49%,
      rgba(255, 255, 255, 0.2) 50%,
      rgba(255, 255, 255, 0.35) 51%,
      transparent 55%,
      transparent 100%
    );
    transform: translateX(-100%);
    transition: transform 0.45s ease;
    pointer-events: none;
  }
  .hero-cta:hover::before {
    transform: translateX(100%);
  }
  /* Dark mode: disable shine */
  :global(.dark) .hero-cta::before {
    display: none;
  }
</style>
