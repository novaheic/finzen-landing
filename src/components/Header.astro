---
/**
 * Header.astro — Minimal top navigation.
 * Logo + single CTA. No clutter. Mobile-responsive.
 * Angle pages are discovered through content and footer, not nav.
 */

import { APP_URL } from '@/data/pages';
---

<header class="w-full">
  <nav
    aria-label="Main navigation"
    class="max-w-5xl mx-auto px-6 py-5 flex items-center justify-between"
  >
    <!-- Logo -->
    <a href="/" aria-label="Finzen — Home" class="group">
      <span class="text-xl font-semibold text-stone-800 tracking-tight group-hover:text-emerald-700 transition-colors">
        Finzen
      </span>
    </a>

    <!-- Single CTA -->
    <a
      href={APP_URL}
      class="inline-flex items-center gap-2 px-5 py-2.5 bg-emerald-700 text-white text-sm font-medium rounded-lg hover:bg-emerald-800 transition-colors"
    >
      Get Started
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </nav>
</header>
