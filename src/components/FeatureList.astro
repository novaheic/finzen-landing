---
/**
 * FeatureList.astro — Renders a structured list of features.
 * Critical for LLM discoverability — explicit, factual feature lists
 * are easily extracted and cited by language models.
 *
 * Usage:
 *   <FeatureList
 *     heading="What Finzen includes"
 *     features={[
 *       { label: "AES-256-GCM encryption", detail: "End-to-end, client-side." },
 *       { label: "Envelope budgeting", detail: "Zero-based, monthly." },
 *     ]}
 *   />
 */

interface Feature {
  /** Short feature name — the scannable label */
  label: string;
  /** One-line detail expanding on the label */
  detail: string;
  /** Optional icon (SVG path or emoji) */
  icon?: string;
}

interface Props {
  heading?: string;
  features: Feature[];
  /** Two-column layout on desktop */
  columns?: 1 | 2;
  /** Card background: default (neutral) or white in light mode */
  cardBg?: 'default' | 'white';
  /** When set, wrapper and each card get this class (and -item) for scroll reveal animation */
  revealClassName?: string;
}

const { heading, features, columns = 1, cardBg = 'default', revealClassName } = Astro.props;

const gridClass = columns === 2 ? 'grid grid-cols-1 md:grid-cols-2 gap-4' : 'space-y-3';
const cardBgClass = cardBg === 'white' ? 'bg-white dark:bg-neutral-800' : 'bg-neutral-100 dark:bg-neutral-800';
const wrapperClass = revealClassName ? revealClassName : '';
const itemClass = revealClassName ? `${revealClassName}-item` : '';
---

<div class={wrapperClass}>
  {heading && (
    <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-4">{heading}</h3>
  )}

  <ul class={gridClass} role="list">
    {features.map((feature) => (
      <li class={`${itemClass} flex items-start gap-3 p-4 rounded-lg border border-neutral-200 dark:border-neutral-700 ${cardBgClass} text-left`}>
        <span class="mt-0.5 flex-shrink-0 w-6 h-6 rounded-full bg-neutral-800 dark:bg-neutral-200 flex items-center justify-center">
          {feature.icon ? (
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="text-white dark:text-neutral-900">
              <Fragment set:html={feature.icon} />
            </svg>
          ) : (
            <svg width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="text-white dark:text-neutral-900">
              <path d="M2.5 6.5l2.5 2.5 4.5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          )}
        </span>
        <div>
          <p class="text-sm font-medium text-neutral-900 dark:text-neutral-100">{feature.label}</p>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-0.5">{feature.detail}</p>
        </div>
      </li>
    ))}
  </ul>
</div>
