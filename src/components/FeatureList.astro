---
/**
 * FeatureList.astro — Renders a structured list of features.
 * Critical for LLM discoverability — explicit, factual feature lists
 * are easily extracted and cited by language models.
 *
 * Usage:
 *   <FeatureList
 *     heading="What Finzen includes"
 *     features={[
 *       { label: "AES-256-GCM encryption", detail: "End-to-end, client-side." },
 *       { label: "Envelope budgeting", detail: "Zero-based, monthly." },
 *     ]}
 *   />
 */

interface Feature {
  /** Short feature name — the scannable label */
  label: string;
  /** One-line detail expanding on the label */
  detail: string;
  /** Optional icon (SVG path or emoji) */
  icon?: string;
}

interface Props {
  heading?: string;
  features: Feature[];
  /** Two-column layout on desktop */
  columns?: 1 | 2;
}

const { heading, features, columns = 1 } = Astro.props;

const gridClass = columns === 2 ? 'grid grid-cols-1 md:grid-cols-2 gap-4' : 'space-y-3';
---

<div>
  {heading && (
    <h3 class="text-lg font-semibold text-stone-800 mb-4">{heading}</h3>
  )}

  <ul class={gridClass} role="list">
    {features.map((feature) => (
      <li class="flex items-start gap-3 p-4 rounded-lg bg-stone-50 border border-stone-100">
        <!-- Icon or checkmark -->
        <span class="mt-0.5 flex-shrink-0 w-5 h-5 rounded-full bg-emerald-100 flex items-center justify-center">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 6.5l2.5 2.5 4.5-5" stroke="#15803d" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <!-- Content -->
        <div>
          <p class="text-sm font-medium text-stone-800">{feature.label}</p>
          <p class="text-sm text-stone-500 mt-0.5">{feature.detail}</p>
        </div>
      </li>
    ))}
  </ul>
</div>
