---
/**
 * Footer.astro — Full site map + brand snippet + CTA.
 * This is where angle pages live in navigation.
 * Provides crawlers and users a complete site overview.
 */

import { anglePages, APP_URL } from '@/data/pages';
---

<footer class="w-full border-t border-neutral-200 dark:border-neutral-700 bg-[#ECECEC] dark:bg-[#1B1B1B]">
  <div class="max-w-5xl mx-auto px-6 py-12">

    <!-- Top row: Brand | Explore | CTA — left and right columns split into top/bottom -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 footer-top-grid">

      <!-- Left column: top = Finzen + blurb, bottom = social -->
      <div class="footer-left-col flex flex-col gap-8 md:gap-10">
        <div class="space-y-3">
          <a href="/" aria-label="Finzen — Home" class="flex items-center gap-2 w-fit">
            <img
              src="/logo-light.webp"
              alt=""
              width="28"
              height="28"
              class="h-7 w-7 object-contain dark:hidden"
            />
            <img
              src="/logo-dark.webp"
              alt=""
              width="28"
              height="28"
              class="h-7 w-7 object-contain hidden dark:block"
            />
            <span class="font-logo text-xl font-extrabold text-[#0a0a0a] dark:text-white tracking-[0.01em]">Finzen</span>
          </a>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-xs">
            The zen personal finance tracker. Budgeting, spending, and investing — all in one place. Private, encrypted, and easy to understand.
          </p>
        </div>
        <nav aria-label="Social links" class="mt-auto flex items-center gap-3">
          <a href="https://www.instagram.com/finzen.app/" target="_blank" rel="noopener noreferrer" class="text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="https://www.reddit.com/r/finzen_app/" target="_blank" rel="noopener noreferrer" class="text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors" aria-label="Reddit">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .001-.463.33.33 0 0 0-.462 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/finzen-org/" target="_blank" rel="noopener noreferrer" class="text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="mailto:hi@finzen.org" class="text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors" aria-label="Email">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </a>
        </nav>
      </div>

      <!-- Explore pages column -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">Topics</h3>
        <nav aria-label="Site pages" class="space-y-1.5">
          {anglePages.map((page) => (
            <a
              href={`/${page.slug}`}
              class="block text-sm text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors"
            >
              {page.footerLabel}
            </a>
          ))}
        </nav>
      </div>

      <!-- Right column: top = Get started + button, bottom = Built with love -->
      <div class="footer-right-col flex flex-col gap-8 md:gap-10">
        <div class="space-y-2">
          <h3 class="text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">Get Started</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            2–3 minutes a day. That is all it takes. Start feeling connected to your money, try it today!
          </p>
          <a
            href={APP_URL}
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#0a0a0a] text-white text-sm font-medium rounded-lg hover:bg-neutral-800 dark:bg-white dark:text-[#1B1B1B] dark:hover:bg-neutral-200 transition-colors w-fit"
          >
            Launch Finzen App
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
        <p class="footer-built-with mt-auto text-base font-medium text-neutral-600 dark:text-neutral-400">
          Built with <span class="footer-heart" aria-hidden="true">❤</span> in Berlin
        </p>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 pt-6 border-t border-neutral-200 dark:border-neutral-700 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-neutral-500 dark:text-neutral-400">
        © {new Date().getFullYear()} Finzen. All rights reserved.
      </p>
      <nav aria-label="Legal links" class="flex gap-6">
        <a href="https://app.finzen.org/privacy" class="text-xs text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors">Privacy Policy</a>
        <a href="https://app.finzen.org/terms" class="text-xs text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors">Terms</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer-heart {
    color: #dc2626;
    display: inline-block;
  }
  :global(.dark) .footer-heart {
    color: #f87171;
  }
  .footer-built-with {
    letter-spacing: 0.02em;
  }
</style>
