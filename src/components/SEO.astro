---
/**
 * SEO.astro — Centralized <head> meta management.
 * Handles: title, description, canonical, Open Graph, Twitter Card, Schema.org.
 *
 * Usage:
 *   <SEO
 *     title="Page Title"
 *     description="Meta description"
 *     canonical="/slug"
 *     ogImage="/custom-og.png"  // optional, falls back to default
 *   />
 */

import type { PageMeta } from '@/data/pages';
import { SITE_URL, DEFAULT_OG_IMAGE, SITE_NAME } from '@/data/pages';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
}

const { title, description, canonical, ogImage } = Astro.props;
const fullUrl = `${SITE_URL}${canonical}`;
const resolvedOgImage = `${SITE_URL}${ogImage || DEFAULT_OG_IMAGE}`;

/**
 * Schema.org SoftwareApplication structured data.
 * Applied site-wide. Could be made page-specific later.
 */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Finzen',
  operatingSystem: 'Web',
  applicationCategory: 'FinanceApplication',
  description:
    'A privacy-first, manual personal finance app. Track expenses, manage budgets, and visualize your finances with AES-256 encryption and no bank connections.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    ratingCount: '1',
  },
  author: {
    '@type': 'Organization',
    name: 'Finzen',
  },
};
---

<!-- Title -->
<title>{title}</title>

<!-- Core Meta -->
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta charset="UTF-8" />

<!-- Canonical URL -->
<link rel="canonical" href={fullUrl} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={fullUrl} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />

<!-- Schema.org Structured Data -->
<script type="application/ld+json">{JSON.stringify(schema)}</script>

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Preconnect for Google Fonts (if used) -->
<!-- <link rel="preconnect" href="https://fonts.googleapis.com" /> -->
<!-- <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /> -->
