<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -20px 0px' }
    );

    const disconnectionRings = document.querySelector('.disconnection-rings');
    if (disconnectionRings) observer.observe(disconnectionRings);

    const heroImage = document.querySelector('.hero-image-reveal');
    if (heroImage) observer.observe(heroImage);

    document.querySelectorAll('.rocks-reveal').forEach((el) => observer.observe(el));

    const methodImage = document.querySelector('.method-image-reveal');
    if (methodImage) observer.observe(methodImage);
  });
</script>
