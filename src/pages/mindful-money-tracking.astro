---
/**
 * /mindful-money-tracking
 *
 * Angle: Manual tracking, mindfulness, intentional finance, anti-automation
 * Audience: People who value awareness over convenience
 * Intent: "I want a finance app that doesn't connect to my bank"
 *
 * Target Keywords:
 * - mindful money tracking
 * - manual expense tracker (10-100)
 * - budgeting app without bank sync (10-100)
 * - daily expense tracker (1K-10K)
 * - mindful budgeting (10-100)
 * - conscious spending (100-1K)
 * - financial wellness app (100-1K)
 * - intentional finance
 * - take control of finances
 * - financial peace of mind
 * - stop impulse buying
 * - where does my money go
 * - anxious about money
 */

import Layout from '@/layouts/Layout.astro';
import { pages } from '@/data/pages';
import AngleHero from '@/components/AngleHero.astro';
import Section from '@/components/Section.astro';
import FeatureList from '@/components/FeatureList.astro';
import CTABlock from '@/components/CTABlock.astro';
import SiblingLinks from '@/components/SiblingLinks.astro';

const meta = pages.mindfulMoneyTracking;

// Ring stats for "The disconnection problem" section
const R = 48;
const C = 2 * Math.PI * R;
const disconnectionRings = [
  { pct: 72, label: 'of households do not have a written financial plan' },
  { pct: 83, label: 'who set financial goals feel better about their finances within a year' },
  { pct: 69, label: 'of households have less than $1,000 in emergency savings.' },
].map(({ pct, label }) => ({ pct, label, offset: C * (1 - pct / 100) }));
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={`/${meta.slug}`}
>

  <AngleHero
    eyebrow="The Finzen Method"
    title="Mindful Money Management"
    subtitle="A zen garden for your finances. 2-3 minutes daily. Tend your money like a bonsai tree. Watch your wealth grow with intention."
    keyword="mindful budgeting"
  />

  <!-- Wrapper: full width, clip horizontal overflow only (overflow-x-clip avoids clipping top on mobile scale) -->
  <div class="w-full overflow-x-clip -mt-52 md:-mt-[21.2rem] mb-0 relative z-10 flex justify-center">
    <div class="hero-image-reveal w-max max-w-full min-w-0 shrink-0">
      <!-- Mobile: responsive + scale up. Desktop: fixed width, no scale, can overflow left/right -->
      <div class="scale-[1.15] md:scale-100 origin-center md:w-[960px] md:max-w-none">
        <img
          src="/images/mindful-money-tracking/hero_light.png"
          alt="Mindful money management — zen garden for your finances"
          class="w-auto max-w-full md:w-full h-auto rounded-lg block dark:hidden"
        />
        <img
          src="/images/mindful-money-tracking/hero_dark.png"
          alt="Mindful money management — zen garden for your finances"
          class="w-auto max-w-full md:w-full h-auto rounded-lg block hidden dark:block"
        />
      </div>
    </div>
  </div>

  <!-- ============================================================
       SECTION 1: THE ZEN GARDEN METAPHOR
       ============================================================ -->
  <Section
    heading="You don't hire someone else to tend your zen garden"
    bg="stone"
    class="mt-4 md:mt-0 !pt-12 md:!pt-2"
  >
    <div class="flex flex-col md:flex-row md:items-start md:gap-8 lg:gap-10">
      <!-- Text column (left on desktop) -->
      <div class="flex-1 min-w-0 max-w-2xl overflow-hidden">
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          A zen garden isn't built overnight. It's tended daily. Each stone placed intentionally. Each pattern raked with care. The practice itself creates the mastery.
        </p>
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          Your finances work the same way. Most people are on autopilot with their money. You can't fix what you don't feel connected to.
        </p>
        <!-- Mobile only: after second paragraph. Hidden under 450px; >=450px float right; <450px in line (but hidden) -->
        <div class="rocks-reveal md:hidden max-[449px]:hidden mb-4 min-[380px]:float-right min-[380px]:ml-4 min-[380px]:mb-4 min-[380px]:mt-0 w-fit">
          <img
            src="/images/mindful-money-tracking/stones.png"
            alt="Zen garden stones — intentional, mindful placement"
            class="rounded-lg max-w-[140px] min-[380px]:max-w-[160px] mx-auto min-[380px]:mx-0 block"
          />
        </div>
        <p class="text-lg font-medium text-neutral-700 dark:text-neutral-300 leading-relaxed mb-0">
          Finzen is a <strong>manual expense tracker</strong> by design. Every transaction you log is a stone placed intentionally. Every daily entry is a moment of awareness.
        </p>
        <div class="clear-both md:clear-none"></div>
      </div>
      <!-- Image: right column on desktop only -->
      <div class="rocks-reveal hidden md:block flex-shrink-0 w-full md:max-w-[270px] lg:max-w-[270px] p-6 lg:p-8">
        <img
          src="/images/mindful-money-tracking/stones.png"
          alt="Zen garden stones — intentional, mindful placement"
          class="w-full h-auto rounded-lg"
        />
      </div>
    </div>
  </Section>

  <!-- ============================================================
       SECTION 2: THE DISCONNECTION PROBLEM
       ============================================================ -->
  <Section
    heading="The disconnection problem"
    align="center"
  >
    <div class="disconnection-rings mb-20">
      {disconnectionRings.map(({ pct, label, offset }, i) => (
        <div class="ring-item" style={`--ring-offset: ${offset}; --ring-delay: ${i * 0.12}s`}>
          <div class="ring-wrapper">
            <svg class="ring-svg" viewBox="0 0 120 120" aria-hidden="true">
              <circle
                class="ring-track"
                cx="60"
                cy="60"
                r={R}
                fill="none"
                stroke-width="6"
              />
              <circle
                class="ring-progress"
                cx="60"
                cy="60"
                r={R}
                fill="none"
                stroke-width="6"
                stroke-dasharray={C}
                transform="rotate(-90 60 60)"
              />
            </svg>
            <span class="ring-pct">{pct}%</span>
          </div>
          <p class="ring-label">{label}</p>
        </div>
      ))}
    </div>

    <div class="max-w-2xl space-y-4 text-center mx-auto">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Most finance apps promise convenience through automation: link your accounts, sync transactions. But here's what actually happens: you stop paying attention. You become a spectator. The data is there, but you don't <em>see</em> it. You don't <em>feel</em> it.
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        When you're <strong>anxious about money</strong>, when you wonder <strong>where does my money go</strong>, it's often a visibility problem. Manual tracking has been proven to help bridge the disconnect.
      </p>
    </div>
  </Section>

  <!-- ============================================================
       SECTION 3: WHY MANUAL TRACKING
       ============================================================ -->
  <Section bg="stone" class="pt-8 pb-16 md:py-24">
    <div class="flex flex-col md:flex-row md:items-center md:gap-4 lg:gap-6">
      <!-- Image: left on desktop, above on mobile — mobile manual input screenshot.
           Size: wrapper is 50% column; images capped at max-w. Centered on mobile. -->
      <div class="method-image-reveal w-full md:w-1/2 flex-shrink-0 order-first md:order-none flex justify-center md:justify-start mb-6 md:mb-0">
        <img
          src="/images/mindful-money-tracking/method_light.png"
          alt="Finzen mobile app — manual transaction entry screen"
          class="w-full max-w-[260px] h-auto rounded-lg block dark:hidden"
        />
        <img
          src="/images/mindful-money-tracking/method_dark.png"
          alt="Finzen mobile app — manual transaction entry screen"
          class="w-full max-w-[260px] h-auto rounded-lg hidden dark:block"
        />
      </div>
      <!-- Title, text, checkmarks: right on desktop, below image on mobile -->
      <div class="w-full md:w-1/2 min-w-0 flex flex-col gap-4 order-last md:order-none">
        <h2 class="text-2xl md:text-3xl font-semibold text-neutral-900 dark:text-neutral-100 leading-tight">
          Why manual tracking?
        </h2>
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Spending, saving, investing, debt - each entry is a decision you own. That awareness is the path to <strong>taking control of your finances</strong>.
        </p>
        <ul class="space-y-2 list-none pl-0 mt-1">
          <li class="flex items-start gap-3 text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
            <span class="check-minimal check-align shrink-0" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l3 3 7-7"/></svg>
            </span>
            <span>Notice easy-to-miss patterns</span>
          </li>
          <li class="flex items-start gap-3 text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
            <span class="check-minimal check-align shrink-0" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l3 3 7-7"/></svg>
            </span>
            <span>See where your money really goes</span>
          </li>
          <li class="flex items-start gap-3 text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
            <span class="check-minimal check-align shrink-0" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l3 3 7-7"/></svg>
            </span>
            <span>Feel connected to your cash flow and portfolio</span>
          </li>
          <li class="flex items-start gap-3 text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
            <span class="check-minimal check-align shrink-0" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l3 3 7-7"/></svg>
            </span>
            <span>Discipline compounds into wisdom</span>
          </li>
        </ul>
      </div>
    </div>
  </Section>

  <!-- ============================================================
       SECTION 4: THE FINZEN METHOD (3-STEP FRAMEWORK)
       ============================================================ -->
  <Section
    heading="The Finzen Method"
    subheading="Tend. Observe. Grow."
  >
    <div class="mb-12 max-w-3xl mx-auto">
      <div class="aspect-video w-full max-w-[800px] mx-auto rounded-lg overflow-hidden bg-neutral-900 dark:bg-neutral-800">
        <video
          id="finzen-method-video"
          class="w-full h-full object-contain"
          src="/videos/onboarding-intro-h264fallback.mp4"
          poster="/videos/onboarding-poster.jpg"
          controls
          preload="metadata"
          playsinline
        >
          <p class="p-4 text-neutral-400">Your browser does not support the video tag. <a href="/videos/onboarding-intro-h264fallback.mp4" class="underline">Download the video</a>.</p>
        </video>
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const video = document.getElementById('finzen-method-video');
        if (video) video.volume = 0.5;
      });
    </script>

    <div class="max-w-3xl mx-auto space-y-12">

      <!-- Step 1: Tend — desktop: image left, text left -->
      <div class="space-y-3 text-center md:text-left">
        <div class="flex items-center justify-center gap-3 md:justify-start md:ml-[174px]">
          <div class="w-10 h-10 rounded-full bg-neutral-800 dark:bg-neutral-200 flex items-center justify-center flex-shrink-0">
            <span class="text-lg font-semibold text-white dark:text-neutral-900">1</span>
          </div>
          <h3 class="text-xl font-semibold text-neutral-900 dark:text-neutral-100">Tend (Daily Logging)</h3>
        </div>
        <div class="flex flex-col text-center md:flex-row md:items-center md:gap-6 md:text-left">
          <div class="mb-4 flex justify-center md:mb-0 md:flex-shrink-0">
            <img
              src="/images/mindful-money-tracking/daily-ritual.png"
              alt="Daily ritual — 2–3 minutes logging expenses like tending a bonsai"
              class="w-[150px] h-auto rounded-lg"
            />
          </div>
          <div class="space-y-3 md:flex-1 md:min-w-0">
            <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
              Your <strong>daily expense tracker</strong> ritual: 2-3 minutes each day. Log every transaction. Like watering a bonsai tree—small, consistent action.
            </p>
            <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
              Open Finzen. Enter today's spending. Check your budget status. Done. Just a tiny daily habit that creates connection.
            </p>
            <p class="text-sm text-neutral-500 dark:text-neutral-500 italic">
              Morning coffee while you log yesterday's expenses. Evening wind-down while you check if you're on track.
            </p>
          </div>
        </div>
      </div>

      <!-- Step 2: Observe — desktop: text left (same column as 1 & 3), image right -->
      <div class="space-y-3 text-center md:text-left">
        <div class="flex items-center justify-center gap-3 md:justify-start md:ml-[174px]">
          <div class="w-10 h-10 rounded-full bg-neutral-800 dark:bg-neutral-200 flex items-center justify-center flex-shrink-0">
            <span class="text-lg font-semibold text-white dark:text-neutral-900">2</span>
          </div>
          <h3 class="text-xl font-semibold text-neutral-900 dark:text-neutral-100">Observe (Visual Understanding)</h3>
        </div>
        <div class="flex flex-col text-center md:flex-row md:items-center md:gap-6 md:text-left">
          <div class="order-2 md:order-1 space-y-3 md:flex-1 md:min-w-0 mb-4 md:mb-0">
            <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
              Your zen garden reveals patterns. Sankey diagrams show money flowing like raked sand. Charts map your financial landscape. Monthly overviews let you step back and see the whole picture.
            </p>
            <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
              Budget vs. actual. Net worth timeline. Spending by category. Portfolio performance. Cash flow forecasting. Every daily entry becomes part of a larger story—a <strong>visual money tracker</strong> that makes sense of your financial life.
            </p>
            <p class="text-sm text-neutral-500 dark:text-neutral-500 italic">
              You don't need to be a finance expert to understand beautiful charts. The insights find you.
            </p>
          </div>
          <div class="order-1 md:order-2 mb-4 flex justify-center md:mb-0 md:flex-shrink-0">
            <img
              src="/images/mindful-money-tracking/observe.png"
              alt="Observe — Sankey diagrams and charts reveal your financial landscape"
              class="w-[150px] h-auto rounded-lg"
            />
          </div>
        </div>
      </div>

      <!-- Step 3: Grow — desktop: image left, text left -->
      <div class="space-y-3 text-center md:text-left">
        <div class="flex items-center justify-center gap-3 md:justify-start md:ml-[174px]">
          <div class="w-10 h-10 rounded-full bg-neutral-800 dark:bg-neutral-200 flex items-center justify-center flex-shrink-0">
            <span class="text-lg font-semibold text-white dark:text-neutral-900">3</span>
          </div>
          <h3 class="text-xl font-semibold text-neutral-900 dark:text-neutral-100">Grow (Intentional Action)</h3>
        </div>
        <div class="flex flex-col text-center md:flex-row md:items-center md:gap-6 md:text-left">
          <div class="mb-4 flex justify-center md:mb-0 md:flex-shrink-0">
            <img
              src="/images/mindful-money-tracking/growth-results.png"
              alt="Grow — Small daily habits compound into major change"
              class="w-[150px] h-auto rounded-lg"
            />
          </div>
          <div class="space-y-3 md:flex-1 md:min-w-0">
            <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
              Connection creates awareness. Awareness creates intention. Intention creates change.
            </p>
            <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
              You see you're overspending on dining out—so you adjust. You notice your investments are too concentrated—so you rebalance. You realize you're paying for three streaming services you never use—so you cancel.
            </p>
            <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
              From paycheck-to-paycheck to <strong>wealth building</strong>. From chaos to clarity. From anxiety to <strong>financial peace of mind</strong>. This is <strong>intentional spending</strong> in action.
            </p>
          </div>
        </div>
      </div>

    </div>
  </Section>

  <!-- ============================================================
       SECTION 4B: ENVELOPE BUDGETING DISCIPLINE
       ============================================================ -->
  <Section
    heading="The discipline of envelope budgeting"
    bg="stone"
  >
    <div class="max-w-2xl space-y-4">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        At the heart of the Finzen Method is <strong>envelope budgeting</strong>—also known as <strong>zero-based budgeting</strong>. Every dollar you earn gets assigned a purpose before the month begins.
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        $2,000 paycheck? You decide where it goes: $800 to rent, $400 to groceries, $200 to savings, $150 to dining out, $100 to utilities. Every single dollar has a purpose. Nothing floats in limbo.
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        This requires discipline. You can't spend money twice. When the "Dining Out" envelope is empty, you cook at home. When "Shopping" hits zero, you stop browsing.
      </p>
      <p class="text-lg font-medium text-neutral-700 dark:text-neutral-300 leading-relaxed">
        <strong>Category budgeting</strong> creates boundaries. Those boundaries create freedom. You know exactly what you can spend without guilt, without anxiety, without wondering if you're okay.
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Like tending a garden, <strong>envelope budget</strong> systems require daily attention. You log each expense. You watch your envelopes. You adjust when life happens. The practice builds awareness. The awareness builds control.
      </p>
      <p class="text-sm text-neutral-500 dark:text-neutral-500 mt-4">
        Want to dive deeper into envelope budgeting? See our complete <a href="/budgeting-app" class="underline hover:text-neutral-700 dark:hover:text-neutral-300">budgeting guide</a>.
      </p>
    </div>
  </Section>

  <!-- ============================================================
       SECTION 5: FROM BEGINNER TO MASTER GARDENER
       ============================================================ -->
  <Section
    heading="From beginner to master gardener"
    bg="stone"
    align="center"
  >
    <div class="mb-6 max-w-4xl mx-auto">
      <img
        src="/images/mindful-money-tracking/steps_light.png"
        alt="Growth journey — from seed to mature bonsai, daily practice leads to mastery"
        class="w-full max-w-full h-auto rounded-lg block dark:hidden"
      />
      <img
        src="/images/mindful-money-tracking/steps_dark.png"
        alt="Growth journey — from seed to mature bonsai, daily practice leads to mastery"
        class="w-full max-w-full h-auto rounded-lg hidden dark:block"
      />
    </div>

    <div class="max-w-2xl mx-auto space-y-4">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Whether you're a broke college student learning <strong>budgeting for beginners</strong> or managing a multi-million dollar portfolio, the journey is the same: daily practice leads to mastery.
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Beginners find clarity. They stop wondering "where does my money go?" They develop <strong>financial habits</strong> that compound over months and years.
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Advanced users find optimization. They track multi-asset portfolios. They forecast cash flow. They calculate risk-adjusted returns. They use Finzen as their <strong>financial wellness app</strong>—a complete system for understanding and growing wealth.
      </p>
      <p class="text-lg font-medium text-neutral-700 dark:text-neutral-300 italic leading-relaxed">
        "A seed becomes a sprout. A sprout becomes a tree. Same soil. Same water. Just time and intention."
      </p>
    </div>
  </Section>

  <!-- ============================================================
       SECTION 6: STOP IMPULSE BUYING
       ============================================================ -->
  <Section
    heading="Break the impulse cycle"
  >
    <div class="max-w-2xl space-y-4">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Want to <strong>stop impulse buying</strong>? Manual tracking is the solution hiding in plain sight.
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Impulse spending thrives in the dark. The quick Amazon order at 11pm. The "treat yourself" $6 latte. The small purchases that balloon into $400 by month's end.
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        When you know you'll have to log that purchase tonight—when you'll see it staring back at you in your <strong>daily expense tracker</strong>—you pause.
      </p>
      <p class="text-lg font-medium text-neutral-700 dark:text-neutral-300 leading-relaxed">
        "Do I really want to log this?" That moment of reflection changes everything. Awareness is the cure.
      </p>
    </div>
  </Section>

  <!-- ============================================================
       SECTION 7: DISCIPLINE PAYS OFF
       ============================================================ -->
  <Section
    heading="Discipline pays off"
    bg="stone"
  >
    <!-- IMAGE PLACEHOLDER: Results/testimonials -->
    <div class="bg-white dark:bg-neutral-900 border-2 border-dashed border-neutral-300 dark:border-neutral-700 rounded-lg p-8 mb-6 text-center max-w-4xl mx-auto">
      <p class="text-neutral-600 dark:text-neutral-400 font-medium mb-2">📸 Testimonials & Stats</p>
      <p class="text-sm text-neutral-500 dark:text-neutral-500"><strong>Put image at:</strong> <code>public/images/mindful-money-tracking/testimonials-stats.jpg</code><br/>Stat callouts with earth tones OR nature photos with quotes<br/>Grid or ~1200px wide</p>
    </div>

    <div class="max-w-2xl space-y-4">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        A zen garden isn't built in a day. Neither is <strong>financial freedom</strong>.
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        But here's what users report after a month of <strong>mindful budgeting</strong> with Finzen:
      </p>
      <ul class="space-y-2 ml-6">
        <li class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed list-disc">
          A feeling of connectedness with their finances
        </li>
        <li class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed list-disc">
          A personal relationship with their charts and statistics
        </li>
        <li class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed list-disc">
          No more money anxiety—just clarity
        </li>
        <li class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed list-disc">
          Fewer impulse purchases
        </li>
        <li class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed list-disc">
          Actual understanding of where their money goes
        </li>
      </ul>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Just 2-3 minutes a day. That's all it takes to <strong>take control of your finances</strong>.
      </p>
      <p class="text-lg font-medium text-neutral-700 dark:text-neutral-300 italic leading-relaxed">
        "I spend less time managing my finances now than I did when everything was 'automated.' And I actually understand what's happening."
      </p>
    </div>
  </Section>

  <!-- ============================================================
       SECTION 8: WHAT IS FINANCIAL WELLNESS?
       ============================================================ -->
  <Section
    heading="This is financial wellness"
  >
    <div class="max-w-2xl space-y-6">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        <strong>Financial wellness</strong> isn't just tracking numbers. It's building a relationship with your money. It's understanding + control + calm.
      </p>

      <div class="mt-6">
        <FeatureList
          columns={2}
          features={[
            {
              label: 'Understanding',
              detail: 'Know exactly where your money goes. No guessing. No "I think I\'m okay." Just certainty.'
            },
            {
              label: 'Control',
              detail: 'Every transaction is a choice you consciously make. Every budget adjustment is intentional.'
            },
            {
              label: 'Calm',
              detail: 'Replace money anxiety with money clarity. The unknown becomes known. Stress becomes peace.'
            },
            {
              label: 'Growth',
              detail: 'Small daily habits compound into major change. Discipline becomes freedom.'
            },
          ]}
        />
      </div>

