<style>
  /* Hero image: from below + fade on reveal */
  .hero-image-reveal {
    opacity: 0;
    transform: translateY(48px);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }
  .hero-image-reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Rocks: from right + fade on reveal */
  .rocks-reveal {
    opacity: 0;
    transform: translateX(40px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .rocks-reveal.in-view {
    opacity: 1;
    transform: translateX(0);
  }

  /* Method image: from below on mobile, from left on desktop */
  .method-image-reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  @media (min-width: 768px) {
    .method-image-reveal {
      transform: translateX(-40px);
    }
  }
  .method-image-reveal.in-view {
    opacity: 1;
    transform: translate(0);
  }

  .check-minimal {
    color: rgb(163 163 163);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .check-minimal.check-align {
    margin-top: 0.35em;
  }
  :global(.dark) .check-minimal {
    color: rgb(255 255 255);
  }

  .disconnection-rings {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    max-width: 56rem;
    margin-left: auto;
    margin-right: auto;
  }
  @media (min-width: 768px) {
    .disconnection-rings {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .ring-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    opacity: 0;
    transform: translateY(8px) scale(0.98);
  }

  .disconnection-rings.in-view .ring-item {
    animation: ring-appear 0.6s ease-out var(--ring-delay) forwards;
  }

  @keyframes ring-appear {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .ring-wrapper {
    position: relative;
    width: 140px;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .ring-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ring-track {
    stroke: rgb(229 229 229);
  }
  :global(.dark) .ring-track {
    stroke: rgb(64 64 64);
  }

  .ring-progress {
    stroke: rgb(23 23 23);
    stroke-linecap: round;
    stroke-dashoffset: 301.59;
  }

  .disconnection-rings.in-view .ring-progress {
    animation: ring-fill 0.9s ease-out var(--ring-delay) forwards;
  }
  :global(.dark) .ring-progress {
    stroke: rgb(250 250 250);
  }

  @keyframes ring-fill {
    from {
      stroke-dashoffset: 301.59;
    }
    to {
      stroke-dashoffset: var(--ring-offset);
    }
  }

  .ring-pct {
    position: relative;
    font-size: 1.75rem;
    font-weight: 700;
    color: rgb(23 23 23);
    line-height: 1;
  }
  :global(.dark) .ring-pct {
    color: rgb(250 250 250);
  }

  .ring-label {
    font-size: 0.875rem;
    line-height: 1.4;
    color: rgb(82 82 82);
    max-width: 18rem;
    margin: 0;
    text-align: center;
  }
  :global(.dark) .ring-label {
    color: rgb(163 163 163);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -20px 0px' }
    );

    const disconnectionRings = document.querySelector('.disconnection-rings');
    if (disconnectionRings) observer.observe(disconnectionRings);

    const heroImage = document.querySelector('.hero-image-reveal');
    if (heroImage) observer.observe(heroImage);

    document.querySelectorAll('.rocks-reveal').forEach((el) => observer.observe(el));

    const methodImage = document.querySelector('.method-image-reveal');
    if (methodImage) observer.observe(methodImage);
  });
</script>
