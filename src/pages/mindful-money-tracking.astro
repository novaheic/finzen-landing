    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const carousel = document.querySelector('.testimonial-carousel');
        if (!carousel) return;
        const track = carousel.querySelector('.testimonial-track');
        const dots = carousel.querySelectorAll('.testimonial-dot');
        const total = 4;
        let index = 0;
        let intervalId = 0;
        function goTo(i) {
          index = ((i % total) + total) % total;
          if (track) track.style.transform = `translateX(-${index * 25}%)`;
          dots.forEach((dot, d) => {
            dot.setAttribute('aria-current', d === index ? 'true' : null);
          });
        }
        function next() { goTo(index + 1); }
        function startInterval() {
          intervalId = setInterval(next, 5500);
        }
        function stopInterval() {
          if (intervalId) clearInterval(intervalId);
        }
        dots.forEach((dot, i) => {
          dot.addEventListener('click', () => { goTo(i); stopInterval(); startInterval(); });
        });
        carousel.addEventListener('mouseenter', stopInterval);
        carousel.addEventListener('mouseleave', startInterval);
        goTo(0);
        startInterval();
      });
    </script>

