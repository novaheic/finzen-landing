---
/**
 * /personal-finance-charts
 *
 * Angle: Visual learners, data visualization fans, analytics-minded users
 * Audience: People who want beautiful charts and visual insights
 * Intent: "I want to see my finances, not just read numbers"
 *
 * Target Keywords:
 * - personal finance charts (100-1K)
 * - budget sankey (10-100)
 * - money flow chart (100-1K)
 * - expense charts (100-1K)
 * - budget visualization (10-100)
 * - monthly financial report (100-1K)
 * - financial analytics (1K-10K)
 */

import Layout from '@/layouts/Layout.astro';
import { pages } from '@/data/pages';
import AngleHero from '@/components/AngleHero.astro';
import Section from '@/components/Section.astro';
import FeatureList from '@/components/FeatureList.astro';
import CTABlock from '@/components/CTABlock.astro';
import SiblingLinks from '@/components/SiblingLinks.astro';

const meta = pages.personalFinanceCharts;
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={`/${meta.slug}`}
>

  <AngleHero
    title="Your Finances, Visualized"
    subtitle="Monthly report cards, Sankey cash flows, spending trends, portfolio performance, net worth over time. This is what financial clarity looks like."
    keyword="financial insights & charts"
  />

  <!-- Hero: phone (left, in front) + laptop (right, behind), slide-in + drop-shadow -->
  <div class="hero-dual w-full overflow-x-clip -mt-32 md:-mt-[12rem] mb-0 relative z-10 flex justify-center items-end">
    <div class="hero-dual-inner relative flex justify-center items-end gap-0 w-full max-w-[1200px] min-h-0 md:min-h-[320px] px-4 -translate-y-20 md:translate-y-0">
      <!-- Laptop: slightly right of center, animates in from right, behind phone -->
      <div class="hero-laptop-wrap absolute inset-0 flex justify-center items-end pointer-events-none">
        <div class="hero-laptop-pos translate-x-[6%] md:translate-x-[12%] -translate-y-8 md:translate-y-0">
          <div class="hero-laptop-inner scale-[1.08] sm:scale-100 md:scale-100 origin-center w-max max-w-[100vw] sm:max-w-[640px] md:max-w-[1000px] min-w-0 shrink-0">
          <img
            src="/images/mindful-money-tracking/hero_light.png"
            alt="Finzen dashboard on laptop"
            class="hero-device-img w-auto max-w-full h-auto block dark:hidden"
          />
          <img
            src="/images/mindful-money-tracking/hero_dark.png"
            alt="Finzen dashboard on laptop"
            class="hero-device-img w-auto max-w-full h-auto hidden dark:block"
          />
          </div>
        </div>
      </div>
      <!-- Phone: left of center, in front, animates in from left -->
      <div class="hero-phone-wrap relative z-10 flex justify-center items-end translate-x-[-82%] md:translate-x-[-78%]">
        <div class="hero-phone-inner scale-[0.85] sm:scale-[0.9] md:scale-100 origin-bottom w-max max-w-[140px] sm:max-w-[175px] md:max-w-[240px] min-w-0 shrink-0">
          <img
            src="/images/our-story/mobile_networth_light.png"
            alt="Finzen net worth on phone"
            class="hero-device-img w-auto max-w-full h-auto block dark:hidden"
          />
          <img
            src="/images/our-story/mobile_networth_dark.png"
            alt="Finzen net worth on phone"
            class="hero-device-img w-auto max-w-full h-auto hidden dark:block"
          />
        </div>
      </div>
    </div>
  </div>

  <style>
    .hero-dual .hero-device-img {
      filter: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.15)) drop-shadow(0 4px 12px rgba(0, 0, 0, 0.1));
    }
    .dark .hero-dual .hero-device-img {
      filter: drop-shadow(0 12px 32px rgba(0, 0, 0, 0.4)) drop-shadow(0 4px 14px rgba(0, 0, 0, 0.2));
    }
    @keyframes heroSlideInLeft {
      0% { opacity: 0; transform: translateX(-60px); }
      25% { opacity: 1; transform: translateX(-45px); }
      100% { opacity: 1; transform: translateX(0); }
    }
    @keyframes heroSlideInRight {
      from { opacity: 0; transform: translateX(60px); }
      to { opacity: 1; transform: translateX(0); }
    }
    .hero-dual .hero-laptop-inner {
      opacity: 0;
      animation: heroSlideInRight 0.7s ease-out 0.15s forwards;
    }
    .hero-dual .hero-phone-inner {
      opacity: 0;
      animation: heroSlideInLeft 0.7s ease-out forwards;
    }
    /* Money skills section: image animates in from the right on scroll */
    .money-skills-image-reveal {
      opacity: 0;
      transform: translateX(60px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .money-skills-image-reveal.in-view {
      opacity: 1;
      transform: translateX(0);
    }
  </style>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add('in-view');
          });
        },
        { rootMargin: '0px 0px -40px 0px', threshold: 0.1 }
      );
      document.querySelectorAll('.money-skills-image-reveal').forEach((el) => observer.observe(el));
    });
  </script>

  <!-- Section 1: Great financial decisions start with a clear picture -->
  <Section
    heading="Great financial decisions start with a clear picture"
    bg="stone"
    class="-mt-12 !pt-0 md:mt-0 md:!pt-10"
  >
    <div class="flex flex-col md:flex-row md:items-start md:gap-8 lg:gap-10">
      <!-- Text column (left on desktop) -->
      <div class="flex-1 min-w-0 max-w-2xl overflow-hidden">
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          Whether you're trying to cut spending, grow your portfolio, or simply stop wondering where your paycheck went - visibility is the first step. Not spreadsheets. Not bank statements. A real, visual understanding of your financial life.
        </p>
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          That's what Finzen is built around. From monthly Sankey cash flow to the real-time net worth chart, every visualization is designed to give you insight you can act on.
        </p>
        <!-- Mobile only: after second paragraph (animates in from right) -->
        <div class="money-skills-image-reveal md:hidden max-[449px]:hidden mb-4 min-[380px]:float-right min-[380px]:ml-4 min-[380px]:mb-4 min-[380px]:mt-0 w-fit">
          <img
            src="/images/personal-finance-charts/sankey.png"
            alt="Sankey spending flow — money in, money out"
            class="rounded-lg max-w-[180px] min-[380px]:max-w-[200px] mx-auto min-[380px]:mx-0 block"
          />
        </div>
        <p class="text-lg font-medium text-neutral-700 dark:text-neutral-300 leading-relaxed mb-0">
          Your money has a story. It's time you read it.
        </p>
        <div class="clear-both md:clear-none"></div>
      </div>
      <!-- Image: right column on desktop only (animates in from right) -->
      <div class="money-skills-image-reveal hidden md:block flex-shrink-0 w-full md:max-w-[320px] lg:max-w-[340px] p-6 lg:p-8">
        <img
          src="/images/personal-finance-charts/sankey.png"
          alt="Sankey spending flow — money in, money out"
          class="w-full h-auto rounded-lg"
        />
      </div>
    </div>
  </Section>

  <!-- Section 2: Budget Visualization -->
  <Section
    heading="Budget charts that make sense"
  >
    {/*
      COPY PLACEHOLDER — Suggested talking points:
      - Visual budget vs. actual
      - Progress bars for each category
      - Color-coded (green = on track, red = over)
      - Instantly know where you stand

      Keywords to weave in: budget visualization, visual budget, expense charts
    */}
    <div class="max-w-2xl space-y-4">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        [COPY: Numbers in a table don't tell you much. Progress bars do. Each budget category shows a visual bar — green when you're on track, yellow when you're getting close, red when you've overspent.]
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        [COPY: One look and you know exactly where you stand in every category.]
      </p>
    </div>
  </Section>

  <!-- Section 3: Spending Trends -->
  <Section
    heading="Trends reveal what snapshots hide"
    bg="stone"
  >
    {/*
      COPY PLACEHOLDER — Suggested talking points:
      - Monthly/weekly trend lines
      - Spot patterns over time
      - "Am I spending more on food than last month?"
      - Long-term perspective

      Keywords to weave in: personal finance charts, money charts
    */}
    <div class="max-w-2xl space-y-4">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        [COPY: A single month's spending doesn't tell you much. But three months? Six months? A year? Now you see patterns. Now you see whether things are improving or getting worse.]
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        [COPY: Finzen's trend charts show your spending over time — by category, by total, by whatever you want to track.]
      </p>
    </div>
  </Section>

  <!-- Section 4: Portfolio Visualizations -->
  <Section
    heading="Portfolio at a glance"
  >
    {/*
      COPY PLACEHOLDER — Suggested talking points:
      - Asset allocation pie charts
      - Performance over time
      - Diversification view
      - Multi-asset breakdown

      Keywords to weave in: financial analytics
    */}
    <div class="max-w-2xl">
      <FeatureList
        columns={2}
        features={[
          { label: 'Allocation Pie Chart', detail: '[COPY: See your portfolio split across asset classes]' },
          { label: 'Performance Timeline', detail: '[COPY: Track portfolio value over weeks, months, years]' },
          { label: 'Asset Breakdown', detail: '[COPY: Drill into stocks, crypto, commodities, etc.]' },
          { label: 'Diversification View', detail: '[COPY: Spot over-concentration at a glance]' },
        ]}
      />
    </div>
  </Section>

  <!-- Section 5: Net Worth Timeline -->
  <Section
    heading="Watch your net worth grow"
    bg="stone"
  >
    {/*
      COPY PLACEHOLDER — Suggested talking points:
      - The most motivating chart in personal finance
      - Assets minus liabilities over time
      - See your financial trajectory
      - Celebrate the upward trend

      Keywords to weave in: net worth tracking
    */}
    <div class="max-w-2xl space-y-4">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        [COPY: The net worth timeline might be the most motivating chart in personal finance. It shows your total assets minus your total liabilities — over time.]
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        [COPY: When that line trends upward, you know you're building wealth. Even small gains feel meaningful when you can see the trajectory.]
      </p>
    </div>
  </Section>

  <!-- Section 6: Monthly Reports -->
  <Section
    heading="Monthly financial reports"
  >
    {/*
      COPY PLACEHOLDER — Suggested talking points:
      - Comprehensive monthly summary
      - Budget performance recap
      - Spending by category
      - Portfolio changes
      - Net worth delta

      Keywords to weave in: monthly financial report
    */}
    <div class="max-w-2xl space-y-4">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        [COPY: At the end of each month, Finzen generates a report: How did your budget perform? Where did you spend the most? How did your portfolio change? What's your net worth now vs. last month?]
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        [COPY: It's your personal financial statement — automatically generated from your daily entries.]
      </p>
    </div>
  </Section>

  <!-- Section 7: Visuals From Daily Habit -->
  <Section
    heading="The magic comes from consistency"
    bg="stone"
  >
    {/*
      COPY PLACEHOLDER — Suggested talking points:
      - These visualizations emerge from your daily entries
      - Day 1: Not much to see
      - Week 2: Patterns start
      - Month 1: Real insights
      - Month 3+: Full story

      Link to Manual Finance App page
    */}
    <div class="max-w-2xl space-y-4">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        [COPY: All these beautiful visualizations come from one simple habit: entering your transactions daily. Day one, there's not much to see. But after a week, patterns emerge. After a month, you have real insights. After three months, you have a complete financial story.]
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        [COPY: The visual power isn't magic — it's the reward for your daily practice.]
      </p>
    </div>
  </Section>


  <CTABlock
    heading="Start seeing your financial story"
    subtext="Daily entries. Beautiful visualizations. A complete picture — over time."
  />

  <SiblingLinks slugs={meta.siblings} />

</Layout>
