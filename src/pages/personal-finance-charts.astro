---
/**
 * /personal-finance-charts
 *
 * Angle: Visual learners, data visualization fans, analytics-minded users
 * Audience: People who want beautiful charts and visual insights
 * Intent: "I want to see my finances, not just read numbers"
 *
 * Target Keywords:
 * - personal finance charts (100-1K)
 * - budget sankey (10-100)
 * - money flow chart (100-1K)
 * - expense charts (100-1K)
 * - budget visualization (10-100)
 * - monthly financial report (100-1K)
 * - financial analytics (1K-10K)
 */

import Layout from '@/layouts/Layout.astro';
import { pages } from '@/data/pages';
import AngleHero from '@/components/AngleHero.astro';
import Section from '@/components/Section.astro';
import FeatureList from '@/components/FeatureList.astro';
import CTABlock from '@/components/CTABlock.astro';
import SiblingLinks from '@/components/SiblingLinks.astro';

const meta = pages.personalFinanceCharts;

// Ring stats for "The disconnect" section
const R = 48;
const C = 2 * Math.PI * R;
const disconnectionRings = [
  { pct: 25, plus: true, label: "of Americans say they're afraid to check their finances because they'll realize how much they're spending." },
  { pct: 86, label: 'of people who track their income and expenses say it has helped them get out, or stay out, of debt.' },
  { pct: 60, plus: true, label: 'of investors do not understand all the types of investments they hold in their own portfolio.' },
].map(({ pct, label, plus }) => ({ pct, label, plus, offset: C * (1 - pct / 100) }));
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={`/${meta.slug}`}
>

  <AngleHero
    title="Your Finances, Visualized"
    subtitle="Monthly report cards, Sankey cash flows, spending trends, portfolio performance, net worth over time. This is what financial clarity looks like."
    keyword="financial insights & charts"
  />

  <!-- Hero: phone (left, in front) + laptop (right, behind), slide-in + drop-shadow -->
  <div class="hero-dual w-full overflow-x-clip -mt-32 md:-mt-[12rem] mb-0 relative z-10 flex justify-center items-end">
    <div class="hero-dual-inner relative flex justify-center items-end gap-0 w-full max-w-[1200px] min-h-0 md:min-h-[320px] px-4 -translate-y-20 md:translate-y-0">
      <!-- Laptop: slightly right of center, animates in from right, behind phone -->
      <div class="hero-laptop-wrap absolute inset-0 flex justify-center items-end pointer-events-none">
        <div class="hero-laptop-pos translate-x-[6%] md:translate-x-[12%] -translate-y-8 md:translate-y-0">
          <div class="hero-laptop-inner scale-[1.08] sm:scale-100 md:scale-100 origin-center w-max max-w-[100vw] sm:max-w-[640px] md:max-w-[1000px] min-w-0 shrink-0">
          <img
            src="/images/mindful-money-tracking/hero_light.png"
            alt="Finzen dashboard on laptop"
            class="hero-device-img w-auto max-w-full h-auto block dark:hidden"
          />
          <img
            src="/images/mindful-money-tracking/hero_dark.png"
            alt="Finzen dashboard on laptop"
            class="hero-device-img w-auto max-w-full h-auto hidden dark:block"
          />
          </div>
        </div>
      </div>
      <!-- Phone: left of center, in front, animates in from left -->
      <div class="hero-phone-wrap relative z-10 flex justify-center items-end translate-x-[-82%] md:translate-x-[-78%]">
        <div class="hero-phone-inner scale-[0.85] sm:scale-[0.9] md:scale-100 origin-bottom w-max max-w-[140px] sm:max-w-[175px] md:max-w-[240px] min-w-0 shrink-0">
          <img
            src="/images/our-story/mobile_networth_light.png"
            alt="Finzen net worth on phone"
            class="hero-device-img w-auto max-w-full h-auto block dark:hidden"
          />
          <img
            src="/images/our-story/mobile_networth_dark.png"
            alt="Finzen net worth on phone"
            class="hero-device-img w-auto max-w-full h-auto hidden dark:block"
          />
        </div>
      </div>
    </div>
  </div>

  <style>
    .hero-dual .hero-device-img {
      filter: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.15)) drop-shadow(0 4px 12px rgba(0, 0, 0, 0.1));
    }
    .dark .hero-dual .hero-device-img {
      filter: drop-shadow(0 12px 32px rgba(0, 0, 0, 0.4)) drop-shadow(0 4px 14px rgba(0, 0, 0, 0.2));
    }
    @keyframes heroSlideInLeft {
      0% { opacity: 0; transform: translateX(-60px); }
      25% { opacity: 1; transform: translateX(-45px); }
      100% { opacity: 1; transform: translateX(0); }
    }
    @keyframes heroSlideInRight {
      from { opacity: 0; transform: translateX(60px); }
      to { opacity: 1; transform: translateX(0); }
    }
    .hero-dual .hero-laptop-inner {
      opacity: 0;
      animation: heroSlideInRight 0.7s ease-out 0.15s forwards;
    }
    .hero-dual .hero-phone-inner {
      opacity: 0;
      animation: heroSlideInLeft 0.7s ease-out forwards;
    }
    /* Money skills section: image animates in from the right on scroll */
    .money-skills-image-reveal {
      opacity: 0;
      transform: translateX(60px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .money-skills-image-reveal.in-view {
      opacity: 1;
      transform: translateX(0);
    }

    /* Sankey image: drop shadow in light mode only (image has transparency) */
    .sankey-img {
      filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.1)) drop-shadow(0 2px 8px rgba(0, 0, 0, 0.06));
    }
    :global(.dark) .sankey-img {
      filter: none;
    }

    /* Cashflow section image: strong shadow in light mode (white on white separation); dark = glow only */
    .cashflow-img {
      filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1)) drop-shadow(0 14px 36px rgba(0, 0, 0, 0.22)) drop-shadow(0 2px 6px rgba(0, 0, 0, 0.08));
    }
    :global(.dark) .cashflow-img {
      filter: drop-shadow(0 0 15px rgba(255, 255, 255, 0.1));
    }

    /* Cashflow section: first image animates in from left, second (Sankey) from right */
    .cashflow-reveal-left {
      opacity: 0;
      transform: translateX(-60px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .cashflow-reveal-left.in-view {
      opacity: 1;
      transform: translateX(0);
    }
    .cashflow-reveal-right {
      opacity: 0;
      transform: translateX(60px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .cashflow-reveal-right.in-view {
      opacity: 1;
      transform: translateX(0);
    }

    /* The disconnect: ring stats */
    .disconnection-rings {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.5rem;
      max-width: 56rem;
      margin-left: auto;
      margin-right: auto;
    }
    @media (min-width: 768px) {
      .disconnection-rings {
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
      }
    }
    .ring-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
    .disconnection-rings.in-view .ring-item {
      animation: ring-appear 0.6s ease-out var(--ring-delay) forwards;
    }
    @keyframes ring-appear {
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
    .ring-wrapper {
      position: relative;
      width: 140px;
      height: 140px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1rem;
    }
    .ring-svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    .ring-track {
      stroke: rgb(229 229 229);
    }
    :global(.dark) .ring-track {
      stroke: rgb(64 64 64);
    }
    .ring-progress {
      stroke: rgb(23 23 23);
      stroke-linecap: round;
      stroke-dashoffset: 301.59;
    }
    .disconnection-rings.in-view .ring-progress {
      animation: ring-fill 0.9s ease-out var(--ring-delay) forwards;
    }
    :global(.dark) .ring-progress {
      stroke: rgb(250 250 250);
    }
    @keyframes ring-fill {
      from {
        stroke-dashoffset: 301.59;
      }
      to {
        stroke-dashoffset: var(--ring-offset);
      }
    }
    .ring-pct {
      position: relative;
      font-size: 1.75rem;
      font-weight: 700;
      color: rgb(23 23 23);
      line-height: 1;
    }
    :global(.dark) .ring-pct {
      color: rgb(250 250 250);
    }
    .ring-label {
      font-size: 0.875rem;
      line-height: 1.4;
      color: rgb(82 82 82);
      max-width: 18rem;
      margin: 0;
      text-align: center;
    }
    :global(.dark) .ring-label {
      color: rgb(163 163 163);
    }

    /* Trends section demo card: profit/loss */
    .text-profit { color: #22c55e; }
    .text-loss { color: #ef4444; }
    :global(.dark) .text-profit { color: #4ade80; }
    :global(.dark) .text-loss { color: #f87171; }

    /* Stop Guessing. Start Knowing. – 6 cards animate in */
    .stop-guessing-cards-item {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    }
    .stop-guessing-cards.in-view .stop-guessing-cards-item {
      opacity: 1;
      transform: translate(0);
    }
    .stop-guessing-cards.in-view .stop-guessing-cards-item:nth-child(1) { transition-delay: 0ms; }
    .stop-guessing-cards.in-view .stop-guessing-cards-item:nth-child(2) { transition-delay: 80ms; }
    .stop-guessing-cards.in-view .stop-guessing-cards-item:nth-child(3) { transition-delay: 160ms; }
    .stop-guessing-cards.in-view .stop-guessing-cards-item:nth-child(4) { transition-delay: 240ms; }
    .stop-guessing-cards.in-view .stop-guessing-cards-item:nth-child(5) { transition-delay: 320ms; }
    .stop-guessing-cards.in-view .stop-guessing-cards-item:nth-child(6) { transition-delay: 400ms; }
  </style>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add('in-view');
          });
        },
        { rootMargin: '0px 0px -40px 0px', threshold: 0.1 }
      );
      document.querySelectorAll('.money-skills-image-reveal').forEach((el) => observer.observe(el));
      document.querySelectorAll('.cashflow-reveal-left, .cashflow-reveal-right').forEach((el) => observer.observe(el));
      const disconnectionRings = document.querySelector('.disconnection-rings');
      if (disconnectionRings) observer.observe(disconnectionRings);
      const stopGuessingCards = document.querySelector('.stop-guessing-cards');
      if (stopGuessingCards) observer.observe(stopGuessingCards);

      // Trends demo card: count-up on first view, then random updates every few seconds
      const trendsCards = document.querySelector('.trends-demo-cards');
      if (!trendsCards) return;
      const formatCurrency = (n) => '€' + Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const animateValue = (el, fromVal, toVal, formatter, duration = 600) => {
        const startTime = performance.now();
        const step = (now) => {
          const t = Math.min((now - startTime) / duration, 1);
          const eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
          const current = fromVal + (toVal - fromVal) * eased;
          el.textContent = formatter ? formatter(current) : Math.round(current);
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      let nwTotal = 0, nwInv = 0;
      const totalEl = trendsCards.querySelector('.trends-nw-total');
      const invEl = trendsCards.querySelector('.trends-nw-inv');
      const inEl = trendsCards.querySelector('.trends-nw-in');
      const outEl = trendsCards.querySelector('.trends-nw-out');
      const discEl = trendsCards.querySelector('.trends-nw-disc');
      const runFirstAnimation = () => {
        nwTotal = 2847.5;
        nwInv = 412.3;
        if (totalEl) animateValue(totalEl, 0, nwTotal, formatCurrency, 800);
        if (invEl) { invEl.textContent = '+€0.00'; invEl.classList.add('text-profit'); invEl.classList.remove('text-loss'); animateValue(invEl, 0, nwInv, (n) => '+' + formatCurrency(n).slice(1), 800); }
        if (inEl) animateValue(inEl, 0, 5200, formatCurrency, 800);
        if (outEl) animateValue(outEl, 0, 2764.8, formatCurrency, 800);
        if (discEl) animateValue(discEl, 0, 2435.2, formatCurrency, 800);
      };
      const runRandomUpdate = () => {
        const invDelta = (Math.random() * 100 - 50); // ±50
        const newInv = nwInv + invDelta;
        const totalDelta = invDelta + (Math.random() * 60 - 30); // move with inv + ±30
        const newTotal = Math.max(1200, Math.min(4200, nwTotal + totalDelta));
        if (totalEl) animateValue(totalEl, nwTotal, newTotal, formatCurrency);
        if (invEl) {
          invEl.classList.toggle('text-profit', newInv >= 0);
          invEl.classList.toggle('text-loss', newInv < 0);
          animateValue(invEl, nwInv, newInv, (n) => (n >= 0 ? '+' : '-') + formatCurrency(Math.abs(n)).slice(1));
        }
        nwTotal = newTotal;
        nwInv = newInv;
      };
      const trendsObserver = new IntersectionObserver(
        (entries) => {
          if (!entries[0]?.isIntersecting) return;
          trendsCards.classList.add('in-view');
          trendsObserver.disconnect();
          runFirstAnimation();
          setInterval(runRandomUpdate, 7500);
        },
        { threshold: 0.2 }
      );
      trendsObserver.observe(trendsCards);
    });
  </script>

  <!-- Section 1: Great financial decisions start with a clear picture -->
  <Section
    heading="Great financial decisions start with a clear picture"
    bg="stone"
    class="-mt-12 !pt-0 md:mt-0 md:!pt-10"
  >
    <div class="flex flex-col md:flex-row md:items-start md:gap-8 lg:gap-10">
      <!-- Text column (left on desktop) -->
      <div class="flex-1 min-w-0 max-w-2xl overflow-hidden">
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          Whether you're trying to cut spending, grow your portfolio, or simply stop wondering where your paycheck went - visibility is the first step. Not spreadsheets. Not bank statements. A real, visual understanding of your financial life.
        </p>
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          That's what Finzen is built around. From monthly Sankey cash flow to the real-time net worth chart, every visualization is designed to give you insight you can act on.
        </p>
        <!-- Mobile only: after second paragraph (animates in from right) -->
        <div class="money-skills-image-reveal md:hidden max-[449px]:hidden mb-4 min-[380px]:float-right min-[380px]:ml-4 min-[380px]:mb-4 min-[380px]:mt-0 w-fit">
          <img
            src="/images/personal-finance-charts/sankey.png"
            alt="Sankey spending flow — money in, money out"
            class="sankey-img rounded-lg max-w-[180px] min-[380px]:max-w-[200px] mx-auto min-[380px]:mx-0 block"
          />
        </div>
        <p class="text-lg font-medium text-neutral-700 dark:text-neutral-300 leading-relaxed mb-0">
          Your money has a story. It's time you read it.
        </p>
        <div class="clear-both md:clear-none"></div>
      </div>
      <!-- Image: right column on desktop only (animates in from right) -->
      <div class="money-skills-image-reveal hidden md:block flex-shrink-0 w-full md:max-w-[320px] lg:max-w-[340px] p-6 lg:p-8">
        <img
          src="/images/personal-finance-charts/sankey.png"
          alt="Sankey spending flow — money in, money out"
          class="sankey-img w-full h-auto rounded-lg"
        />
      </div>
    </div>
  </Section>

  <!-- Section 2: See your money clearly. Watch your decisions improve. -->
  <Section
    heading="See your money clearly. Watch your decisions improve."
    subheading="The power of data visualization and visual storytelling."
    align="center"
  >
    <div class="disconnection-rings mb-20">
      {disconnectionRings.map(({ pct, label, offset, plus }, i) => (
        <div class="ring-item" style={`--ring-offset: ${offset}; --ring-delay: ${i * 0.12}s`}>
          <div class="ring-wrapper">
            <svg class="ring-svg" viewBox="0 0 120 120" aria-hidden="true">
              <circle
                class="ring-track"
                cx="60"
                cy="60"
                r={R}
                fill="none"
                stroke-width="6"
              />
              <circle
                class="ring-progress"
                cx="60"
                cy="60"
                r={R}
                fill="none"
                stroke-width="6"
                stroke-dasharray={C}
                transform="rotate(-90 60 60)"
              />
            </svg>
            <span class="ring-pct">{pct}%{plus ? '+' : ''}</span>
          </div>
          <p class="ring-label">{label}</p>
        </div>
      ))}
    </div>

    <div class="max-w-2xl space-y-4 text-center mx-auto">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Most people have a rough sense of their finances. A ballpark. A feeling. But feelings aren't clarity, and a ballpark is just another word for a guess. The gap between what people think is happening with their money and what's actually happening is where anxiety lives.
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        <strong>Visibility changes everything. Not just for the numbers, but for the behavior.</strong>
      </p>
    </div>
  </Section>

  <!-- Section 3: Monthly Report (with Net Worth Change demo card) -->
  <Section
    heading="The Overview: Your Month at a Glance"
    subheading="Every number that mattered this month, organized into one clean, actionable report."
    align="center"
    bg="stone"
  >
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-center gap-8 lg:gap-10">
      <div class="min-w-0 max-w-2xl space-y-4 text-left mx-auto lg:mx-0 order-2 lg:order-1">
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Most people end the month with a vague sense of how it went. Too much on dining out, maybe. A decent month for the portfolio. Probably saved something. Probably.
        </p>
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Finzen's Monthly Overview replaces that vague feeling with a complete picture. Every month you track gets its live own report: how your spending compared to your budget, how your net worth moved, what your investments returned, and your discretionary income.
        </p>
      </div>
      <div class="trends-demo-cards grid grid-cols-1 gap-4 flex-shrink-0 w-full max-w-[300px] mx-auto lg:mx-0 order-1 lg:order-2">
        <!-- Net Worth Change card (demo values, animate on view) -->
        <div class="trends-card trends-nw-card rounded-xl border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 p-4 shadow-sm text-left">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 mb-1">Net Worth Change</div>
          <div class="text-2xl sm:text-3xl font-semibold leading-tight mb-3 text-neutral-900 dark:text-neutral-100">
            <span class="trends-nw-total" data-value="2847.5">€0</span>
          </div>
          <div class="text-xs space-y-1">
            <div class="flex items-center justify-between">
              <span class="text-[13px] text-neutral-600 dark:text-neutral-400 font-semibold">Investment P/L</span>
              <span class="text-base font-semibold text-profit trends-nw-inv" data-value="412.3">+€0</span>
            </div>
            <div class="flex items-center justify-between pl-3">
              <span class="text-neutral-600 dark:text-neutral-400">Inflows</span>
              <span class="font-semibold text-neutral-600 dark:text-neutral-400 trends-nw-in" data-value="5200">€0</span>
            </div>
            <div class="flex items-center justify-between pl-3">
              <span class="text-neutral-600 dark:text-neutral-400">Outflows</span>
              <span class="font-semibold text-neutral-600 dark:text-neutral-400">-<span class="trends-nw-out" data-value="2764.8">€0</span></span>
            </div>
            <div class="pt-1 mt-1 border-t border-neutral-300 dark:border-neutral-600"></div>
            <div class="flex items-center justify-between">
              <span class="text-[13px] text-neutral-600 dark:text-neutral-400 font-semibold">Discretionary Income</span>
              <span class="text-base font-semibold text-profit trends-nw-disc" data-value="2435.2">€0</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <p class="text-center font-semibold text-neutral-800 dark:text-neutral-200 mt-8 mb-0">
      One live report. Every month. No more guessing.
    </p>
    <div class="mt-6 flex justify-center">
      <img
        src="/images/personal-finance-charts/report_annotated_light.png"
        alt="Monthly report overview — annotated"
        class="w-full max-w-3xl h-auto rounded-lg block dark:hidden"
      />
      <img
        src="/images/personal-finance-charts/report_annotated_dark.png"
        alt="Monthly report overview — annotated"
        class="w-full max-w-3xl h-auto rounded-lg hidden dark:block"
      />
    </div>
    <div class="max-w-2xl mx-auto mt-12">
      <FeatureList
        columns={2}
        revealClassName="stop-guessing-cards"
        features={[
          { label: 'Net Worth Change', detail: 'Did you end the month richer or poorer, and why. Income, Expenses, Investments.' },
          { label: 'Discretionary Income', detail: 'What was left of your income after every bill, budget, and expense.' },
          { label: 'Assets & Debts', detail: 'The value of everything you own and owe, side by side. Vs. last month' },
          { label: 'Budget Health', detail: 'How much is left to budget, and how much of budgeted is left to spend.' },
          { label: 'Returns by Asset Class', detail: 'What each part of your portfolio actually made or lost this month.' },
          { label: 'Spending Trends', detail: "How this month's habits compared to last month's, category by category." },
        ]}
      />
    </div>
    <p class="text-center text-base text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl mx-auto mt-10 mb-0">
      The monthly overview compiles the most important metrics from across your Finzen dashboard into one convenient snapshot, updated in real time, so you always know exactly how your month is shaping up.
    </p>
  </Section>

  <!-- Section 4: Your Cashflow, Mapped -->
  <Section
    heading="Your Cashflow, Mapped"
    subheading="Stop wondering where your paycheck went. The answer is right here."
  >
    {/*
      COPY PLACEHOLDER — Suggested talking points:
      - Visual budget vs. actual
      - Progress bars for each category
      - Color-coded (green = on track, red = over)
      - Instantly know where you stand

      Keywords to weave in: budget visualization, visual budget, expense charts
    */}
    <div class="flex flex-col md:flex-row md:items-start md:gap-8 lg:gap-10">
      <!-- Image: left on desktop, above copy on mobile (animates in from left) -->
      <div class="cashflow-reveal-left flex-shrink-0 w-full max-w-[700px] md:max-w-[440px] lg:max-w-[520px] mx-auto md:mx-0 order-1 md:order-1 mb-6 md:mb-0">
        <img
          src="/images/budgeting-app/cashflow_light.png"
          alt="Finzen cashflow dashboard — inflows, outflows, liquidity and TIA"
          class="cashflow-img w-full h-auto rounded-lg block dark:hidden"
        />
        <img
          src="/images/budgeting-app/cashflow_dark.png"
          alt="Finzen cashflow dashboard — inflows, outflows, liquidity and TIA"
          class="cashflow-img w-full h-auto rounded-lg hidden dark:block"
        />
      </div>
      <!-- Copy: right on desktop, below image on mobile -->
      <div class="flex-1 min-w-0 max-w-2xl space-y-4 order-2 md:order-2">
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
