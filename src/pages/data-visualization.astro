  </style>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const animateValue = (el, fromVal, toVal, formatter, duration = 600) => {
        if (!el) return;
        const startTime = performance.now();
        const step = (now) => {
          const t = Math.min((now - startTime) / duration, 1);
          const eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
          const current = fromVal + (toVal - fromVal) * eased;
          el.textContent = formatter ? formatter(current) : Math.round(current);
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      const C = 2 * Math.PI * 72;
      const PCT = [28, 22, 18, 14, 10, 8];
      const TOTAL_SPEND = 3200;
      const defaultLabel = 'Total spending';
      const defaultValue = '$3,200';
      const formatDollar = (n) => '$' + Number(n).toLocaleString('en-US', { maximumFractionDigits: 0 });
      let offset = 0;
      const donutObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const wrap = entry.target;
            wrap.classList.add('in-view');
            const segs = wrap.querySelectorAll('.donut-seg');
            segs.forEach((seg, i) => {
              const pct = PCT[i];
              const length = (pct / 100) * C;
              seg.style.strokeDasharray = `${length} ${C - length}`;
              seg.style.strokeDashoffset = `${-offset}`;
              offset += length;
            });
            const valueEl = document.getElementById('donut-value');
            if (valueEl) animateValue(valueEl, 0, TOTAL_SPEND, formatDollar, 800);
            donutObserver.disconnect();
          });
        },
        { threshold: 0.2 }
      );
      const donutWrap = document.querySelector('.spending-donut-wrap');
      if (donutWrap) {
        donutObserver.observe(donutWrap);
        const labelEl = document.getElementById('donut-label');
        const valueEl = document.getElementById('donut-value');
        donutWrap.querySelectorAll('.donut-seg').forEach((seg) => {
          seg.addEventListener('mouseenter', () => {
            if (labelEl) labelEl.textContent = seg.getAttribute('data-category') || defaultLabel;
            if (valueEl) valueEl.textContent = '$' + Number(seg.getAttribute('data-amount')).toLocaleString();
          });
          seg.addEventListener('mouseleave', () => {
            if (labelEl) labelEl.textContent = defaultLabel;
            if (valueEl) valueEl.textContent = defaultValue;
          });
        });
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              if (entry.target.classList.contains('achievements-preview-reveal') && !entry.target.dataset.counted) {
                entry.target.dataset.counted = 'true';
                const progressEl = entry.target.querySelector('.achievement-progress-value');
                if (progressEl) {
                  const target = parseInt(progressEl.getAttribute('data-target') || '0', 10);
                  setTimeout(() => {
                    animateValue(progressEl, 0, target, (n) => Math.round(n).toString(), 700);
                  }, 550);
                }
              }
            }
          });
        },
        { rootMargin: '0px 0px -40px 0px', threshold: 0.1 }
      );
      document.querySelectorAll('.money-skills-image-reveal').forEach((el) => observer.observe(el));
      document.querySelectorAll('.cashflow-reveal-left, .cashflow-reveal-right').forEach((el) => observer.observe(el));
      document.querySelectorAll('.method-image-reveal').forEach((el) => observer.observe(el));
      const assetPills = document.querySelector('.asset-classes-pills');
      if (assetPills) observer.observe(assetPills);
      const disconnectionRings = document.querySelector('.disconnection-rings');
      if (disconnectionRings) observer.observe(disconnectionRings);
      const stopGuessingCards = document.querySelector('.stop-guessing-cards');
      if (stopGuessingCards) observer.observe(stopGuessingCards);
      document.querySelectorAll('.portfolio-hero-reveal').forEach((el) => observer.observe(el));
      document.querySelectorAll('.achievements-preview-reveal').forEach((el) => observer.observe(el));
      const ctaCard = document.querySelector('.cta-card-reveal');
      if (ctaCard) observer.observe(ctaCard);

      // Trends demo card: count-up on first view, then random updates every few seconds
      const trendsCards = document.querySelector('.trends-demo-cards');
      if (!trendsCards) return;
      const formatCurrency = (n) => '€' + Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      let nwTotal = 0, nwInv = 0;
      const totalEl = trendsCards.querySelector('.trends-nw-total');
      const invEl = trendsCards.querySelector('.trends-nw-inv');
      const inEl = trendsCards.querySelector('.trends-nw-in');
      const outEl = trendsCards.querySelector('.trends-nw-out');
      const discEl = trendsCards.querySelector('.trends-nw-disc');
      const runFirstAnimation = () => {
        nwTotal = 2847.5;
        nwInv = 412.3;
        if (totalEl) animateValue(totalEl, 0, nwTotal, formatCurrency, 800);
        if (invEl) { invEl.textContent = '+€0.00'; invEl.classList.add('text-profit'); invEl.classList.remove('text-loss'); animateValue(invEl, 0, nwInv, (n) => '+' + formatCurrency(n).slice(1), 800); }
        if (inEl) animateValue(inEl, 0, 5200, formatCurrency, 800);
        if (outEl) animateValue(outEl, 0, 2764.8, formatCurrency, 800);
        if (discEl) animateValue(discEl, 0, 2435.2, formatCurrency, 800);
      };
      const runRandomUpdate = () => {
        const invDelta = (Math.random() * 100 - 50); // ±50
        const newInv = nwInv + invDelta;
        const totalDelta = invDelta + (Math.random() * 60 - 30); // move with inv + ±30
        const newTotal = Math.max(1200, Math.min(4200, nwTotal + totalDelta));
        if (totalEl) animateValue(totalEl, nwTotal, newTotal, formatCurrency);
        if (invEl) {
          invEl.classList.toggle('text-profit', newInv >= 0);
          invEl.classList.toggle('text-loss', newInv < 0);
          animateValue(invEl, nwInv, newInv, (n) => (n >= 0 ? '+' : '-') + formatCurrency(Math.abs(n)).slice(1));
        }
        nwTotal = newTotal;
        nwInv = newInv;
      };
      const trendsObserver = new IntersectionObserver(
        (entries) => {
          if (!entries[0]?.isIntersecting) return;
          trendsCards.classList.add('in-view');
          trendsObserver.disconnect();
          runFirstAnimation();
          setInterval(runRandomUpdate, 7500);
        },
        { threshold: 0.2 }
      );
      trendsObserver.observe(trendsCards);
    });
  </script>

