---
/**
 * /data-visualization
 *
 * Angle: Visual learners, data visualization fans, analytics-minded users
 * Audience: People who want beautiful charts and visual insights
 * Intent: "I want to see my finances, not just read numbers"
 *
 * Target Keywords:
 * - personal finance charts (100-1K)
 * - budget sankey (10-100)
 * - money flow chart (100-1K)
 * - expense charts (100-1K)
 * - budget visualization (10-100)
 * - monthly financial report (100-1K)
 * - financial analytics (1K-10K)
 */

import Layout from '@/layouts/Layout.astro';
import { pages, APP_URL, SITE_URL } from '@/data/pages';
import AngleHero from '@/components/AngleHero.astro';
import Section from '@/components/Section.astro';
import FeatureList from '@/components/FeatureList.astro';
import CTABlock from '@/components/CTABlock.astro';
import SiblingLinks from '@/components/SiblingLinks.astro';

const meta = pages.personalFinanceCharts;

// Ring stats for "The disconnect" section
const R = 48;
const C = 2 * Math.PI * R;
const disconnectionRings = [
  { pct: 25, plus: true, label: "of Americans say they're afraid to check their finances because they'll realize how much they're spending." },
  { pct: 86, label: 'of people who track their income and expenses say it has helped them get out, or stay out, of debt.' },
  { pct: 60, plus: true, label: 'of investors do not understand all the types of investments they hold in their own portfolio.' },
].map(({ pct, label, plus }) => ({ pct, label, plus, offset: C * (1 - pct / 100) }));

// Cashflow insight pills (equal width, same neumorphic style) — ger palette, mixed hues
const GER_PALETTE = ['#fc5c65', '#fd9644', '#fed330', '#26de81', '#2bcbba', '#0fb9b1', '#20bf6b', '#f7b731', '#fa8231', '#eb3b5a', '#45aaf2', '#4b7bec', '#a55eea', '#d1d8e0', '#778ca3', '#4b6584', '#a5b1c2', '#8854d0', '#3867d6', '#2d98da'];
const ASSET_PILLS_3 = [
  { label: 'Runway', supportLine: 'Know how long your liquid funds will last based on past spending.', color: GER_PALETTE[0], icon: 'trending' },
  { label: 'Time-in-account (TIA)', supportLine: 'How long your money stays in your account before being spent.', color: GER_PALETTE[4], icon: 'clock' },
  { label: 'Liquidity flow', supportLine: 'Visualize income and outflow patterns. See your cashflow.', color: GER_PALETTE[12], icon: 'pie' },
];

// FAQPage structured data for rich results (charts/visualization FAQ)
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do I need to connect my bank account to see my charts and reports?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "No. Finzen is built around manual entry, which means no bank sync, no broker connections, and no exchange APIs. You log your transactions yourself — typically 2 to 3 minutes a day — and every chart, report, and visualization is generated from that data. Your financial picture stays completely private, and the charts update in real time as you log."
      }
    },
    {
      '@type': 'Question',
      name: 'How long does it take before the charts become useful?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Most users find real value within the first month. Your monthly overview becomes meaningful after your first full month of logging, and charts like spending trends and net worth history get richer the longer you track. That said, your budget, cash flow, and Sankey diagram are useful from day one — even a week of data reveals patterns most people have never seen before."
      }
    },
    {
      '@type': 'Question',
      name: 'Why is data visualization so important for personal finance?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Numbers in a spreadsheet tell you what happened. Visualization tells you what it means. When you can see your spending as a Sankey flow rather than a list of transactions, patterns that were invisible become obvious. When your net worth is a chart instead of a calculation, the trajectory becomes motivating rather than abstract. Research consistently shows that people who have a clear visual understanding of their finances make better spending decisions, save more consistently, and feel significantly less anxiety about money. The goal of financial data visualization is not to make things look pretty — it is to make the right action feel obvious."
      }
    },
    {
      '@type': 'Question',
      name: "Is Finzen's data visualization available on mobile?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Yes. Finzen works on both desktop and mobile, and the charts and reports are fully accessible on both. Most users log transactions on mobile throughout the day and review their reports and visualizations on desktop, though both experiences are designed to be clean and intuitive."
      }
    }
  ]
});
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={`/${meta.slug}`}
  ogImage={meta.ogImage}
  keywords={meta.keywords}
>

  <script type="application/ld+json">
    {JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: meta.title,
      description: meta.description,
      url: `${SITE_URL}/${meta.slug}`,
    })}
  </script>
  <script type="application/ld+json">
    {JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
        { '@type': 'ListItem', position: 2, name: 'Data Visualization', item: `${SITE_URL}/${meta.slug}` },
      ],
    })}
  </script>
  <!-- FAQPage structured data for rich results -->
  <script type="application/ld+json" set:html={faqSchema} />

  <AngleHero
    title="Your Finances, Visualized"
    subtitle="Monthly report cards, Sankey cash flows, spending trends, portfolio performance, net worth over time. This is what financial clarity looks like."
    keyword="financial insights & charts"
  />

  <!-- Hero: phone (left, in front) + laptop (right, behind), slide-in + drop-shadow -->
  <div class="hero-dual w-full overflow-x-clip -mt-32 md:-mt-[12rem] mb-0 relative z-10 flex justify-center items-end">
    <div class="hero-dual-inner relative flex justify-center items-end gap-0 w-full max-w-[1200px] min-h-0 md:min-h-[320px] px-4 -translate-y-20 md:translate-y-0">
      <!-- Laptop: slightly right of center, animates in from right, behind phone -->
      <div class="hero-laptop-wrap absolute inset-0 flex justify-center items-end pointer-events-none">
        <div class="hero-laptop-pos translate-x-[6%] md:translate-x-[12%] -translate-y-8 md:translate-y-0">
          <div class="hero-laptop-inner scale-[1.08] sm:scale-100 md:scale-100 origin-center w-max max-w-[100vw] sm:max-w-[640px] md:max-w-[1000px] min-w-0 shrink-0">
          <img
            src="/images/mindful-money-tracking/hero_light.png"
            alt="Finzen dashboard on laptop"
            class="hero-device-img w-auto max-w-full h-auto block dark:hidden"
          />
          <img
            src="/images/mindful-money-tracking/hero_dark.png"
            alt="Finzen dashboard on laptop"
            class="hero-device-img w-auto max-w-full h-auto hidden dark:block"
          />
          </div>
        </div>
      </div>
      <!-- Phone: left of center, in front, animates in from left -->
      <div class="hero-phone-wrap relative z-10 flex justify-center items-end translate-x-[-82%] md:translate-x-[-78%]">
        <div class="hero-phone-inner scale-[0.85] sm:scale-[0.9] md:scale-100 origin-bottom w-max max-w-[140px] sm:max-w-[175px] md:max-w-[240px] min-w-0 shrink-0">
          <img
            src="/images/our-story/mobile_networth_light.png"
            alt="Finzen net worth on phone"
            class="hero-device-img w-auto max-w-full h-auto block dark:hidden"
          />
          <img
            src="/images/our-story/mobile_networth_dark.png"
            alt="Finzen net worth on phone"
            class="hero-device-img w-auto max-w-full h-auto hidden dark:block"
          />
        </div>
      </div>
    </div>
  </div>

  <style>
    .hero-dual .hero-device-img {
      filter: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.15)) drop-shadow(0 4px 12px rgba(0, 0, 0, 0.1));
    }
    .dark .hero-dual .hero-device-img {
      filter: drop-shadow(0 12px 32px rgba(0, 0, 0, 0.4)) drop-shadow(0 4px 14px rgba(0, 0, 0, 0.2));
    }
    @keyframes heroSlideInLeft {
      0% { opacity: 0; transform: translateX(-60px); }
      25% { opacity: 1; transform: translateX(-45px); }
      100% { opacity: 1; transform: translateX(0); }
    }
    @keyframes heroSlideInRight {
      from { opacity: 0; transform: translateX(60px); }
      to { opacity: 1; transform: translateX(0); }
    }
    .hero-dual .hero-laptop-inner {
      opacity: 0;
      animation: heroSlideInRight 0.7s ease-out 0.15s forwards;
    }
    .hero-dual .hero-phone-inner {
      opacity: 0;
      animation: heroSlideInLeft 0.7s ease-out forwards;
    }
    /* Money skills section: image animates in from the right on scroll */
    .money-skills-image-reveal {
      opacity: 0;
      transform: translateX(60px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .money-skills-image-reveal.in-view {
      opacity: 1;
      transform: translateX(0);
    }

    /* Sankey image: drop shadow in light mode only (image has transparency) */
    .sankey-img {
      filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.1)) drop-shadow(0 2px 8px rgba(0, 0, 0, 0.06));
    }
    :global(.dark) .sankey-img {
      filter: none;
    }

    /* Cashflow section image: even shadow on all sides (no x/y offset) in light and dark */
    .cashflow-img {
      filter: drop-shadow(0 0 8px rgba(0, 0, 0, 0.1)) drop-shadow(0 0 24px rgba(0, 0, 0, 0.18)) drop-shadow(0 0 4px rgba(0, 0, 0, 0.06));
    }
    :global(.dark) .cashflow-img {
      filter: drop-shadow(0 0 6px rgba(0, 0, 0, 0.5)) drop-shadow(0 0 20px rgba(0, 0, 0, 0.3));
    }

    /* Cashflow section: first image animates in from left, second (Sankey) from right */
    .cashflow-reveal-left {
      opacity: 0;
      transform: translateX(-60px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .cashflow-reveal-left.in-view {
      opacity: 1;
      transform: translateX(0);
    }
    .cashflow-reveal-right {
      opacity: 0;
      transform: translateX(60px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .cashflow-reveal-right.in-view {
      opacity: 1;
      transform: translateX(0);
    }

    /* The disconnect: ring stats */
    .disconnection-rings {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.5rem;
      max-width: 56rem;
      margin-left: auto;
      margin-right: auto;
    }
    @media (min-width: 768px) {
      .disconnection-rings {
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
      }
    }
    .ring-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
    .disconnection-rings.in-view .ring-item {
      animation: ring-appear 0.6s ease-out var(--ring-delay) forwards;
    }
    @keyframes ring-appear {
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
    .ring-wrapper {
      position: relative;
      width: 140px;
      height: 140px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1rem;
    }
    .ring-svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    .ring-track {
      stroke: rgb(229 229 229);
    }
    :global(.dark) .ring-track {
      stroke: rgb(64 64 64);
    }
    .ring-progress {
      stroke: rgb(23 23 23);
      stroke-linecap: round;
      stroke-dashoffset: 301.59;
    }
    .disconnection-rings.in-view .ring-progress {
      animation: ring-fill 0.9s ease-out var(--ring-delay) forwards;
    }
    :global(.dark) .ring-progress {
      stroke: rgb(250 250 250);
    }
    @keyframes ring-fill {
      from {
        stroke-dashoffset: 301.59;
      }
      to {
        stroke-dashoffset: var(--ring-offset);
      }
    }
    .ring-pct {
      position: relative;
      font-size: 1.75rem;
      font-weight: 700;
      color: rgb(23 23 23);
      line-height: 1;
    }
    :global(.dark) .ring-pct {
      color: rgb(250 250 250);
    }
    .ring-label {
      font-size: 0.875rem;
      line-height: 1.4;
      color: rgb(82 82 82);
      max-width: 18rem;
      margin: 0;
      text-align: center;
    }
    :global(.dark) .ring-label {
      color: rgb(163 163 163);
    }

    /* Trends section demo card: profit/loss */
    .text-profit { color: #22c55e; }
    .text-loss { color: #ef4444; }
    :global(.dark) .text-profit { color: #4ade80; }
    :global(.dark) .text-loss { color: #f87171; }

    /* Stop Guessing. Start Knowing. – 6 cards animate in */
    .stop-guessing-cards-item {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    }
    .stop-guessing-cards.in-view .stop-guessing-cards-item {
      opacity: 1;
      transform: translate(0);
    }
    .stop-guessing-cards.in-view .stop-guessing-cards-item:nth-child(1) { transition-delay: 0ms; }
    .stop-guessing-cards.in-view .stop-guessing-cards-item:nth-child(2) { transition-delay: 80ms; }
    .stop-guessing-cards.in-view .stop-guessing-cards-item:nth-child(3) { transition-delay: 160ms; }
    .stop-guessing-cards.in-view .stop-guessing-cards-item:nth-child(4) { transition-delay: 240ms; }
    .stop-guessing-cards.in-view .stop-guessing-cards-item:nth-child(5) { transition-delay: 320ms; }
    .stop-guessing-cards.in-view .stop-guessing-cards-item:nth-child(6) { transition-delay: 400ms; }

    /* Cashflow pills — equal width (grid so all three same size) */
    .asset-classes-pills {
      min-height: 4.5rem;
      width: 100%;
      max-width: 56rem;
      margin-left: auto;
      margin-right: auto;
      padding-left: 1rem;
      padding-right: 1rem;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem 1.25rem;
    }
    @media (max-width: 768px) {
      .asset-classes-pills {
        grid-template-columns: 1fr;
      }
    }
    .asset-classes-pills .asset-class-pill-wrap.asset-class-pill-equal {
      min-width: 0;
    }
    .asset-classes-pills .asset-class-pill-wrap.asset-class-pill-equal .asset-class-pill {
      width: 100%;
      box-sizing: border-box;
    }
    .asset-class-pill-wrap {
      display: inline-flex;
      transition: transform 0.25s ease;
    }
    .asset-class-pill-wrap:hover {
      transform: translateY(-4px) scale(1.03);
    }
    .asset-class-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.875rem;
      padding: 0.75rem 1.5rem 0.75rem 0.625rem;
      font-size: 1.0625rem;
      font-weight: 500;
      color: rgb(38 38 38);
      background: linear-gradient(145deg, #fafafa 0%, #f0f0f0 100%);
      border: none;
      border-radius: 9999px;
      box-shadow:
        0 2px 8px rgba(0, 0, 0, 0.07),
        5px 5px 12px rgba(140, 140, 140, 0.5),
        -5px -5px 12px rgba(255, 255, 255, 0.95),
        inset 1px 1px 2px rgba(255, 255, 255, 0.7);
      opacity: 0;
      transition: box-shadow 0.25s ease;
    }
    .asset-class-pill-wrap:hover .asset-class-pill {
      box-shadow:
        0 4px 14px rgba(0, 0, 0, 0.09),
        10px 10px 22px rgba(120, 120, 120, 0.4),
        -10px -10px 22px rgba(255, 255, 255, 1),
        inset 2px 2px 4px rgba(255, 255, 255, 0.8);
    }
    .asset-class-pill-circle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      min-width: 2.75rem;
      min-height: 2.75rem;
      border-radius: 50%;
      background-color: var(--pill-color, #4b7bec);
      color: white;
      flex-shrink: 0;
    }
    .asset-class-pill-circle svg {
      width: 18px;
      height: 18px;
    }
    .asset-class-pill-xi {
      font-size: 1.125rem;
      font-weight: 600;
      line-height: 1;
      color: inherit;
    }
    .asset-class-pill-text {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.125rem;
      padding-right: 0.25rem;
    }
    .asset-class-pill-label {
      font-size: 1.0625rem;
      font-weight: 500;
      line-height: 1.2;
    }
    .asset-class-pill-support {
      font-size: 0.75rem;
      font-weight: 400;
      line-height: 1.2;
      color: rgb(115 115 115);
    }
    :global(.dark) .asset-class-pill-support {
      color: rgb(163 163 163);
    }
    /* Subtext always visible on this page (including mobile); portfolio-tracker hides it on small screens */
    @media (max-width: 400px) {
      .asset-class-pill {
        gap: 0.5rem;
        padding: 0.5rem 1rem 0.5rem 0.5rem;
        font-size: 0.9375rem;
      }
      .asset-class-pill-circle {
        width: 2rem;
        height: 2rem;
        min-width: 2rem;
        min-height: 2rem;
      }
      .asset-class-pill-circle svg {
        width: 14px;
        height: 14px;
      }
      .asset-class-pill-xi {
        font-size: 0.875rem;
      }
      .asset-class-pill-label {
        font-size: 0.9375rem;
      }
    }
    .asset-classes-pills.in-view .asset-class-pill {
      animation: asset-pill-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: var(--pill-delay, 0ms);
    }
    :global(.dark) .asset-class-pill {
      color: rgb(226 232 240);
      background: linear-gradient(145deg, #3d3d3d 0%, #2a2a2a 100%);
      box-shadow:
        5px 5px 12px rgba(0, 0, 0, 0.45),
        -3px -3px 8px rgba(80, 80, 80, 0.2),
        inset 1px 1px 2px rgba(255, 255, 255, 0.05);
    }
    :global(.dark) .asset-class-pill-wrap:hover .asset-class-pill {
      box-shadow:
        10px 10px 24px rgba(0, 0, 0, 0.55),
        -5px -5px 14px rgba(80, 80, 80, 0.15),
        inset 2px 2px 4px rgba(255, 255, 255, 0.07);
    }
    @keyframes asset-pill-in {
      0% { opacity: 0; transform: translateY(10px) scale(1); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* Spending donut: smooth minimal fade-in of segments (no stagger) */
    .donut-seg {
      stroke-dasharray: 0 452.4;
      stroke-dashoffset: 0;
      transition: stroke-dasharray 1s ease-out, stroke-dashoffset 1s ease-out;
      cursor: pointer;
    }
    .spending-donut-wrap.in-view .donut-seg {
      transition-delay: 0ms;
    }

    /* Bigger Picture section: three phones stacked, side ones angled */
    .phones-stack {
      padding-bottom: 0.5rem;
      min-height: 320px;
    }
    @media (min-width: 768px) and (max-width: 1030px) {
      .phones-stack {
        transform: scale(0.7) translateX(80px);
        transform-origin: left center;
      }
    }
    @media (max-width: 570px) {
      .phones-stack {
        min-height: 220px;
        transform: scale(0.68);
        transform-origin: center center;
      }
    }
    @media (max-width: 420px) {
      .phones-stack {
        min-height: 180px;
        transform: scale(0.58);
        transform-origin: center center;
      }
    }
    /* Pull text up only when phones are scaled down (≤570px) */
    @media (max-width: 569px) {
      .bigger-picture-text { margin-top: -3rem; }
    }
    .phone-peek-left {
      transform: rotate(-6deg) translateY(-50px) translateX(-96px);
    }
    .phone-peek-right {
      transform: rotate(5.5deg) translateY(-30px) translateX(96px);
    }

    /* Finzen Method section CTA — hero-style shine (light mode) */
    .method-cta-btn {
      position: relative;
      overflow: hidden;
    }
    .method-cta-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        105deg,
        transparent 0%,
        transparent 45%,
        rgba(255, 255, 255, 0.35) 49%,
        rgba(255, 255, 255, 0.2) 50%,
        rgba(255, 255, 255, 0.35) 51%,
        transparent 55%,
        transparent 100%
      );
      transform: translateX(-100%);
      transition: transform 0.45s ease;
      pointer-events: none;
    }
    .method-cta-btn:hover::before {
      transform: translateX(100%);
    }
    :global(.dark) .method-cta-btn::before {
      display: none;
    }

    /* Each phone animates in independently: center from below, left from left, right from right */
    .phone-reveal {
      opacity: 0;
      transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    }
    .phone-reveal-left {
      transform: translateX(-56px);
    }
    .phone-reveal-center {
      transform: translateY(32px);
    }
    .phone-reveal-right {
      transform: translateX(56px);
    }
    .method-image-reveal.in-view .phone-reveal-center {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0ms;
    }
    .method-image-reveal.in-view .phone-reveal-left {
      opacity: 1;
      transform: translateX(0);
      transition-delay: 220ms;
    }
    .method-image-reveal.in-view .phone-reveal-right {
      opacity: 1;
      transform: translateX(0);
      transition-delay: 330ms;
    }

    /* Why manual tracking section: image reveal (from mindful-money-tracking) */
    .method-image-reveal {
      opacity: 0;
      transform: translateY(40px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    @media (min-width: 768px) {
      .method-image-reveal {
        transform: translateX(-40px);
      }
    }
    .method-image-reveal.in-view {
      opacity: 1;
      transform: translate(0);
    }

    /* Portfolio hero image: animate in from below */
    .portfolio-hero-reveal {
      opacity: 0;
      transform: translateY(48px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .portfolio-hero-reveal.in-view {
      opacity: 1;
      transform: translateY(0);
    }

    /* Achievements preview (Liquidity section): stacked cards + stagger animation */
    .achievements-preview {
      padding: 0.25rem 0;
      width: 100%;
      max-width: 380px;
    }
    .achievements-preview-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.875rem;
      margin: 0;
    }
    .achievements-preview-reveal .achievement-card {
      opacity: 0;
      transform: translateX(-24px);
      transition: opacity 0.4s ease-out, transform 0.4s ease-out, background-color 0.15s ease;
    }
    .achievements-preview-reveal.in-view .achievement-card { opacity: 1; transform: translateX(0); }
    .achievements-preview-reveal.in-view .achievement-card:nth-child(1) { transition-delay: 0ms; }
