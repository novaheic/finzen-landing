---
/**
 * /portfolio-tracker
 *
 * Angle: Investors, portfolio trackers, net worth focused users
 * Audience: People who want to track investments across multiple asset classes
 * Intent: "I want to see all my investments in one place"
 *
 * Target Keywords (High Volume):
 * - portfolio tracker (1K-10K)
 * - investment tracker (1K-10K)
 * - stock tracker (10K-100K)
 * - crypto tracker (1K-10K)
 * - net worth tracking (1K-10K)
 * - asset tracker (1K-10K)
 * - wealth tracker (1K-10K)
 */

import Layout from '@/layouts/Layout.astro';
import { pages } from '@/data/pages';
import AngleHero from '@/components/AngleHero.astro';
import Section from '@/components/Section.astro';
import FeatureList from '@/components/FeatureList.astro';
import CTABlock from '@/components/CTABlock.astro';
import SiblingLinks from '@/components/SiblingLinks.astro';

const meta = pages.portfolioTracker;

// Logo assets from personal-finance-charts (60px width, max 60px height)
const LOGO_BASE = '/images/personal-finance-charts/assets';
const LOGO_FILES = [
  'aave-aave-logo.png',
  'Amazon_(company)-Logo.wine.png',
  'Apple_logo_black.png',
  'avalanche-avax-logo.png',
  'Bitcoin.svg.png',
  'Bitcoin_Cash.png',
  'bnb-bnb-logo.png',
  'business.png',
  'Chainlink_Logo.png',
  'dollar-sign.png',
  'ethereum-eth-logo.png',
  'euro (1).png',
  'GameStop-logo.png',
  'Google__G__logo.svg.png',
  'jpy.png',
  'Microsoft_logo_-_2012_(vertical).png',
  'monero-xmr-logo.png',
  'Nvidia_logo.svg.png',
  'SAP_2011_logo.svg.png',
  'solana-sol-logo.png',
  'T-Mobile_logo_2022.svg.png',
  'Tsmc.svg.png',
];

// Placement: left %, top %, scale, blur(px), zIndex, shadow strength, animation delay (ms)
// Balanced: 11 left (0–32%), 11 right (66–100%). Sharp (blur: 0): Bitcoin, JPY, Nvidia, Apple, Google, Microsoft, ethereum, GameStop, Chainlink, Tsmc.
const LOGO_PLACEMENTS: Array<{ left: number; top: number; scale: number; blur: number; z: number; shadow: number; delay: number }> = [
  { left: 6, top: 15, scale: 0.78, blur: 3, z: 2, shadow: 0.45, delay: 80 },   // 0 aave
  { left: 10, top: 70, scale: 0.88, blur: 2, z: 2, shadow: 0.55, delay: 140 }, // 1 Amazon
  { left: 14, top: 42, scale: 0.95, blur: 0, z: 3, shadow: 0.65, delay: 200 },  // 2 Apple
  { left: 18, top: 78, scale: 0.72, blur: 3, z: 1, shadow: 0.4, delay: 260 },   // 3 avalanche
  { left: 8, top: 28, scale: 0.92, blur: 0, z: 3, shadow: 0.7, delay: 320 },   // 4 Bitcoin
  { left: 22, top: 55, scale: 0.8, blur: 2, z: 2, shadow: 0.5, delay: 380 },   // 5 Bitcoin_Cash
  { left: 68, top: 18, scale: 0.7, blur: 3, z: 1, shadow: 0.35, delay: 440 },   // 6 bnb (right)
  { left: 70, top: 58, scale: 0.74, blur: 3, z: 1, shadow: 0.4, delay: 500 },   // 7 business (right)
  { left: 75, top: 62, scale: 0.9, blur: 0, z: 3, shadow: 0.6, delay: 560 },    // 8 Chainlink (right)
  { left: 94, top: 78, scale: 0.76, blur: 2, z: 2, shadow: 0.45, delay: 620 },  // 9 dollar-sign (right)
  { left: 20, top: 35, scale: 0.82, blur: 0, z: 2, shadow: 0.5, delay: 680 },   // 10 ethereum
  { left: 66, top: 44, scale: 0.78, blur: 2, z: 2, shadow: 0.48, delay: 740 },  // 11 euro (right)
  { left: 4, top: 50, scale: 0.8, blur: 0, z: 2, shadow: 0.5, delay: 800 },      // 12 GameStop
  { left: 24, top: 26, scale: 0.9, blur: 0, z: 3, shadow: 0.65, delay: 860 },   // 13 Google
  { left: 78, top: 22, scale: 0.88, blur: 0, z: 3, shadow: 0.65, delay: 920 },  // 14 jpy
  { left: 28, top: 74, scale: 0.92, blur: 0, z: 3, shadow: 0.7, delay: 980 },   // 15 Microsoft
  { left: 72, top: 36, scale: 0.8, blur: 3, z: 1, shadow: 0.45, delay: 1040 },  // 16 monero (right)
  { left: 80, top: 48, scale: 0.9, blur: 0, z: 3, shadow: 0.65, delay: 520 },   // 17 Nvidia (earlier animation)
  { left: 32, top: 38, scale: 0.76, blur: 2, z: 2, shadow: 0.48, delay: 160 },  // 18 SAP
  { left: 82, top: 70, scale: 0.84, blur: 2, z: 2, shadow: 0.52, delay: 220 },   // 19 solana (right)
  { left: 92, top: 54, scale: 0.78, blur: 2, z: 2, shadow: 0.5, delay: 280 },   // 20 T-Mobile (right)
  { left: 86, top: 14, scale: 0.82, blur: 0, z: 2, shadow: 0.55, delay: 340 },   // 21 Tsmc (right)
];

// Ensure we only use as many placements as we have logos
const logoEntries = LOGO_FILES.slice(0, LOGO_PLACEMENTS.length).map((file, i) => ({
  file,
  ...LOGO_PLACEMENTS[i],
}));
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={`/${meta.slug}`}
>

  <AngleHero
    title="Live Multi-Asset Portfolio Tracking"
    subtitle="Track stocks, crypto, ETFs, commodities, forex, and more in one beautiful dashboard. Always see your networth and portfolio in real time"
    keyword="investment & portfolio tracker"
  />

  <!-- Hero with floating logos and laptop (3D depth, animate in from center) -->
  <div class="hero-with-logos -mt-56 md:-mt-[23rem] mb-0 relative z-10 w-full min-h-[280px] md:min-h-[320px] flex items-center justify-center overflow-visible">
    <!-- Logo layer: spread left/right, some overlapping center, behind/in front of laptop -->
    <div class="hero-logos-layer absolute inset-0 pointer-events-none" aria-hidden="true">
      {logoEntries.map(({ file, left, top, scale, blur, z, shadow, delay }) => (
        <div
          class="hero-logo-wrap"
          data-side={left < 50 ? 'left' : 'right'}
          style={{
            '--logo-left': `${left}%`,
            '--logo-top': `${top}%`,
            '--logo-scale': scale,
            '--logo-blur': `${blur}px`,
            '--logo-shadow': shadow,
            '--logo-z': z,
            '--logo-delay': `${delay}ms`,
          }}
        >
          <img
            src={`${LOGO_BASE}/${file}`}
            alt=""
            width="60"
            height="60"
            class="hero-logo-img"
            loading="eager"
          />
        </div>
      ))}
    </div>
    <!-- Laptop image (center, on top of back logos) -->
    <div class="hero-laptop-wrap relative z-20 flex justify-center w-full px-0">
      <div class="scale-[1.15] md:scale-100 origin-center w-max max-w-full md:w-[960px] md:max-w-none min-w-0 shrink-0">
        <img
          src={`/images/${meta.slug}/hero_light.png`}
          alt={meta.title}
          class="w-auto max-w-full md:w-full h-auto rounded-lg block dark:hidden"
        />
        <img
          src={`/images/${meta.slug}/hero_dark.png`}
          alt={meta.title}
          class="w-auto max-w-full md:w-full h-auto rounded-lg block hidden dark:block"
        />
      </div>
    </div>
  </div>

  <!-- Section 1: Contemporary investing (under hero) -->
  <Section
    heading="DIY-Investing done right"
    subheading="With great power comes great responsibility"
    align="center"
    bg="stone"
    class="mt-4 md:mt-0 !pt-14 md:!pt-10"
  >
    <div class="max-w-2xl mx-auto space-y-4 text-center">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Modern investors have unprecedented access: stocks, ETFs, crypto, commodities, forex, futures, and more. You can build a multi-asset portfolio that would have been impossible a decade ago. But with wealth scattered across multiple platforms, how do you actually know if you're winning? Your crypto might be up 40%, but if you don't account for your underperforming ETFs, shrinking cash reserves, and that commodity position you forgot about, you have no idea what your real returns are.
      </p>
    </div>
  </Section>

  <!-- Section 2: Stop Guessing. Start Knowing. (6 cards) -->
  <Section
    heading="Stop Guessing. Start Knowing."
    align="center"
    class="!pt-8 md:!pt-12"
  >
    <div class="max-w-2xl mx-auto">
      <FeatureList
        columns={2}
        features={[
          { label: 'Every Asset Class', detail: 'Track stocks, crypto, ETFs, commodities, forex, and futures in one unified dashboard; no more juggling apps.' },
          { label: 'Visual Insights', detail: 'Transform complex portfolio data into beautiful Sankey diagrams, performance charts, and interactive analytics.' },
          { label: 'True Net Worth', detail: 'See your complete financial picture with real-time tracking of assets, investments, debts, and monthly growth.' },
          { label: 'Institutional-Grade Analytics', detail: 'Get risk-adjusted returns, annualized volatility, and ROI calculations. Professional metrics for every investor.' },
          { label: 'Smart Projections', detail: 'Forecast your financial future with data-driven predictions based on your actual performance and cash flow trends.' },
          { label: 'Budget Connected', detail: 'The only portfolio tracker that integrates with zero-based budgeting for complete financial clarity.' },
        ]}
      />
    </div>
  </Section>

  <!-- Section 3: Portfolio Performance -->
  <Section
    heading="Track performance over time"
    bg="stone"
  >
    {/*
      COPY PLACEHOLDER — Suggested talking points:
      - Total returns (realized + unrealized gains)
      - Performance by asset class
      - Historical tracking
      - Cost basis and gain/loss calculations

      Keywords to weave in: portfolio performance, investment returns, portfolio analysis
    */}
    <div class="max-w-2xl space-y-4">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        [COPY: See your total portfolio performance — realized gains from sales, unrealized gains from current holdings. Know exactly how your investments are doing.]
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        [COPY: Break down performance by asset class. Is your crypto outperforming stocks? Are commodities dragging? See it clearly.]
      </p>
    </div>
  </Section>

  <!-- Section 4: Net Worth Tracking -->
  <Section
    heading="Your net worth, over time"
  >
    {/*
      COPY PLACEHOLDER — Suggested talking points:
      - Assets minus liabilities = net worth
      - Net worth timeline chart
      - Watch your trajectory over months and years
      - Include non-investment assets (cash, property)

      Keywords to weave in: net worth tracking, networth, wealth tracker, wealth management
    */}
    <div class="max-w-2xl space-y-4">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        [COPY: Net worth = everything you own minus everything you owe. Finzen tracks this over time, showing your financial trajectory.]
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        [COPY: The net worth timeline is one of the most motivating charts in personal finance. Watch it grow over months and years.]
      </p>
    </div>
  </Section>

  <!-- Section 5: Asset Allocation -->
  <Section
    heading="Visualize your allocation"
    bg="stone"
  >
    {/*
      COPY PLACEHOLDER — Suggested talking points:
      - Diversification breakdown by asset type
      - See if you're overweight in any area
      - Allocation changes over time
      - Rebalancing insights

      Keywords to weave in: asset allocation, portfolio allocation, portfolio breakdown
    */}
    <div class="max-w-2xl">
      <FeatureList
        columns={2}
        features={[
          { label: 'Allocation Breakdown', detail: '[COPY: Pie charts showing % in stocks, crypto, commodities, etc.]' },
          { label: 'Diversification Check', detail: '[COPY: See if you are too concentrated in any single asset or class]' },
          { label: 'Allocation Over Time', detail: '[COPY: Track how your allocation shifts as markets move]' },
          { label: 'Rebalancing Visibility', detail: '[COPY: Know when your portfolio drifts from target allocation]' },
        ]}
      />
    </div>
  </Section>

  <!-- Section 6: Why No Broker Sync -->
  <Section
    heading="Privacy-first portfolio tracking"
  >
    {/*
      COPY PLACEHOLDER — Suggested talking points:
      - Why Finzen doesn't connect to brokers
      - Manual entry = you control what's tracked
      - Security through isolation
      - Your broker credentials stay with you

      Link to: Privacy-First Finance page
    */}
    <div class="max-w-2xl space-y-4">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        [COPY: Finzen doesn't connect to your brokerage accounts. That's intentional. You enter your holdings manually — which means your broker credentials never leave your broker.]
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        [COPY: This is a security boundary, not a limitation. Your financial data stays encrypted and isolated.]
      </p>
    </div>
  </Section>

  <!-- Section 7: Combined with Budgeting -->
  <Section
    heading="Investments + budgeting in one app"
    bg="stone"
  >
    {/*
      COPY PLACEHOLDER — Suggested talking points:
      - Most portfolio trackers ignore budgeting
      - Finzen shows how your budget feeds your investments
      - Complete financial picture
      - Link to Budget & Expense Tracker page
    */}
    <div class="max-w-2xl space-y-4">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        [COPY: Portfolio trackers usually ignore budgeting. Budgeting apps usually ignore investments. Finzen does both — so you can see how your monthly budget feeds your long-term wealth building.]
      </p>
    </div>
  </Section>


  <CTABlock
    heading="See your complete portfolio"
    subtext="Stocks, crypto, commodities, forex — all in one view. No broker connection required."
  />

  <SiblingLinks slugs={meta.siblings} />

</Layout>

<style is:global>
  .hero-with-logos {
    --logo-base-size: 60px;
  }

  .hero-logos-layer {
    /* Full width so logos can sit from edge to edge */
  }

  .hero-logo-wrap {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--logo-base-size);
    height: var(--logo-base-size);
    transform: translate(-50%, -50%) scale(0.2);
    opacity: 0;
    z-index: var(--logo-z);
    filter: blur(var(--logo-blur));
    animation: hero-logo-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--logo-delay);
  }

  .hero-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 8px;
    /* drop-shadow follows logo shape (no square halo on transparent/non-square logos) */
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, calc(0.15 * var(--logo-shadow))))
            drop-shadow(0 2px 4px rgba(0, 0, 0, calc(0.1 * var(--logo-shadow))));
  }

  .hero-laptop-wrap {
    position: relative;
  }

  @keyframes hero-logo-in {
    0% {
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%) scale(0.2);
      opacity: 0;
    }
    100% {
      left: var(--logo-left);
      top: var(--logo-top);
      transform: translate(-50%, -50%) scale(var(--logo-scale));
      opacity: 1;
    }
  }

  /* Dark mode: slightly stronger drop-shadows for logos */
  :root.dark .hero-logo-img {
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, calc(0.25 * var(--logo-shadow))))
            drop-shadow(0 2px 6px rgba(0, 0, 0, calc(0.15 * var(--logo-shadow))));
  }

  /* Below 1230px: smaller logos and push toward edges so they aren’t covered by the laptop */
  @media (max-width: 1230px) {
    .hero-logo-wrap[data-side="left"] {
      animation-name: hero-logo-in-narrow-left;
    }
    .hero-logo-wrap[data-side="right"] {
      animation-name: hero-logo-in-narrow-right;
    }
  }

  @keyframes hero-logo-in-narrow-left {
    0% {
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%) scale(0.14);
      opacity: 0;
    }
    100% {
      left: var(--logo-left);
      top: var(--logo-top);
      transform: translate(-50%, -50%) translateX(-12vw) scale(calc(var(--logo-scale) * 0.65));
      opacity: 1;
    }
  }

  @keyframes hero-logo-in-narrow-right {
    0% {
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%) scale(0.14);
      opacity: 0;
    }
    100% {
      left: var(--logo-left);
      top: var(--logo-top);
      transform: translate(-50%, -50%) translateX(12vw) scale(calc(var(--logo-scale) * 0.65));
      opacity: 1;
    }
  }

  /* Below 600px: even smaller logos, less horizontal push so none go fully off-screen */
  @media (max-width: 600px) {
    .hero-logo-wrap[data-side="left"] {
      animation-name: hero-logo-in-mobile-left;
    }
    .hero-logo-wrap[data-side="right"] {
      animation-name: hero-logo-in-mobile-right;
    }
  }

  @keyframes hero-logo-in-mobile-left {
    0% {
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%) scale(0.1);
      opacity: 0;
    }
    100% {
      left: var(--logo-left);
      top: var(--logo-top);
      transform: translate(-50%, -50%) translateX(-5vw) scale(calc(var(--logo-scale) * 0.48));
      opacity: 1;
    }
  }

  @keyframes hero-logo-in-mobile-right {
    0% {
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%) scale(0.1);
      opacity: 0;
    }
    100% {
      left: var(--logo-left);
      top: var(--logo-top);
      transform: translate(-50%, -50%) translateX(5vw) scale(calc(var(--logo-scale) * 0.48));
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-logo-wrap {
      animation-duration: 0.2s;
      animation-delay: 0ms;
    }
  }
</style>
