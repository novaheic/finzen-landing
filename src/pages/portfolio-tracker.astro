<style is:global>
  .hero-with-logos {
    --logo-base-size: 60px;
  }

  .hero-logos-layer {
    /* Full width so logos can sit from edge to edge */
  }

  .hero-logo-wrap {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--logo-base-size);
    height: var(--logo-base-size);
    transform: translate(-50%, -50%) scale(0.2);
    opacity: 0;
    z-index: var(--logo-z);
    filter: blur(var(--logo-blur));
    animation: hero-logo-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--logo-delay);
  }

  .hero-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 8px;
    /* drop-shadow follows logo shape (no square halo on transparent/non-square logos) */
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, calc(0.15 * var(--logo-shadow))))
            drop-shadow(0 2px 4px rgba(0, 0, 0, calc(0.1 * var(--logo-shadow))));
  }

  /* Only logos with data-float="yes" get the subtle drift; each has different duration and phase */
  .hero-logo-wrap[data-float="yes"] .hero-logo-img {
    animation: hero-logo-float var(--float-duration, 6s) ease-in-out infinite;
    animation-delay: calc(1200ms + var(--logo-delay, 0ms) + (var(--float-phase, 0) * 5000ms));
  }

  @keyframes hero-logo-float {
    0%, 100% { transform: translate(0, 0); }
    25% { transform: translate(4px, -4px); }
    50% { transform: translate(-3px, 3px); }
    75% { transform: translate(3px, 4px); }
  }

  .hero-laptop-wrap {
    position: relative;
  }

  @keyframes hero-logo-in {
    0% {
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%) scale(0.2);
      opacity: 0;
    }
    100% {
      left: var(--logo-left);
      top: var(--logo-top);
      transform: translate(-50%, -50%) scale(var(--logo-scale));
      opacity: 1;
    }
  }

  /* Dark mode: slightly stronger drop-shadows for logos */
  :root.dark .hero-logo-img {
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, calc(0.25 * var(--logo-shadow))))
            drop-shadow(0 2px 6px rgba(0, 0, 0, calc(0.15 * var(--logo-shadow))));
  }

  /* Below 1230px: smaller logos and push toward edges so they aren’t covered by the laptop */
  @media (max-width: 1230px) {
    .hero-logo-wrap[data-side="left"] {
      animation-name: hero-logo-in-narrow-left;
    }
    .hero-logo-wrap[data-side="right"] {
      animation-name: hero-logo-in-narrow-right;
    }
  }

  @keyframes hero-logo-in-narrow-left {
    0% {
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%) scale(0.14);
      opacity: 0;
    }
    100% {
      left: var(--logo-left);
      top: var(--logo-top);
      transform: translate(-50%, -50%) translateX(-12vw) scale(calc(var(--logo-scale) * 0.65));
      opacity: 1;
    }
  }

  @keyframes hero-logo-in-narrow-right {
    0% {
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%) scale(0.14);
      opacity: 0;
    }
    100% {
      left: var(--logo-left);
      top: var(--logo-top);
      transform: translate(-50%, -50%) translateX(12vw) scale(calc(var(--logo-scale) * 0.65));
      opacity: 1;
    }
  }

  /* Below 600px: even smaller logos, less horizontal push so none go fully off-screen */
  @media (max-width: 600px) {
    .hero-logo-wrap[data-side="left"] {
      animation-name: hero-logo-in-mobile-left;
    }
    .hero-logo-wrap[data-side="right"] {
      animation-name: hero-logo-in-mobile-right;
    }
  }

  @keyframes hero-logo-in-mobile-left {
    0% {
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%) scale(0.1);
      opacity: 0;
    }
    100% {
      left: var(--logo-left);
      top: var(--logo-top);
      transform: translate(-50%, -50%) translateX(-5vw) scale(calc(var(--logo-scale) * 0.48));
      opacity: 1;
    }
  }

  @keyframes hero-logo-in-mobile-right {
    0% {
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%) scale(0.1);
      opacity: 0;
    }
