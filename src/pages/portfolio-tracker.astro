---
/**
 * /portfolio-tracker
 *
 * Angle: Investors, portfolio trackers, net worth focused users
 * Audience: People who want to track investments across multiple asset classes
 * Intent: "I want to see all my investments in one place"
 *
 * Target Keywords (High Volume):
 * - portfolio tracker (1K-10K)
 * - investment tracker (1K-10K)
 * - stock tracker (10K-100K)
 * - crypto tracker (1K-10K)
 * - net worth tracking (1K-10K)
 * - asset tracker (1K-10K)
 * - wealth tracker (1K-10K)
 */

import Layout from '@/layouts/Layout.astro';
import { pages, APP_URL, SITE_URL } from '@/data/pages';
import AngleHero from '@/components/AngleHero.astro';
import Section from '@/components/Section.astro';
import FeatureList from '@/components/FeatureList.astro';
import CTABlock from '@/components/CTABlock.astro';
import SiblingLinks from '@/components/SiblingLinks.astro';

const meta = pages.portfolioTracker;

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How do you calculate risk-adjusted returns, and why is it better than just looking at total returns?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Risk-adjusted returns measure how much return you earned relative to the volatility (risk) you took to get there. A portfolio that returned 15% with low volatility is often better than one that returned 20% with massive swings, especially if those swings would have caused you to panic-sell at the bottom. The most common metric is the Sharpe ratio: (return minus risk-free rate) divided by volatility. A higher Sharpe means you\'re earning more return per unit of risk. Two portfolios with identical returns can have very different risk profiles. One might be a steady climb, the other a white-knuckle rollercoaster. Risk-adjusted metrics reveal which strategy is actually superior.',
      },
    },
    {
      '@type': 'Question',
      name: "What's a healthy asset allocation for a diversified multi-asset portfolio?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "There's no one-size-fits-all answer. It depends on your age, risk tolerance, time horizon, and financial goals. Traditional advice suggests stocks/bonds ratios based on age (e.g., \"110 minus your age\" in stocks), but modern portfolios often include crypto (5-10% for aggressive investors), commodities (5-15% as inflation hedges), and alternative assets. The key principle: hold asset classes that don't move in perfect correlation. When stocks fall, commodities or forex might rise. Younger investors can tolerate more volatility and might go 60-70% equities, 10-15% crypto, 10-15% commodities, 5-10% cash. Older investors might prefer 40% stocks, 30% bonds, 20% commodities, 10% cash. Regular rebalancing (quarterly or semi-annually) maintains your target allocation as different assets outperform.",
      },
    },
    {
      '@type': 'Question',
      name: "What's annualized volatility and how does it help me understand my portfolio risk?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Annualized volatility measures how much your portfolio value fluctuates over time, expressed as a percentage. A portfolio with 15% annualized volatility means you can expect the value to swing up or down by roughly 15% in a typical year. Low volatility (5-10%) suggests stable, predictable returns, think bonds or dividend stocks. High volatility (30-50%+) means wild swings, common with crypto or individual growth stocks. Knowing your portfolio's volatility helps you: (1) assess if you can stomach the ups and downs psychologically, (2) compare different investment strategies on a risk-adjusted basis, and (3) size positions appropriately. A volatile asset shouldn't dominate your portfolio. Volatility isn't inherently bad, but you need to know what you're signing up for.",
      },
    },
    {
      '@type': 'Question',
      name: "What's portfolio concentration risk and how much is too much in one asset?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Concentration risk is when a single asset, sector, or asset class dominates your portfolio. If it crashes, you're in trouble. Classic example: Enron employees with 60% of retirement in company stock. In multi-asset portfolios, concentration often creeps in unintentionally. Maybe crypto boomed and now represents 40% of your net worth even though you only invested 10%. General guidelines: no single stock should exceed 5-10% of your portfolio, no single asset class should exceed 50-60% (except for very young, aggressive investors), and no single sector should dominate. Geographic concentration also matters. Don't put everything in your home country. The right concentration level depends on risk tolerance and time horizon, but if losing 50% of one position would derail your financial plans, you're too concentrated.",
      },
    },
  ],
});

// Logo assets from personal-finance-charts (60px width, max 60px height)
const LOGO_BASE = '/images/personal-finance-charts/assets';
const LOGO_FILES = [
  'aave-aave-logo.png',
  'Amazon_(company)-Logo.wine.png',
  'Apple_logo_black.png',
  'avalanche-avax-logo.png',
  'Bitcoin.svg.png',
  'Bitcoin_Cash.png',
  'bnb-bnb-logo.png',
  'business.png',
  'Chainlink_Logo.png',
  'dollar-sign.png',
  'ethereum-eth-logo.png',
  'euro (1).png',
  'GameStop-logo.png',
  'Google__G__logo.svg.png',
  'jpy.png',
  'Microsoft_logo_-_2012_(vertical).png',
  'monero-xmr-logo.png',
  'Nvidia_logo.svg.png',
  'SAP_2011_logo.svg.png',
  'solana-sol-logo.png',
  'T-Mobile_logo_2022.svg.png',
  'Tsmc.svg.png',
];

// Placement: left %, top %, scale, blur(px), zIndex, shadow strength, animation delay (ms)
// Balanced: 11 left (0–32%), 11 right (66–100%). Sharp (blur: 0): Bitcoin, JPY, Nvidia, Apple, Google, Microsoft, ethereum, GameStop, Chainlink, Tsmc.
// Delays compressed so last icons come in sooner (total sequence ~1.4s instead of ~2s)
const LOGO_PLACEMENTS: Array<{ left: number; top: number; scale: number; blur: number; z: number; shadow: number; delay: number }> = [
  { left: 6, top: 15, scale: 0.78, blur: 3, z: 2, shadow: 0.45, delay: 40 },   // 0 aave
  { left: 10, top: 70, scale: 0.88, blur: 1, z: 2, shadow: 0.55, delay: 70 },  // 0.5 Amazon
  { left: 14, top: 42, scale: 0.95, blur: 0, z: 3, shadow: 0.65, delay: 100 }, // 2 Apple
  { left: 18, top: 78, scale: 0.72, blur: 3, z: 1, shadow: 0.4, delay: 130 },  // 3 avalanche
  { left: 8, top: 28, scale: 0.92, blur: 0, z: 3, shadow: 0.7, delay: 160 },   // 4 Bitcoin
  { left: 22, top: 55, scale: 0.8, blur: 2, z: 2, shadow: 0.5, delay: 190 },   // 5 Bitcoin_Cash
  { left: 68, top: 18, scale: 0.7, blur: 3, z: 1, shadow: 0.35, delay: 220 },   // 6 bnb (right)
  { left: 70, top: 58, scale: 0.74, blur: 3, z: 1, shadow: 0.4, delay: 250 },    // 7 business (right)
  { left: 75, top: 82, scale: 0.9, blur: 0, z: 3, shadow: 0.6, delay: 280 },   // 8 Chainlink (right, lower)
  { left: 94, top: 78, scale: 0.76, blur: 2, z: 2, shadow: 0.45, delay: 310 },  // 9 dollar-sign (right)
  { left: 20, top: 35, scale: 0.82, blur: 0, z: 2, shadow: 0.5, delay: 340 },  // 10 ethereum
  { left: 66, top: 44, scale: 0.78, blur: 2, z: 2, shadow: 0.48, delay: 370 },  // 11 euro (right)
  { left: 4, top: 50, scale: 0.8, blur: 0, z: 2, shadow: 0.5, delay: 400 },   // 12 GameStop
  { left: 24, top: 26, scale: 0.9, blur: 0, z: 3, shadow: 0.65, delay: 430 },  // 13 Google
  { left: 78, top: 22, scale: 0.88, blur: 0, z: 3, shadow: 0.65, delay: 460 },  // 14 jpy
  { left: 28, top: 74, scale: 0.92, blur: 0, z: 3, shadow: 0.7, delay: 490 },  // 15 Microsoft
  { left: 72, top: 36, scale: 0.8, blur: 3, z: 1, shadow: 0.45, delay: 520 },   // 16 monero (right)
  { left: 80, top: 48, scale: 0.9, blur: 0, z: 3, shadow: 0.65, delay: 260 },   // 17 Nvidia
  { left: 32, top: 38, scale: 0.76, blur: 2, z: 2, shadow: 0.48, delay: 80 },   // 18 SAP
  { left: 82, top: 70, scale: 0.84, blur: 2, z: 2, shadow: 0.52, delay: 110 },  // 19 solana (right)
  { left: 92, top: 54, scale: 0.78, blur: 2, z: 2, shadow: 0.5, delay: 140 },   // 20 T-Mobile (right)
  { left: 86, top: 14, scale: 0.82, blur: 0, z: 2, shadow: 0.55, delay: 170 },  // 21 Tsmc (right)
];

// Ensure we only use as many placements as we have logos
const logoEntries = LOGO_FILES.slice(0, LOGO_PLACEMENTS.length).map((file, i) => ({
  file,
  ...LOGO_PLACEMENTS[i],
}));

// Asset class pills: palette colors (ger_palette) + icon per type
const ASSET_PALETTE = ['#fc5c65', '#fd9644', '#fed330', '#26de81', '#2bcbba', '#45aaf2', '#4b7bec', '#a55eea'];
const ASSET_CLASSES = [
  { label: 'Stocks', supportLine: '15,000+ supported', color: ASSET_PALETTE[0], icon: 'trending' },
  { label: 'Crypto', supportLine: '10,000+ cryptos & tokens', color: ASSET_PALETTE[1], icon: 'crypto' },
  { label: 'ETFs', supportLine: '5,000+ supported', color: ASSET_PALETTE[2], icon: 'suitcase' },
  { label: 'Mutual Funds', supportLine: '10,000+ covered', color: ASSET_PALETTE[3], icon: 'pie' },
  { label: 'Futures', supportLine: '2,000+', color: ASSET_PALETTE[4], icon: 'forward' },
  { label: 'Commodities', supportLine: 'Gold, Silver, Copper, Palladium', color: ASSET_PALETTE[5], icon: 'medal' },
  { label: 'Forex', supportLine: '150+ Currencies', color: ASSET_PALETTE[6], icon: 'yen' },
  { label: 'Index Funds', supportLine: '3,000+ Indices', color: ASSET_PALETTE[7], icon: 'grid' },
];
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={`/${meta.slug}`}
  ogImage={meta.ogImage}
  keywords={meta.keywords}
>

  <script type="application/ld+json">
    {JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: meta.title,
      description: meta.description,
      url: `${SITE_URL}/${meta.slug}`,
    })}
  </script>
  <script type="application/ld+json">
    {JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
        { '@type': 'ListItem', position: 2, name: 'Portfolio Tracker', item: `${SITE_URL}/${meta.slug}` },
      ],
    })}
  </script>
  <script type="application/ld+json" set:html={faqSchema} />

  <AngleHero
    title="Live Multi-Asset Portfolio Tracking"
    subtitle="Track stocks, crypto, ETFs, commodities, forex, and more in one beautiful dashboard. Always see your net worth and portfolio in real time"
    keyword="investment & portfolio tracker"
  />

  <!-- Hero with floating logos and laptop (3D depth, animate in from center) -->
  <div class="hero-with-logos -mt-56 md:-mt-[23rem] mb-0 relative z-10 w-full min-h-[280px] md:min-h-[320px] flex items-center justify-center overflow-visible">
    <!-- Logo layer: spread left/right, some overlapping center, behind/in front of laptop -->
    <div class="hero-logos-layer absolute inset-0 pointer-events-none" aria-hidden="true">
      {logoEntries.map(({ file, left, top, scale, blur, z, shadow, delay }, i) => {
        const floatDurations = [5, 6, 7, 4, 6, 5.5, 7, 4.5, 6, 5, 7, 5.5];
        const doesFloat = i % 4 !== 0;
        return (
        <div
          class="hero-logo-wrap"
          data-side={left < 50 ? 'left' : 'right'}
          data-float={doesFloat ? 'yes' : 'no'}
          style={{
            '--logo-left': `${left}%`,
            '--logo-top': `${top}%`,
            '--logo-scale': scale,
            '--logo-blur': `${blur}px`,
            '--logo-shadow': shadow,
            '--logo-z': z,
            '--logo-delay': `${delay}ms`,
            ...(doesFloat && {
              '--float-duration': `${floatDurations[i % floatDurations.length]}s`,
              '--float-phase': String((i * 0.17) % 1),
            }),
          }}
        >
          <img
            src={`${LOGO_BASE}/${file}`}
            alt=""
            width="60"
            height="60"
            class="hero-logo-img"
            loading="eager"
          />
        </div>
        );
      })}
    </div>
    <!-- Laptop image (center, on top of back logos) -->
    <div class="hero-laptop-wrap relative z-20 flex justify-center w-full px-0">
      <div class="scale-[1.15] md:scale-100 origin-center w-max max-w-full md:w-[960px] md:max-w-none min-w-0 shrink-0">
        <img
          src={`/images/${meta.slug}/hero_light.png`}
          alt={meta.title}
          class="w-auto max-w-full md:w-full h-auto rounded-lg block dark:hidden"
        />
        <img
          src={`/images/${meta.slug}/hero_dark.png`}
          alt={meta.title}
          class="w-auto max-w-full md:w-full h-auto rounded-lg block hidden dark:block"
        />
      </div>
    </div>
  </div>

  <!-- Section 1: Contemporary investing (under hero) -->
  <Section
    heading="DIY-Investing done right"
    subheading="With great power comes great responsibility"
    align="center"
    bg="stone"
    class="mt-4 md:mt-0 !pt-14 md:!pt-10"
  >
    <div class="max-w-2xl mx-auto space-y-4 text-center">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Modern investors have unprecedented access: stocks, ETFs, crypto, commodities, forex, futures, and more. You can build a multi-asset portfolio that would have been impossible a decade ago. But with wealth scattered across multiple platforms, how do you actually know if you're winning? Your crypto might be up 40%, but if you don't account for your underperforming ETFs, shrinking cash reserves, and that commodity position you forgot about, you have no idea what your real returns are.
      </p>
    </div>
  </Section>

  <!-- Section 2: Stop Guessing. Start Knowing. (6 cards) -->
  <Section
    heading="Stop Guessing. Start Knowing."
    align="center"
    class="!pt-8 md:!pt-12"
  >
    <div class="max-w-2xl mx-auto">
      <FeatureList
        columns={2}
        revealClassName="stop-guessing-cards"
        features={[
          { label: 'All Major Asset Classes', detail: 'Track stocks, crypto, ETFs, commodities, forex, and futures in one unified dashboard; no more juggling apps.' },
          { label: 'Visual Insights', detail: 'Transform complex portfolio data into beautiful diagrams, performance charts, and interactive analytics.' },
          { label: 'True Net Worth', detail: 'See your complete financial picture with real-time tracking of assets, investments, debts, and monthly growth.' },
          { label: 'Institutional-Grade Analytics', detail: 'Get risk-adjusted returns, annualized volatility, and ROI calculations. Professional metrics for every investor.' },
          { label: 'Smart Projections', detail: 'Forecast your financial future with data-driven predictions based on your actual performance and cash flow trends.' },
          { label: 'Budget Connected', detail: 'The only portfolio tracker that integrates with zero-based budgeting for complete financial clarity.' },
        ]}
      />
    </div>
  </Section>

  <!-- True Diversification Is Multi-Asset -->
  <Section
    heading="True Diversification Is Multi-Asset"
    bg="stone"
    class="!bg-gradient-to-b !from-[#ECECEC] !to-white dark:!bg-[#1B1B1B] dark:!from-[#1B1B1B] dark:!to-[#1B1B1B]"
  >
    <div class="envelope-section flex flex-col md:flex-row md:items-center gap-6 md:gap-0 max-w-4xl mx-auto">
      <div class="flex-1 min-w-0 space-y-4 text-center md:text-left">
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Portfolio diversification isn't about owning 50 different stocks. It's about owning asset classes that don't move together. When markets fall, commodities often rise. When crypto crashes, bonds stay stable. When currencies shift, your forex positions adapt. That's how you protect wealth and capture opportunities across every market condition.
        </p>
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          The problem? No platform lets you trade everything. Your stocks are with one broker, crypto on an exchange, commodities and forex scattered elsewhere. Provider fragmentation is inevitable.<br />
          <strong class="font-semibold text-neutral-800 dark:text-neutral-200">Finzen eliminates tracking fragmentation.</strong>
        </p>

        <div class="flex flex-col items-center py-2 md:hidden">
          <div class="envelope-reveal-mobile budgeting-simple-img-wrap w-full max-w-[400px] rounded-lg overflow-hidden">
            <img
              src="/images/portfolio-tracker/diversification.png"
              alt="Portfolio diversification"
              class="w-full h-auto rounded-lg block dark:hidden"
            />
            <img
              src="/images/portfolio-tracker/diversification.png"
              alt="Portfolio diversification"
              class="w-full h-auto rounded-lg block hidden dark:block"
            />
          </div>
        </div>
      </div>

      <div class="hidden md:flex flex-shrink-0 w-[400px] md:-ml-8">
        <div class="envelope-reveal-desktop budgeting-simple-img-wrap w-full rounded-lg overflow-hidden">
          <img
            src="/images/portfolio-tracker/diversification.png"
            alt="Portfolio diversification"
            class="w-full h-auto rounded-lg block dark:hidden"
          />
          <img
            src="/images/portfolio-tracker/diversification.png"
            alt="Portfolio diversification"
            class="w-full h-auto rounded-lg hidden dark:block"
          />
        </div>
      </div>
    </div>
  </Section>

  <!-- Asset classes -->
  <Section
    heading="Asset classes"
    align="center"
    bg="stone"
    class="!pt-8 md:!pt-12 asset-classes-section dark:!bg-gradient-to-b dark:!from-[#171717] dark:!to-[#1B1B1B]"
  >
    <p class="max-w-2xl mx-auto mb-8 text-base text-neutral-600 dark:text-neutral-400 leading-relaxed text-center">
      A modern portfolio is more than just stocks. Track crypto, commodities, forex, and every asset class you invest in - all in one dashboard. No more app juggling. No more blind spots.
    </p>
    <div class="asset-classes-pills mb-10 flex flex-wrap justify-center gap-4 sm:gap-5">
      {ASSET_CLASSES.map((item, i) => (
        <span class="asset-class-pill-wrap">
          <span
            class="asset-class-pill"
            style={{ '--pill-delay': `${i * 60}ms`, '--pill-color': item.color }}
          >
          <span class="asset-class-pill-circle" aria-hidden="true">
            {item.icon === 'trending' && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            )}
            {item.icon === 'crypto' && (
              <span class="asset-class-pill-xi" aria-hidden="true">Ξ</span>
            )}
            {item.icon === 'suitcase' && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><path d="M8 11h8"/></svg>
            )}
            {item.icon === 'pie' && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
            )}
            {item.icon === 'forward' && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="13 17 18 12 13 7"/><polyline points="6 17 11 12 6 7"/></svg>
            )}
            {item.icon === 'medal' && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 14L10 14 12 16 12 20 2 20 2 16 2 14"/><path d="M12 14L20 14 22 16 22 20 12 20 12 16 12 14"/><path d="M6 6L14 6 16 8 16 12 6 12 6 8 6 6"/></svg>
            )}
            {item.icon === 'yen' && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3l4 5 4-5M12 8v12"/><path d="M6 11h12"/><path d="M6 15h12"/></svg>
            )}
            {item.icon === 'grid' && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            )}
          </span>
          <span class="asset-class-pill-text">
            <span class="asset-class-pill-label">{item.label}</span>
            <span class="asset-class-pill-support">{item.supportLine}</span>
          </span>
        </span>
        </span>
      ))}
    </div>
    <div class="max-w-2xl mx-auto space-y-4 text-center">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Every asset class. Every account. One complete view. That's how you track real portfolio performance - not just individual positions in isolation.
      </p>
    </div>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const pills = document.querySelector('.asset-classes-pills');
        if (!pills) return;
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) entry.target.classList.add('in-view');
            });
          },
          { rootMargin: '0px 0px -40px 0px', threshold: 0.1 }
        );
        observer.observe(pills);
      });
    </script>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) entry.target.classList.add('in-view');
            });
          },
          { rootMargin: '0px 0px -40px 0px', threshold: 0.1 }
        );
        const envelopeSection = document.querySelector('.envelope-section');
        if (envelopeSection) revealObserver.observe(envelopeSection);
        document.querySelectorAll('.method-image-reveal').forEach((el) => revealObserver.observe(el));
        const privacySection = document.querySelector('.privacy-section');
        if (privacySection) revealObserver.observe(privacySection);
        const stepsSection = document.querySelector('.steps-section');
        if (stepsSection) revealObserver.observe(stepsSection);
        const ctaCard = document.querySelector('.cta-card-reveal');
        if (ctaCard) revealObserver.observe(ctaCard);
        const stopGuessingCards = document.querySelector('.stop-guessing-cards');
        if (stopGuessingCards) revealObserver.observe(stopGuessingCards);
      });
    </script>
  </Section>

  <!-- Your investment portfolio at a glance -->
  <Section
    heading="Your investment portfolio at a glance"
    subheading="Every data point you need to invest with confidence, in real-time."
    align="center"
    class="!bg-white dark:!bg-[#171717]"
  >
    <div class="screenshot-pile flex justify-center items-end mb-20 max-w-4xl mx-auto px-2 sm:px-4 overflow-visible min-h-[160px] sm:min-h-[180px] md:min-h-[220px] -mt-12 max-sm:-mt-16 md:-mt-6">
      <div class="screenshot-in-left screenshot-card w-[154px] sm:w-[220px] md:w-[330px] aspect-[1200/759] rounded-xl overflow-hidden bg-white dark:bg-neutral-900 shadow-[0_20px_40px_-8px_rgba(0,0,0,0.15),0_32px_80px_-16px_rgba(0,0,0,0.2)] dark:shadow-[0_24px_48px_-12px_rgba(0,0,0,0.45)] border border-neutral-200 dark:border-neutral-600/50 flex-shrink-0 -mr-12 sm:-mr-16 md:-mr-12 z-0">
        <img src="/images/portfolio-tracker/allocation_light.png" alt="Allocation view" class="w-full h-full object-cover block dark:hidden" />
