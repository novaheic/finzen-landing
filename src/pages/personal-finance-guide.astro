---
/**
 * /personal-finance-guide
 *
 * Angle: Beginners, simplicity seekers, overwhelmed users
 * Audience: People new to personal finance or frustrated by complex apps
 * Intent: "I want something simple to manage my money"
 *
 * Target Keywords:
 * - personal finance guide (100-1K)
 * - personal finance for beginners (100-1K)
 * - budgeting for beginners (1K-10K)
 * - simple budgeting app (1K-10K)
 * - how to manage personal finances (100-1K)
 * - budgeting made simple (100-1K)
 * - easy budgeting app (100-1K)
 */

import Layout from '@/layouts/Layout.astro';
import { pages, APP_URL } from '@/data/pages';
import AngleHero from '@/components/AngleHero.astro';
import Section from '@/components/Section.astro';
import FeatureList from '@/components/FeatureList.astro';
import CTABlock from '@/components/CTABlock.astro';
import SiblingLinks from '@/components/SiblingLinks.astro';

const meta = pages.personalFinanceGuide;

// Ring stats for "The overwhelm problem" section
const R = 48;
const C = 2 * Math.PI * R;
const overwhelmRings = [
  { pct: 65, label: 'of Americans can\'t pass a basic financial literacy test' },
  { pct: 78, label: 'of people feel overwhelmed by personal finance apps' },
  { pct: 56, label: 'give up on budgeting apps within the first month' },
].map(({ pct, label }) => ({ pct, label, offset: C * (1 - pct / 100) }));
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={`/${meta.slug}`}
>

  <AngleHero
    eyebrow="Personal Finance Made Simple"
    title="Your Complete Personal Finance Guide"
    subtitle="No finance degree required. No complicated spreadsheets. Just clarity about your money in 3 minutes a day."
    keyword="personal finance for beginners"
  />

  <!-- Wrapper: full width, clip horizontal overflow only (overflow-x-clip avoids clipping top on mobile scale) -->
  <div class="w-full overflow-x-clip -mt-52 md:-mt-[21.2rem] mb-0 relative z-10 flex justify-center">
    <div class="hero-image-reveal w-max max-w-full min-w-0 shrink-0">
      <!-- Mobile: responsive + scale up. Desktop: fixed width, no scale, can overflow left/right -->
      <div class="scale-[1.15] md:scale-100 origin-center md:w-[960px] md:max-w-none">
        <img
          src="/images/mindful-money-tracking/hero_light.png"
          alt="Personal finance guide — simple money management"
          class="w-auto max-w-full md:w-full h-auto rounded-lg block dark:hidden"
        />
        <img
          src="/images/mindful-money-tracking/hero_dark.png"
          alt="Personal finance guide — simple money management"
          class="w-auto max-w-full md:w-full h-auto rounded-lg block hidden dark:block"
        />
      </div>
    </div>
  </div>

  <!-- ============================================================
       SECTION 1: YOU DON'T NEED TO BE AN EXPERT
       ============================================================ -->
  <Section
    heading="You don't need to be a finance expert"
    bg="stone"
    class="mt-4 md:mt-0 !pt-12 md:!pt-2"
  >
    <div class="flex flex-col md:flex-row md:items-start md:gap-8 lg:gap-10">
      <!-- Text column (left on desktop) -->
      <div class="flex-1 min-w-0 max-w-2xl overflow-hidden">
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          Personal finance doesn't require a degree in economics. At its core, it's about three things: knowing where your money goes, spending less than you earn, and putting the difference to work. That's it.
        </p>
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          The problem isn't that personal finance is complicated — it's that most resources make it feel that way. Jargon, complex strategies, apps with 50 features you'll never use. This guide cuts through all of that.
        </p>
        <!-- Mobile only: after second paragraph. Hidden under 450px; >=450px float right; <450px in line (but hidden) -->
        <div class="rocks-reveal md:hidden max-[449px]:hidden mb-4 min-[380px]:float-right min-[380px]:ml-4 min-[380px]:mb-4 min-[380px]:mt-0 w-fit">
          <img
            src="/images/mindful-money-tracking/stones.png"
            alt="Simple personal finance — no complexity"
            class="rounded-lg max-w-[140px] min-[380px]:max-w-[160px] mx-auto min-[380px]:mx-0 block"
          />
        </div>
        <p class="text-lg font-medium text-neutral-700 dark:text-neutral-300 leading-relaxed mb-0">
          This page is your <strong>personal finance guide</strong> — the essentials you actually need, explained simply. Whether you're starting from zero or just want to simplify your approach, start here.
        </p>
        <div class="clear-both md:clear-none"></div>
      </div>
      <!-- Image: right column on desktop only -->
      <div class="rocks-reveal hidden md:block flex-shrink-0 w-full md:max-w-[270px] lg:max-w-[270px] p-6 lg:p-8">
        <img
          src="/images/mindful-money-tracking/stones.png"
          alt="Simple personal finance — no complexity"
          class="w-full h-auto rounded-lg"
        />
      </div>
    </div>
  </Section>

  <!-- ============================================================
       SECTION 2: THE OVERWHELM PROBLEM
       ============================================================ -->
  <Section
    heading="The overwhelm is real"
    align="center"
  >
    <div class="overwhelm-rings mb-20">
      {overwhelmRings.map(({ pct, label, offset }, i) => (
        <div class="ring-item" style={`--ring-offset: ${offset}; --ring-delay: ${i * 0.12}s`}>
          <div class="ring-wrapper">
            <svg class="ring-svg" viewBox="0 0 120 120" aria-hidden="true">
              <circle
                class="ring-track"
                cx="60"
                cy="60"
                r={R}
                fill="none"
                stroke-width="6"
              />
              <circle
                class="ring-progress"
                cx="60"
                cy="60"
                r={R}
                fill="none"
                stroke-width="6"
                stroke-dasharray={C}
                transform="rotate(-90 60 60)"
              />
            </svg>
            <span class="ring-pct">{pct}%</span>
          </div>
          <p class="ring-label">{label}</p>
        </div>
      ))}
    </div>

    <div class="max-w-2xl space-y-4 text-center mx-auto">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Financial literacy isn't taught in schools. Most people learn money management through trial and error — expensive mistakes, confusing advice, and apps that assume you already know what you're doing.
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        The good news: you don't need to master everything. You just need a few key principles and a simple way to track your progress. That's exactly what this guide provides.
      </p>
    </div>
  </Section>

  <!-- ============================================================
       SECTION 3: PERSONAL FINANCE RULES OF THUMB
       ============================================================ -->
  <Section
    heading="Personal finance rules of thumb"
    subheading="Simple guidelines that actually work"
    bg="stone"
  >
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        <!-- Rule 1: 50/30/20 -->
        <div class="rule-card rounded-2xl p-6 bg-white dark:bg-neutral-900 shadow-[8px_8px_16px_rgba(0,0,0,0.08),-4px_-4px_12px_rgba(0,0,0,0.04)] dark:shadow-[8px_8px_18px_rgba(0,0,0,0.5),10px_10px_30px_rgba(0,0,0,0.12),-3px_-3px_6px_rgba(255,255,255,0.08)]">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">50/30/20</span>
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-2">The budget ratio</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            <strong>50%</strong> on needs (rent, utilities, groceries, insurance). <strong>30%</strong> on wants (dining out, hobbies, subscriptions). <strong>20%</strong> on savings and debt payoff. Not a rigid law — a starting framework you can adjust.
          </p>
        </div>

        <!-- Rule 2: Emergency Fund -->
        <div class="rule-card rounded-2xl p-6 bg-white dark:bg-neutral-900 shadow-[8px_8px_16px_rgba(0,0,0,0.08),-4px_-4px_12px_rgba(0,0,0,0.04)] dark:shadow-[8px_8px_18px_rgba(0,0,0,0.5),10px_10px_30px_rgba(0,0,0,0.12),-3px_-3px_6px_rgba(255,255,255,0.08)]">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">3–6 mo</span>
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-2">Emergency fund target</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Before investing, build a cash buffer covering 3–6 months of expenses. This protects you from job loss, medical emergencies, or unexpected repairs. Start with $1,000, then build up over time.
          </p>
        </div>

        <!-- Rule 3: Pay Yourself First -->
        <div class="rule-card rounded-2xl p-6 bg-white dark:bg-neutral-900 shadow-[8px_8px_16px_rgba(0,0,0,0.08),-4px_-4px_12px_rgba(0,0,0,0.04)] dark:shadow-[8px_8px_18px_rgba(0,0,0,0.5),10px_10px_30px_rgba(0,0,0,0.12),-3px_-3px_6px_rgba(255,255,255,0.08)]">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">10%+</span>
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-2">Pay yourself first</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Transfer at least 10% of every paycheck to savings before spending anything else. Automate this if possible — what you don't see, you won't spend. Increase the percentage as your income grows.
          </p>
        </div>

        <!-- Rule 4: Debt Avalanche/Snowball -->
        <div class="rule-card rounded-2xl p-6 bg-white dark:bg-neutral-900 shadow-[8px_8px_16px_rgba(0,0,0,0.08),-4px_-4px_12px_rgba(0,0,0,0.04)] dark:shadow-[8px_8px_18px_rgba(0,0,0,0.5),10px_10px_30px_rgba(0,0,0,0.12),-3px_-3px_6px_rgba(255,255,255,0.08)]">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">High %</span>
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-2">Attack high-interest debt first</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Pay minimums on all debts, then throw extra money at the highest-interest one. Credit cards often charge 20%+ APR — that's an emergency. Paying these down is a guaranteed 20% return.
          </p>
        </div>

        <!-- Rule 5: Housing -->
        <div class="rule-card rounded-2xl p-6 bg-white dark:bg-neutral-900 shadow-[8px_8px_16px_rgba(0,0,0,0.08),-4px_-4px_12px_rgba(0,0,0,0.04)] dark:shadow-[8px_8px_18px_rgba(0,0,0,0.5),10px_10px_30px_rgba(0,0,0,0.12),-3px_-3px_6px_rgba(255,255,255,0.08)]">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">≤30%</span>
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-2">Housing costs</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Keep rent or mortgage under 30% of your gross income. Going higher squeezes savings, emergencies, and quality of life. Housing is usually your biggest expense — getting this right matters.
          </p>
        </div>

        <!-- Rule 6: Investing -->
        <div class="rule-card rounded-2xl p-6 bg-white dark:bg-neutral-900 shadow-[8px_8px_16px_rgba(0,0,0,0.08),-4px_-4px_12px_rgba(0,0,0,0.04)] dark:shadow-[8px_8px_18px_rgba(0,0,0,0.5),10px_10px_30px_rgba(0,0,0,0.12),-3px_-3px_6px_rgba(255,255,255,0.08)]">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">15%</span>
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-2">Invest for retirement</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Once you have an emergency fund, aim to invest 15% of income for retirement. Start with whatever you can — even 1% — and increase over time. Time in the market beats timing the market.
          </p>
        </div>
      </div>

      <div class="mt-10 max-w-2xl mx-auto text-center">
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          These aren't rigid laws — they're starting points. Your situation is unique. A student's budget looks different from a retiree's. The important thing is to start somewhere, track your progress, and adjust as you learn.
        </p>
      </div>
    </div>
  </Section>

  <!-- ============================================================
       SECTION 4: THE 3-MINUTE HABIT
       ============================================================ -->
  <Section class="pt-8 pb-16 md:py-24">
    <div class="flex flex-col md:flex-row md:items-center md:gap-4 lg:gap-6">
      <!-- Image: left on desktop, above on mobile — mobile manual input screenshot.
           Size: wrapper is 50% column; images capped at max-w. Centered on mobile. -->
      <div class="method-image-reveal w-full md:w-1/2 flex-shrink-0 order-first md:order-none flex justify-center md:justify-start mb-6 md:mb-0">
        <img
          src="/images/mindful-money-tracking/method_light.png"
          alt="Finzen mobile app — simple transaction entry"
          class="w-full max-w-[260px] h-auto rounded-lg block dark:hidden"
        />
        <img
          src="/images/mindful-money-tracking/method_dark.png"
          alt="Finzen mobile app — simple transaction entry"
          class="w-full max-w-[260px] h-auto rounded-lg hidden dark:block"
        />
      </div>
      <!-- Title, text, checkmarks: right on desktop, below image on mobile -->
      <div class="w-full md:w-1/2 min-w-0 flex flex-col gap-4 order-last md:order-none">
        <h2 class="text-2xl md:text-3xl font-semibold text-neutral-900 dark:text-neutral-100 leading-tight">
          The 3-minute daily habit
        </h2>
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          The most effective financial habit isn't complicated. It's a simple daily check-in: record what you spent, see where you stand, move on with your day. Three minutes. That's it.
        </p>
        <ul class="space-y-2 list-none pl-0 mt-1">
          <li class="flex items-start gap-3 text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
            <span class="check-minimal check-align shrink-0" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l3 3 7-7"/></svg>
            </span>
            <span>Open the app (30 seconds)</span>
          </li>
          <li class="flex items-start gap-3 text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
            <span class="check-minimal check-align shrink-0" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l3 3 7-7"/></svg>
            </span>
            <span>Enter today's spending (2 minutes)</span>
          </li>
          <li class="flex items-start gap-3 text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
            <span class="check-minimal check-align shrink-0" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l3 3 7-7"/></svg>
            </span>
            <span>Check your budget status (30 seconds)</span>
          </li>
          <li class="flex items-start gap-3 text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
            <span class="check-minimal check-align shrink-0" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l3 3 7-7"/></svg>
            </span>
            <span>Done. Close the app.</span>
          </li>
        </ul>
      </div>
    </div>
  </Section>

  <!-- ============================================================
       SECTION 5: SIMPLE NOW, POWERFUL LATER
       ============================================================ -->
  <Section
    heading="Simple now. Powerful when you're ready."
    bg="stone"
  >
    <div class="envelope-section flex flex-col md:flex-row md:items-center gap-6 md:gap-0 max-w-4xl mx-auto">
      <!-- Left column: text (on mobile: paras 1–3, then image+button, then paras 4–6) -->
      <div class="flex-1 min-w-0 space-y-4 text-center md:text-left">
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          <strong>Week 1:</strong> Just track your spending. Nothing else. Don't worry about budgets or categories yet — just record what goes out. Build the daily habit first.
        </p>
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          <strong>Month 1:</strong> Now you have data. Create a simple budget based on what you actually spent. See where reality differs from your expectations.
        </p>

        <!-- Mobile only: image + CTA between second and third paragraph (image reveals from below) -->
        <div class="flex flex-col items-center gap-4 py-2 md:hidden">
          <div class="envelope-reveal-mobile w-full max-w-[560px] rounded-lg overflow-hidden">
            <img
              src="/images/mindful-money-tracking/envelope_budgeting_light.png"
              alt="Grow at your own pace — from beginner to expert"
              class="w-full h-auto rounded-lg block dark:hidden"
            />
            <img
              src="/images/mindful-money-tracking/envelope_budgeting_dark.png"
              alt="Grow at your own pace — from beginner to expert"
              class="w-full h-auto rounded-lg hidden dark:block"
            />
          </div>
          <a
            href={APP_URL}
            class="inline-flex items-center gap-2 px-6 py-3 border-2 border-neutral-800 dark:border-neutral-200 text-neutral-800 dark:text-neutral-200 text-base font-medium rounded-xl hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
          >
            Start your journey
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          <strong>Month 2:</strong> Add your savings accounts and investments. Track your total net worth. See the complete picture of where you stand financially.
        </p>
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          <strong>Month 3+:</strong> Now you have trends. Compare months. Spot patterns. Adjust your approach based on real data, not guesswork.
        </p>
      </div>

      <!-- Right column: image + CTA (desktop only); image reveals from right -->
      <div class="hidden md:flex flex-shrink-0 flex-col items-center gap-4 w-[560px] md:-ml-8">
        <div class="envelope-reveal-desktop w-full rounded-lg overflow-hidden">
          <img
            src="/images/mindful-money-tracking/envelope_budgeting_light.png"
            alt="Grow at your own pace — from beginner to expert"
            class="w-full h-auto rounded-lg block dark:hidden"
          />
          <img
            src="/images/mindful-money-tracking/envelope_budgeting_dark.png"
            alt="Grow at your own pace — from beginner to expert"
            class="w-full h-auto rounded-lg hidden dark:block"
          />
        </div>
        <a
          href={APP_URL}
          class="inline-flex items-center gap-2 px-6 py-3 border-2 border-neutral-800 dark:border-neutral-200 text-neutral-800 dark:text-neutral-200 text-base font-medium rounded-xl hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors whitespace-nowrap"
        >
          Start your journey
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </Section>

  <!-- ============================================================
       SECTION 6: THREE THINGS THAT MATTER (neumorphic cards)
       ============================================================ -->
  <Section
    heading="Three things that actually matter"
    align="center"
  >
    <div class="w-full max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
      <!-- Card 1: Know where your money goes -->
      <div class="habit-card rounded-2xl p-6 md:p-8 bg-white dark:bg-neutral-900 transition-transform duration-200 hover:-translate-y-1 shadow-[8px_8px_16px_rgba(0,0,0,0.08),-4px_-4px_12px_rgba(0,0,0,0.04)] dark:shadow-[8px_8px_18px_rgba(0,0,0,0.5),10px_10px_30px_rgba(0,0,0,0.12),-3px_-3px_6px_rgba(255,255,255,0.08)] flex flex-col items-center text-center">
        <div class="w-12 h-12 rounded-xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center mb-4 text-neutral-600 dark:text-neutral-400" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 6v6l4 2"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-2">Know where it goes</h3>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Most people have no idea where their money actually goes. Tracking reveals the truth: subscriptions you forgot, small purchases that add up, patterns you never noticed.
        </p>
      </div>
      <!-- Card 2: Spend without guilt -->
      <div class="habit-card rounded-2xl p-6 md:p-8 bg-white dark:bg-neutral-900 transition-transform duration-200 hover:-translate-y-1 shadow-[8px_8px_16px_rgba(0,0,0,0.08),-4px_-4px_12px_rgba(0,0,0,0.04)] dark:shadow-[8px_8px_18px_rgba(0,0,0,0.5),10px_10px_30px_rgba(0,0,0,0.12),-3px_-3px_6px_rgba(255,255,255,0.08)] flex flex-col items-center text-center">
        <div class="w-12 h-12 rounded-xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center mb-4 text-neutral-600 dark:text-neutral-400" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 11l3 3L22 4"/>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-2">Spend without guilt</h3>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
          A budget isn't a restriction — it's permission. When you've planned for entertainment or dining out, spending on those things stops feeling guilty and starts feeling intentional.
        </p>
      </div>
      <!-- Card 3: Build real wealth -->
      <div class="habit-card rounded-2xl p-6 md:p-8 bg-white dark:bg-neutral-900 transition-transform duration-200 hover:-translate-y-1 shadow-[8px_8px_16px_rgba(0,0,0,0.08),-4px_-4px_12px_rgba(0,0,0,0.04)] dark:shadow-[8px_8px_18px_rgba(0,0,0,0.5),10px_10px_30px_rgba(0,0,0,0.12),-3px_-3px_6px_rgba(255,255,255,0.08)] flex flex-col items-center text-center">
