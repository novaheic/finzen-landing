<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -20px 0px' }
    );

    const overwhelmRings = document.querySelector('.overwhelm-rings');
    if (overwhelmRings) observer.observe(overwhelmRings);

    const heroImage = document.querySelector('.hero-image-reveal');
    if (heroImage) observer.observe(heroImage);

    const dashboardReveal = document.querySelector('.dashboard-reveal');
    if (dashboardReveal) observer.observe(dashboardReveal);

    document.querySelectorAll('.rocks-reveal').forEach((el) => observer.observe(el));

    document.querySelectorAll('.method-image-reveal').forEach((el) => observer.observe(el));

    document.querySelectorAll('.envelope-section').forEach((el) => observer.observe(el));

    const rulesTimeline = document.querySelector('.rules-timeline');
    if (rulesTimeline) observer.observe(rulesTimeline);

    const rulesTimelineDesktop = document.querySelector('.rules-timeline-desktop');
    if (rulesTimelineDesktop) observer.observe(rulesTimelineDesktop);

    document.querySelectorAll('.screenshot-pile').forEach((el) => observer.observe(el));
  });
</script>
