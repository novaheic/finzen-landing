    <script>
      (function () {
        const link = document.getElementById('cheatsheet-download');
        const lightBtn = document.getElementById('cheatsheet-light-btn');
        const darkBtn = document.getElementById('cheatsheet-dark-btn');
        const lightBtnMobile = document.getElementById('cheatsheet-light-btn-mobile');
        const darkBtnMobile = document.getElementById('cheatsheet-dark-btn-mobile');
        const lightImg = document.getElementById('cheatsheet-light-img');
        const darkImg = document.getElementById('cheatsheet-dark-img');

        if (!link || !lightImg || !darkImg) return;

        // State: track current cheatsheet theme (initialize from system)
        let cheatsheetTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
        let userHasManuallyToggled = false;

        // Update UI based on current theme selection
        function updateCheatsheetDisplay() {
          // Update images
          if (cheatsheetTheme === 'dark') {
            lightImg.classList.add('hidden');
            darkImg.classList.remove('hidden');
          } else {
            darkImg.classList.add('hidden');
            lightImg.classList.remove('hidden');
          }

          // Update desktop toggle buttons
          if (lightBtn && darkBtn) {
            lightBtn.classList.toggle('bg-white', cheatsheetTheme === 'light');
            lightBtn.classList.toggle('dark:bg-neutral-700', cheatsheetTheme === 'light');
            lightBtn.classList.toggle('text-neutral-900', cheatsheetTheme === 'light');
            lightBtn.classList.toggle('dark:text-neutral-100', cheatsheetTheme === 'light');
            lightBtn.classList.toggle('shadow-sm', cheatsheetTheme === 'light');
            lightBtn.classList.toggle('text-neutral-500', cheatsheetTheme !== 'light');
            lightBtn.classList.toggle('dark:text-neutral-400', cheatsheetTheme !== 'light');

            darkBtn.classList.toggle('bg-white', cheatsheetTheme === 'dark');
            darkBtn.classList.toggle('dark:bg-neutral-700', cheatsheetTheme === 'dark');
            darkBtn.classList.toggle('text-neutral-900', cheatsheetTheme === 'dark');
            darkBtn.classList.toggle('dark:text-neutral-100', cheatsheetTheme === 'dark');
            darkBtn.classList.toggle('shadow-sm', cheatsheetTheme === 'dark');
            darkBtn.classList.toggle('text-neutral-500', cheatsheetTheme !== 'dark');
            darkBtn.classList.toggle('dark:text-neutral-400', cheatsheetTheme !== 'dark');
          }

          // Update mobile toggle buttons
          if (lightBtnMobile && darkBtnMobile) {
            lightBtnMobile.classList.toggle('bg-white', cheatsheetTheme === 'light');
            lightBtnMobile.classList.toggle('dark:bg-neutral-700', cheatsheetTheme === 'light');
            lightBtnMobile.classList.toggle('text-neutral-900', cheatsheetTheme === 'light');
            lightBtnMobile.classList.toggle('dark:text-neutral-100', cheatsheetTheme === 'light');
            lightBtnMobile.classList.toggle('shadow-sm', cheatsheetTheme === 'light');
            lightBtnMobile.classList.toggle('text-neutral-500', cheatsheetTheme !== 'light');
            lightBtnMobile.classList.toggle('dark:text-neutral-400', cheatsheetTheme !== 'light');

            darkBtnMobile.classList.toggle('bg-white', cheatsheetTheme === 'dark');
            darkBtnMobile.classList.toggle('dark:bg-neutral-700', cheatsheetTheme === 'dark');
            darkBtnMobile.classList.toggle('text-neutral-900', cheatsheetTheme === 'dark');
            darkBtnMobile.classList.toggle('dark:text-neutral-100', cheatsheetTheme === 'dark');
            darkBtnMobile.classList.toggle('shadow-sm', cheatsheetTheme === 'dark');
            darkBtnMobile.classList.toggle('text-neutral-500', cheatsheetTheme !== 'dark');
            darkBtnMobile.classList.toggle('dark:text-neutral-400', cheatsheetTheme !== 'dark');
          }

          // Update download link
          link.href = `/downloads/personal-finance-cheatsheet-${cheatsheetTheme}.pdf`;
        }

        // Handle toggle button clicks
        function setTheme(theme) {
          cheatsheetTheme = theme;
          userHasManuallyToggled = true;
          updateCheatsheetDisplay();
        }

        if (lightBtn) lightBtn.addEventListener('click', () => setTheme('light'));
        if (darkBtn) darkBtn.addEventListener('click', () => setTheme('dark'));
        if (lightBtnMobile) lightBtnMobile.addEventListener('click', () => setTheme('light'));
        if (darkBtnMobile) darkBtnMobile.addEventListener('click', () => setTheme('dark'));

        // Initialize display
        updateCheatsheetDisplay();

        // Update cheatsheet theme when system theme changes (only if user hasn't manually toggled)
        const observer = new MutationObserver(() => {
          if (!userHasManuallyToggled) {
            const systemIsDark = document.documentElement.classList.contains('dark');
            cheatsheetTheme = systemIsDark ? 'dark' : 'light';
            updateCheatsheetDisplay();
          }
        });
        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class']
        });
      })();
    </script>
