<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -20px 0px' }
    );

    const overwhelmRings = document.querySelector('.overwhelm-rings');
    if (overwhelmRings) observer.observe(overwhelmRings);

    const heroImage = document.querySelector('.hero-image-reveal');
    if (heroImage) observer.observe(heroImage);

    document.querySelectorAll('.rocks-reveal').forEach((el) => observer.observe(el));

    document.querySelectorAll('.method-image-reveal').forEach((el) => observer.observe(el));

    const envelopeSection = document.querySelector('.envelope-section');
    if (envelopeSection) observer.observe(envelopeSection);
  });
</script>
