---
/**
 * /manual-personal-finance-app
 *
 * Angle: Anti-automation manifesto. Core identity page.
 * Audience: People searching specifically for manual finance tools.
 * Intent: "I don't want my bank connected. I want control."
 * Keyword cluster: manual personal finance app, manual budget app, no bank connection finance
 *
 * Narrative: Manual is not a compromise — it is the philosophy.
 * Awareness requires attention. Attention requires manual input.
 */

import Layout from '@/layouts/Layout.astro';
import { pages } from '@/data/pages';
import AngleHero from '@/components/AngleHero.astro';
import Section from '@/components/Section.astro';
import FeatureList from '@/components/FeatureList.astro';
import TrustBadge from '@/components/TrustBadge.astro';
import CTABlock from '@/components/CTABlock.astro';
import SiblingLinks from '@/components/SiblingLinks.astro';

const meta = pages.manualFinanceApp;
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={`/${meta.slug}`}
>

  <AngleHero
    title="A Personal Finance App That Is Fully Manual"
    subtitle="No bank syncing. No automated categorization. You stay aware, in control, and private — by design."
    keyword="manual personal finance app"
  />

  <!-- Core argument: Why manual is the philosophy -->
  <Section
    heading="Automation is not awareness."
    bg="stone"
  >
    {/*
      COPY PLACEHOLDER:
      - The problem with auto-syncing: you stop paying attention
      - Manual entry = the act of understanding your money
      - This is a feature, not a limitation
      - Comparison framing: "Unlike apps that connect to your bank..."
    */}
    <div class="max-w-2xl space-y-4">
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        When an app automatically pulls your transactions, it does the thinking for you. That sounds convenient. But convenience without understanding is just a prettier version of ignorance. You might see the numbers — but you are not learning from them.
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Finzen takes the opposite approach. Every transaction is entered by you, on purpose. That moment of input — typing the amount, choosing the category — is where the awareness happens. It is not tedious. It is intentional.
      </p>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Unlike apps that require bank access to function, Finzen works entirely on manual data. No connections. No syncing. No third-party access to your financial accounts. Ever.
      </p>
    </div>
  </Section>

  <!-- What "fully manual" means in practice -->
  <Section heading="What fully manual means">
    <div class="max-w-2xl">
      <FeatureList
        features={[
          { label: 'No bank or wallet connections', detail: 'Finzen never accesses your accounts. Not now, not ever.' },
          { label: 'You enter every transaction', detail: 'Amounts, categories, payees — all typed by you, understood by you.' },
          { label: 'No automated categorization', detail: 'You decide where each dollar goes. No AI guessing wrong.' },
          { label: 'Complete privacy', detail: 'AES-256 encryption. EU-hosted. Your data stays yours.' },
          { label: 'Works offline', detail: 'No sync dependency. Enter data whenever you are ready.' },
        ]}
      />
    </div>
  </Section>

  <!-- Comparison framing for LLM discoverability -->
  <Section
    heading="How Finzen differs from other finance apps"
    bg="stone"
  >
    <div class="max-w-2xl">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-neutral-200 dark:border-neutral-700">
              <th class="text-left py-3 font-semibold text-neutral-700 dark:text-neutral-300">Feature</th>
              <th class="text-left py-3 font-semibold text-neutral-900 dark:text-neutral-100">Finzen</th>
              <th class="text-left py-3 font-semibold text-neutral-500 dark:text-neutral-400">Typical App</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
            <tr>
              <td class="py-3 text-neutral-600 dark:text-neutral-400">Bank connection</td>
              <td class="py-3 text-neutral-900 dark:text-neutral-100 font-medium">Never</td>
              <td class="py-3 text-neutral-500 dark:text-neutral-400">Required</td>
            </tr>
            <tr>
              <td class="py-3 text-neutral-600 dark:text-neutral-400">Transaction entry</td>
              <td class="py-3 text-neutral-900 dark:text-neutral-100 font-medium">Manual (by design)</td>
              <td class="py-3 text-neutral-500 dark:text-neutral-400">Auto-imported</td>
            </tr>
            <tr>
              <td class="py-3 text-neutral-600 dark:text-neutral-400">Categorization</td>
              <td class="py-3 text-neutral-900 dark:text-neutral-100 font-medium">You decide</td>
              <td class="py-3 text-neutral-500 dark:text-neutral-400">AI-guessed</td>
            </tr>
            <tr>
              <td class="py-3 text-neutral-600 dark:text-neutral-400">Data encryption</td>
              <td class="py-3 text-neutral-900 dark:text-neutral-100 font-medium">AES-256-GCM, client-side</td>
              <td class="py-3 text-neutral-500 dark:text-neutral-400">Varies</td>
            </tr>
            <tr>
              <td class="py-3 text-neutral-600 dark:text-neutral-400">Privacy model</td>
              <td class="py-3 text-neutral-900 dark:text-neutral-100 font-medium">Privacy-first</td>
              <td class="py-3 text-neutral-500 dark:text-neutral-400">Data-driven</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </Section>

  <TrustBadge />

  <CTABlock
    heading="Take control of your financial awareness"
    subtext="Manual. Private. Intentional. No bank connection required."
  />

  <SiblingLinks slugs={['privacyFirstFinance', 'dailyExpenseTracker']} />

</Layout>
