---
/**
 * Homepage — /
 *
 * The main narrative page. A scrolling story that builds trust,
 * explains the product, and converts visitors into users.
 *
 * Target Keywords (High Volume):
 * - personal finance app (10K-100K)
 * - personal finance software (10K-100K)
 * - budget tracker (1K-10K)
 * - money tracking app (1K-10K)
 * - personal finance tools (1K-10K)
 * - finance management (10K-100K)
 * - personal finance manager (1K-10K)
 * - budgeting and investing (100-1K)
 * - all in one personal finance app (10-100)
 *
 * --- SECTION MAP ---
 *   1. Hero                  — All-in-one hook
 *   2. The Problem           — Stop juggling apps and spreadsheets
 *   3. How It Works          — 4 steps: Budget, Track, Invest, See
 *   4. Feature Overview      — Quick hits on all capabilities
 *   5. The Experience        — What it feels like (emotional)
 *   6. Trust & Privacy       — Encryption, EU servers, no connections
 *   7. Founder Story         — Why this was built
 *   8. Qualification         — Who this is / isn't for
 *   9. Internal Links        — Links to angle pages
 *   10. CTA                  — Get started
 */

import Layout from '@/layouts/Layout.astro';
import { pages, anglePages } from '@/data/pages';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import TrustBadge from '@/components/TrustBadge.astro';
import CTABlock from '@/components/CTABlock.astro';

const meta = pages.home;

// Donut rings for "One app. The full picture." (same as mindful-money-tracking disconnect section)
const R = 48;
const C = 2 * Math.PI * R;
const fullPictureRings = [
  { pct: 78, label: 'of workers live paycheck to paycheck, regardless of income level' },
  { pct: 27, label: 'Only 27% of Americans feel confident enough to create an investment plan' },
  { pct: 83, label: 'of people who use envelope budgeting report an improved financial situation' },
].map(({ pct, label }) => ({ pct, label, offset: C * (1 - pct / 100) }));
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical="/"
>

  <!-- ============================================================
       SECTION 1: HERO
       All-in-one hook. Budget + Track + Invest in one app.
       ============================================================ -->
  <Hero />

  <!-- ============================================================
       SECTION 2: THE PROBLEM
       Stop juggling apps and spreadsheets.
       ============================================================ -->
  <Section
    heading="Managing your finances might seem scary"
    subheading="Let's be honest"
    subtitleAbove
    align="center"
    bg="stone"
    class="bg-white dark:bg-[#1B1B1B]"
  >
    <div class="space-y-4 flex flex-col items-center">
      <div class="max-w-2xl w-full">
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          It really doesn't have to be. You don't need a financial advisor, a spreadsheet obsession, or a finance degree to get on top of your money. Just the right tools and a little clarity.
        </p>
      </div>
      <div class="disconnection-rings my-12 w-full">
        {fullPictureRings.map(({ pct, label, offset }, i) => (
          <div class="ring-item" style={`--ring-offset: ${offset}; --ring-delay: ${i * 0.12}s`}>
            <div class="ring-wrapper">
              <svg class="ring-svg" viewBox="0 0 120 120" aria-hidden="true">
                <circle
                  class="ring-track"
                  cx="60"
                  cy="60"
                  r={R}
                  fill="none"
                  stroke-width="6"
                />
                <circle
                  class="ring-progress"
                  cx="60"
                  cy="60"
                  r={R}
                  fill="none"
                  stroke-width="6"
                  stroke-dasharray={C}
                  transform="rotate(-90 60 60)"
                />
              </svg>
              <span class="ring-pct">{pct}%</span>
            </div>
            <p class="ring-label">{label}</p>
          </div>
        ))}
      </div>
      <div class="max-w-2xl w-full space-y-4">
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          That's exactly why we built Finzen. One dashboard that puts everything in one place, laid out so simply that your finances just make sense.
        </p>
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed font-bold">
          Your finances aren't as complicated as you think. We'll show you.
        </p>
      </div>
    </div>
  </Section>

  <!-- ============================================================
       SECTION 3: BUDGET. TRACK. INVEST.
       Everything in one intuitive dashboard
       ============================================================ -->
  <section class="w-full py-16 md:py-24 bg-[#ECECEC] dark:bg-neutral-900 text-neutral-800 dark:text-neutral-200">
    <div class="max-w-4xl mx-auto px-6">
      <!-- Laptop (center, behind) + mobile in front, left -->
      <div class="how-it-works-hero relative flex justify-center items-center min-h-[280px] md:min-h-[380px] mb-3 overflow-visible -translate-y-4 md:-translate-y-6">
        <!-- Mobile: in front, left (slides in from left when in view) -->
        <div class="how-it-works-mobile absolute left-4 md:left-[5.5%] bottom-0 z-20 w-[100px] md:w-[155px] lg:w-[175px] -translate-y-[18%] md:-translate-y-[12%]">
          <div class="how-it-works-mobile-anim">
            <img
              src="/images/personal-finance-charts/mobile_realtime_light.png"
              alt="Finzen app — realtime view on phone"
              class="w-full h-auto block dark:hidden"
            />
            <img
              src="/images/personal-finance-charts/mobile_realtime_dark.png"
              alt="Finzen app — realtime view on phone"
              class="w-full h-auto hidden dark:block"
            />
          </div>
        </div>
        <!-- Laptop: large, center, behind (slides in from right when in view) -->
        <div class="how-it-works-hero-img relative z-10 w-full min-w-[400px] max-w-[540px] sm:max-w-[700px] md:max-w-[860px] lg:max-w-[1000px] mx-auto -translate-y-6 md:-translate-y-8">
          <div class="how-it-works-hero-anim">
            <img
              src="/images/landing/networth_light.png"
              alt="Finzen net worth dashboard — budget, track, invest in one place"
              class="w-full h-auto block dark:hidden"
            />
            <img
              src="/images/landing/networth_dark.png"
              alt="Finzen net worth dashboard — budget, track, invest in one place"
              class="w-full h-auto hidden dark:block"
            />
          </div>
        </div>
      </div>
      <div class="mb-10 space-y-3 text-center">
        <h2 class="text-2xl md:text-3xl font-semibold text-neutral-900 dark:text-neutral-100 leading-tight">
          Budget. Track. Invest.
        </h2>
        <p class="text-base text-neutral-500 dark:text-neutral-400 leading-relaxed max-w-2xl mx-auto">
          Everything in one intuitive dashboard
        </p>
      </div>
      <div class="max-w-3xl mx-auto space-y-8 md:space-y-6">
        <!-- Paragraph 1: Envelope-based budgeting -->
        <div class="flex flex-col md:flex-row gap-3 md:gap-4">
          <div class="w-10 h-10 md:w-12 md:h-12 md:mt-0.5 rounded-xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center flex-shrink-0 mx-auto md:mx-0 text-neutral-600 dark:text-neutral-400" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <path d="M22 6l-10 7L2 6"/>
            </svg>
          </div>
          <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed text-center md:text-left flex-1">
            <strong class="text-neutral-800 dark:text-neutral-200">Envelope-based budgeting:</strong> Assign every dollar a job before you spend it. Split your income into categories and track spending against each in real time. When a category runs low, you know immediately. No surprises, no guessing, no month-end regret.
          </p>
        </div>
        <hr class="w-20 border-0 border-t border-neutral-300 dark:border-neutral-600 mx-auto md:hidden" aria-hidden="true" />
        <!-- Paragraph 2: Multi-asset portfolio tracking -->
        <div class="flex flex-col md:flex-row gap-3 md:gap-4">
          <div class="w-10 h-10 md:w-12 md:h-12 md:mt-0.5 rounded-xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center flex-shrink-0 mx-auto md:mx-0 text-neutral-600 dark:text-neutral-400" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 3v18h18"/>
              <path d="M18 17V9"/>
              <path d="M13 17V5"/>
              <path d="M8 17v-3"/>
            </svg>
          </div>
          <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed text-center md:text-left flex-1">
            <strong class="text-neutral-800 dark:text-neutral-200">Multi-asset portfolio tracking:</strong> Stocks, ETFs, crypto, commodities, forex — all in one dashboard. Track real-time prices, total returns, and net worth across every asset you own. Finzen calculates annualized performance and projections so you always know where your wealth stands.
          </p>
        </div>
        <hr class="w-20 border-0 border-t border-neutral-300 dark:border-neutral-600 mx-auto md:hidden" aria-hidden="true" />
        <!-- Paragraph 3: Visual reports & dashboards -->
        <div class="flex flex-col md:flex-row gap-3 md:gap-4">
          <div class="w-10 h-10 md:w-12 md:h-12 md:mt-0.5 rounded-xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center flex-shrink-0 mx-auto md:mx-0 text-neutral-600 dark:text-neutral-400" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </div>
          <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed text-center md:text-left flex-1">
            <strong class="text-neutral-800 dark:text-neutral-200">Visual reports &amp; dashboards:</strong> Your daily transactions become a complete picture of your financial life. Spending trends, budget health, net worth over time, and a Sankey diagram mapping every dollar from income to outcome. Clear, visual, and actually actionable.
          </p>
        </div>
        <p class="text-sm text-neutral-500 dark:text-neutral-500 text-center md:text-left md:ml-16">
          <a href="/personal-finance-charts" class="underline hover:text-neutral-700 dark:hover:text-neutral-400 transition-colors">Learn more about Finzen's visual storytelling →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 4: Finzen method (from mindful-money-tracking)
       ============================================================ -->
  <Section
    heading="Mindful Money Management"
    subheading="The Finzen method"
    bg="stone"
    class="bg-gradient-to-b from-white to-[#ECECEC] dark:from-[#1B1B1B] dark:to-[#1B1B1B]"
  >
    <div class="flex flex-col md:flex-row md:items-start md:gap-8 lg:gap-10">
      <!-- Mobile only: image above text -->
      <div class="block md:hidden mb-6 w-full max-w-[200px] mx-auto">
        <img
          src="/images/mindful-money-tracking/stones.png"
          alt="Zen garden stones — intentional, mindful placement"
          class="w-full h-auto rounded-lg"
        />
      </div>
      <!-- Text column (left on desktop) -->
      <div class="flex-1 min-w-0 max-w-2xl overflow-hidden">
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          Most finance apps promise convenience through automation. Link your accounts, sync your transactions, and forget about it. But when you stop paying attention, you lose control. Finzen is manual by design. Every transaction you log connects you to your money.
        </p>
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          Those daily logs become visual stories: spending breakdowns, net worth timelines, cash flow diagrams that reveal where your money actually goes.
        </p>
        <p class="text-lg font-medium text-neutral-700 dark:text-neutral-300 leading-relaxed mb-4">
          One small daily habit compounds into lasting financial freedom.
        </p>
        <p class="text-sm text-neutral-500 dark:text-neutral-500">
          <a href="/mindful-money-tracking" class="underline hover:text-neutral-700 dark:hover:text-neutral-400 transition-colors">Methodology →</a>
        </p>
      </div>
      <!-- Image: right column on desktop only -->
      <div class="hidden md:block flex-shrink-0 w-full md:max-w-[270px] lg:max-w-[270px] p-6 lg:p-8">
        <img
          src="/images/mindful-money-tracking/stones.png"
          alt="Zen garden stones — intentional, mindful placement"
          class="w-full h-auto rounded-lg"
        />
      </div>
    </div>
  </Section>

  <!-- Bento box section: desktop = top row 3 cells, bottom row 3 cells with middle split in two -->
  <section class="w-full pt-12 md:pt-16 dark:pt-16 dark:md:pt-24 pb-16 md:pb-24 bg-gradient-to-b from-[#ECECEC] to-white dark:from-[#171717] dark:to-[#1B1B1B] text-neutral-800 dark:text-neutral-200">
    <div class="max-w-4xl mx-auto px-6">
      <div class="bento-grid grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4">
        <!-- Top row: 3 even cells -->
        <div class="bento-cell rounded-xl p-4 md:p-6 bg-white/80 dark:bg-[#0f0f0f] border-0 shadow-[0_4px_24px_rgba(0,0,0,0.06)] dark:shadow-none min-h-[220px] md:min-h-[308px] flex flex-col justify-center md:col-start-1 md:row-start-1">
          <p class="text-sm font-medium text-neutral-500 dark:text-neutral-400">1</p>
        </div>
        <div class="bento-cell rounded-xl p-4 md:p-6 bg-white/80 dark:bg-[#0f0f0f] border-0 shadow-[0_4px_24px_rgba(0,0,0,0.06)] dark:shadow-none min-h-[220px] md:min-h-[308px] flex flex-col justify-center md:col-start-2 md:row-start-1">
          <p class="text-sm font-medium text-neutral-500 dark:text-neutral-400">2</p>
        </div>
        <div class="bento-cell rounded-xl pt-4 px-4 md:pt-6 md:px-6 pb-0 bg-white/80 dark:bg-[#0f0f0f] border-0 shadow-[0_4px_24px_rgba(0,0,0,0.06)] dark:shadow-none min-h-[220px] md:min-h-[308px] flex flex-col justify-end items-center md:col-start-3 md:row-start-1 overflow-hidden">
          <img src="/images/landing/bento_phone_light.png" alt="" class="w-full flex-1 min-h-0 object-contain object-bottom block dark:hidden" />
          <img src="/images/landing/bento_phone_dark.png" alt="" class="w-full flex-1 min-h-0 object-contain object-bottom hidden dark:block" />
        </div>
        <!-- Bottom row: left (full height), middle split into two, right (full height) -->
        <div class="bento-cell rounded-xl p-4 md:p-5 bg-white/80 dark:bg-[#0f0f0f] border-0 shadow-[0_4px_24px_rgba(0,0,0,0.06)] dark:shadow-none min-h-[220px] md:min-h-[308px] flex flex-col justify-between items-stretch text-left md:col-start-1 md:row-start-2 md:row-span-2">
          <h3 class="text-base font-semibold text-neutral-900 dark:text-white leading-tight">
            No finance degree required.
          </h3>
          <img
            src="/images/landing/emojis.webp"
            alt=""
            aria-hidden="true"
            class="w-full h-28 object-cover rounded-xl"
          />
          <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
            Made for everyone.<br> Whether you're logging your first paycheck or managing a multi-million dollar portfolio.
          </p>
          <p class="text-sm text-neutral-400 dark:text-neutral-500">
            2–3 min a day &nbsp;·&nbsp; Desktop &amp; mobile
          </p>
        </div>
        <div class="bento-cell bento-cell-half rounded-xl p-4 md:p-6 bg-black dark:bg-white border-0 shadow-[0_4px_24px_rgba(0,0,0,0.1)] dark:shadow-none min-h-[110px] md:min-h-0 flex flex-col justify-center items-center md:items-center md:col-start-2 md:row-start-2">
          <a href="/" aria-label="Finzen — Home" class="flex items-center gap-3">
            <img src="/logo-dark.webp" alt="" width="48" height="48" class="h-12 w-12 object-contain block dark:hidden" />
            <img src="/logo-light.webp" alt="" width="48" height="48" class="h-12 w-12 object-contain hidden dark:block" />
            <span class="font-logo text-4xl font-extrabold text-white dark:text-[#0a0a0a] tracking-[0.01em]">Finzen</span>
          </a>
        </div>
        <div class="bento-cell bento-cell-half rounded-xl p-3 md:p-4 bg-white/80 dark:bg-[#0f0f0f] border-0 shadow-[0_4px_24px_rgba(0,0,0,0.06)] dark:shadow-none min-h-[110px] md:min-h-0 flex flex-col justify-center items-center gap-1.5 md:col-start-2 md:row-start-3">
          <div class="flex items-center justify-center">
            <img src="/images/landing/GDPR_bento.png" alt="EU GDPR" class="w-24 h-24 object-contain" />
          </div>
          <p class="text-xs font-medium text-neutral-600 dark:text-neutral-400 text-center leading-tight">Privacy first design. All data stored fully encrypted on EU servers.</p>
        </div>
        <div class="bento-cell rounded-xl p-4 md:p-5 bg-white/80 dark:bg-[#0f0f0f] border-0 shadow-[0_4px_24px_rgba(0,0,0,0.06)] dark:shadow-none min-h-[220px] md:min-h-[308px] flex flex-col gap-3 md:col-start-3 md:row-start-2 md:row-span-2">
          <!--
            Mini Sankey: 3 sources → hub → 6 expense arms   ViewBox 280×140
            CP-left x=70, CP-right x=200. Gaps: left=6px, right=4px.

            Left sources centred on hub y=10..115 (h=105):
              Salary     65%  node y=10..70 (h=60) → hub-L y=10..78 (h=68)
              Freelance  25%  node y=76..99 (h=23) → hub-L y=78..104(h=26)
              Other      10%  node y=105..115(h=10)→ hub-L y=104..115(h=11)
            Hub: x=128, y=10, w=10, h=105

            Hub-R exits (x=138) → dest nodes (4 px gaps):
              Housing      28% h=29  hub y=10..39   dest y=10  h=29  (→y=43)
              Food         17% h=18  hub y=39..57   dest y=43  h=18  (→y=65)
              Transport    10% h=11  hub y=57..68   dest y=65  h=11  (→y=80)
              Savings      22% h=23  hub y=68..91   dest y=80  h=23  (→y=107)
              Subscriptions12% h=12  hub y=91..103  dest y=107 h=12  (→y=123)
              Lifestyle    11% h=12  hub y=103..115 dest y=123 h=12  (→135)
          -->
          <div class="bento-sankey flex-1 min-h-0 max-h-[160px] md:max-h-[180px] w-full overflow-hidden mb-4">
            <div class="sankey-reveal h-full w-full">
              <svg viewBox="0 0 280 140" class="w-full h-full" aria-hidden="true" preserveAspectRatio="none">
                <!-- Left source nodes: left corners rounded (r=3), right edge flush with flows -->
                <path class="sk-sa" d="M7,10  L12,10  L12,70  L7,70  Q4,70  4,67  L4,13  Q4,10  7,10  Z" />
                <path class="sk-fr" d="M7,76  L12,76  L12,99  L7,99  Q4,99  4,96  L4,79  Q4,76  7,76  Z" />
                <path class="sk-ot" d="M7,105 L12,105 L12,115 L7,115 Q4,115 4,112 L4,108 Q4,105 7,105 Z" />
                <!-- Left → Hub flows: solid colours at 55% opacity -->
                <path fill="#20bf6b" fill-opacity="0.55" d="M12,10  C70,10  70,10  128,10  L128,78  C70,78  70,70  12,70  Z" />
                <path fill="#0fb9b1" fill-opacity="0.50" d="M12,76  C70,76  70,78  128,78  L128,104 C70,104 70,99  12,99  Z" />
                <path fill="#2bcbba" fill-opacity="0.45" d="M12,105 C70,105 70,104 128,104 L128,115 C70,115 70,115 12,115 Z" />
                <!-- Hub node: sharp, on top of flows -->
                <rect class="sk-hub" x="128" y="10" width="10" height="105" />
                <!-- Hub → Right flows: solid colours at 55% opacity -->
                <path fill="#fc5c65" fill-opacity="0.55" d="M138,10  C200,10  200,10  262,10  L262,39  C200,39  200,39  138,39  Z" />
                <path fill="#fd9644" fill-opacity="0.55" d="M138,39  C200,39  200,43  262,43  L262,61  C200,61  200,57  138,57  Z" />
                <path fill="#fed330" fill-opacity="0.55" d="M138,57  C200,57  200,65  262,65  L262,76  C200,76  200,68  138,68  Z" />
                <path fill="#26de81" fill-opacity="0.58" d="M138,68  C200,68  200,80  262,80  L262,103 C200,103 200,91  138,91  Z" />
                <path fill="#a55eea" fill-opacity="0.55" d="M138,91  C200,91  200,107 262,107 L262,119 C200,119 200,103 138,103 Z" />
                <path fill="#fa8231" fill-opacity="0.55" d="M138,103 C200,103 200,123 262,123 L262,135 C200,135 200,115 138,115 Z" />
                <!-- Right destination nodes: right corners rounded (r=2), left edge flush with flows -->
                <path class="sk-d1" d="M262,10  L268,10  Q270,10  270,12  L270,37  Q270,39  268,39  L262,39  Z" />
                <path class="sk-d2" d="M262,43  L268,43  Q270,43  270,45  L270,59  Q270,61  268,61  L262,61  Z" />
                <path class="sk-d3" d="M262,65  L268,65  Q270,65  270,67  L270,74  Q270,76  268,76  L262,76  Z" />
                <path class="sk-d4" d="M262,80  L268,80  Q270,80  270,82  L270,101 Q270,103 268,103 L262,103 Z" />
                <path class="sk-d5" d="M262,107 L268,107 Q270,107 270,109 L270,117 Q270,119 268,119 L262,119 Z" />
                <path class="sk-d6" d="M262,123 L268,123 Q270,123 270,125 L270,133 Q270,135 268,135 L262,135 Z" />
              </svg>
            </div>
          </div>
          <h3 class="text-base font-semibold text-neutral-900 dark:text-white leading-tight">
            Visual Storytelling
          </h3>
          <p class="text-base text-neutral-400 dark:text-neutral-500 leading-snug">
            Stunning graphs that show you your financial situation at a glance. Investments, spending, real-time net worth, and more.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Cash Flow Analysis & Visual Budget Reports (from budgeting-app) -->
  <Section
    heading="Cash Flow Analysis & Visual Budget Reports"
    bg="stone"
    align="center"
    class="!bg-white dark:!bg-[#171717]"
  >
