  <style>
    /* Bento: desktop = 3 cols, row 1 = 3 cells, row 2-3 = left/right span 2 rows, middle split */
    @media (min-width: 768px) {
      .bento-grid {
        grid-template-rows: auto 1fr 1fr;
      }
    }
    /* How it works: device images slide in when section enters view */
    .how-it-works-mobile-anim {
      opacity: 0;
      transform: translateX(-40px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .how-it-works-hero.in-view .how-it-works-mobile-anim {
      opacity: 1;
      transform: translateX(0);
    }
    .how-it-works-hero-anim {
      opacity: 0;
      transform: translateX(40px);
      transition: opacity 0.6s ease-out 0.1s, transform 0.6s ease-out 0.1s;
    }
    .how-it-works-hero.in-view .how-it-works-hero-anim {
      opacity: 1;
      transform: translateX(0);
    }
    /* Cash Flow section: screenshot pile slide-in */
    .cashflow-pile .cashflow-in-left {
      opacity: 0;
      transform: translateX(-80px) rotate(-8deg);
    }
    .cashflow-pile .cashflow-in-right {
      opacity: 0;
      transform: translateX(80px) rotate(8deg);
    }
    .cashflow-pile.in-view .cashflow-in-left {
      animation: cashflowSlideLeft 0.7s ease-out forwards;
    }
    .cashflow-pile.in-view .cashflow-in-right {
      animation: cashflowSlideRight 0.7s ease-out 0.15s forwards;
    }
    @keyframes cashflowSlideLeft {
      from { opacity: 0; transform: translateX(-80px) rotate(-8deg); }
      to { opacity: 1; transform: translateX(0) rotate(-6deg); }
    }
    @keyframes cashflowSlideRight {
      from { opacity: 0; transform: translateX(80px) rotate(8deg); }
      to { opacity: 1; transform: translateX(0) rotate(6deg); }
    }
    .cashflow-pile .screenshot-card-img {
      transform: translateZ(0);
      backface-visibility: hidden;
    }
    .disconnection-rings {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.5rem;
      max-width: 56rem;
      margin-left: auto;
      margin-right: auto;
    }
    @media (min-width: 768px) {
      .disconnection-rings {
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
      }
    }
    .ring-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
    .disconnection-rings.in-view .ring-item {
      animation: ring-appear 0.6s ease-out var(--ring-delay) forwards;
    }
    @keyframes ring-appear {
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
    .ring-wrapper {
      position: relative;
      width: 140px;
      height: 140px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1rem;
    }
    .ring-svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    .ring-track {
      stroke: rgb(229 229 229);
    }
    :global(.dark) .ring-track {
      stroke: rgb(64 64 64);
    }
    .ring-progress {
      stroke: rgb(23 23 23);
      stroke-linecap: round;
      stroke-dashoffset: 301.59;
    }
    .disconnection-rings.in-view .ring-progress {
      animation: ring-fill 0.9s ease-out var(--ring-delay) forwards;
    }
    :global(.dark) .ring-progress {
      stroke: rgb(250 250 250);
    }
    @keyframes ring-fill {
      from {
        stroke-dashoffset: 301.59;
      }
      to {
        stroke-dashoffset: var(--ring-offset);
      }
    }
    .ring-pct {
      position: relative;
      font-size: 1.75rem;
      font-weight: 700;
      color: rgb(23 23 23);
      line-height: 1;
    }
    :global(.dark) .ring-pct {
      color: rgb(250 250 250);
    }
    .ring-label {
      font-size: 0.875rem;
      line-height: 1.4;
      color: rgb(82 82 82);
      max-width: 18rem;
      margin: 0;
      text-align: center;
    }
    :global(.dark) .ring-label {
      color: rgb(163 163 163);
    }

    /* Cashflow section image: even shadow on all sides (no x/y offset) in light and dark */
    .cashflow-img {
      filter: drop-shadow(0 0 8px rgba(0, 0, 0, 0.1))
        drop-shadow(0 0 24px rgba(0, 0, 0, 0.18))
        drop-shadow(0 0 4px rgba(0, 0, 0, 0.06));
    }
    :global(.dark) .cashflow-img {
      filter: drop-shadow(0 0 6px rgba(0, 0, 0, 0.5))
        drop-shadow(0 0 20px rgba(0, 0, 0, 0.3));
    }

    /* Cashflow section: first image animates in from left, second (Sankey) from right */
    .cashflow-reveal-left {
      opacity: 0;
      transform: translateX(-60px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .cashflow-reveal-left.in-view {
      opacity: 1;
      transform: translateX(0);
    }
    .cashflow-reveal-right {
      opacity: 0;
      transform: translateX(60px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .cashflow-reveal-right.in-view {
      opacity: 1;
      transform: translateX(0);
    }
    /* ── Bento card 6: Mini Sankey ── */
    /* Income source nodes — green/teal: "money in" */
    .sk-sa   { fill: #20bf6b; }
    .sk-fr   { fill: #0fb9b1; }
    .sk-ot   { fill: #2bcbba; }
    /* Hub bar */
    .sk-hub  { fill: #a5b1c2; }
    :global(.dark) .sk-hub { fill: #4b6584; }
    /* Right destination nodes: solid palette colours */
    .sk-d1   { fill: #fc5c65; }
    .sk-d2   { fill: #fd9644; }
    .sk-d3   { fill: #fed330; }
    .sk-d4   { fill: #26de81; }
    .sk-d5   { fill: #a55eea; }
    .sk-d6   { fill: #fa8231; }
    /* Wipe reveal: left-to-right when card enters viewport */
    /* How it works: step numbers */
    .how-it-works-num {
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    }
    :global(.dark) .how-it-works-num {
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
    }
    /* How it works: staggered card reveal */
    .how-it-works-step {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    }
    .how-it-works-steps-wrap.in-view .how-it-works-step-1 {
      transition-delay: 0.1s;
    }
    .how-it-works-steps-wrap.in-view .how-it-works-step-2 {
      transition-delay: 0.25s;
    }
    .how-it-works-steps-wrap.in-view .how-it-works-step-3 {
      transition-delay: 0.4s;
    }
    .how-it-works-steps-wrap.in-view .how-it-works-step {
      opacity: 1;
      transform: translateY(0);
    }
    .sankey-reveal {
      clip-path: inset(0 100% 0 0);
    }
    .bento-sankey.in-view .sankey-reveal {
      animation: sankey-wipe 1.4s cubic-bezier(0.4, 0, 0.2, 1) 0.15s forwards;
    }
    @keyframes sankey-wipe {
      to { clip-path: inset(0 0% 0 0); }
    }
  </style>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add('in-view');
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -20px 0px' }
      );
      const rings = document.querySelector('.disconnection-rings');
      if (rings) observer.observe(rings);
      const howItWorksHero = document.querySelector('.how-it-works-hero');
      if (howItWorksHero) observer.observe(howItWorksHero);
      const howItWorksSteps = document.querySelector('.how-it-works-steps-wrap');
      if (howItWorksSteps) observer.observe(howItWorksSteps);
      document
        .querySelectorAll('.cashflow-reveal-left, .cashflow-reveal-right')
        .forEach((el) => observer.observe(el));
      const bentoSankey = document.querySelector('.bento-sankey');
      if (bentoSankey) observer.observe(bentoSankey);
      const ctaCard = document.querySelector('.cta-card-reveal');
      if (ctaCard) observer.observe(ctaCard);
    });
  </script>
