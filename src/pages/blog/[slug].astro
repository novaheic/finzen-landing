---
/**
 * /blog/[slug] — Individual blog post page.
 * Renders a single blog post from the content collection.
 */

import Layout from '@/layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { SITE_URL, SITE_NAME } from '@/data/pages';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date,
  author: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: SITE_URL,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: SITE_URL,
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/logo-light.webp` },
  },
  ...(post.data.image && { image: `${SITE_URL}${post.data.image}` }),
  mainEntityOfPage: `${SITE_URL}/blog/${post.id}`,
});
---

<Layout
  title={`${post.data.title} - Finzen`}
  description={post.data.description}
  canonical={`/blog/${post.id}`}
  ogImage={post.data.image}
  keywords={post.data.keywords}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={articleSchema} />
  </Fragment>

  <article class="w-full py-16 md:py-24 bg-[#ECECEC] dark:bg-[#1B1B1B]">
    <div class="max-w-3xl mx-auto px-6">
      <!-- Back link -->
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-sm text-neutral-400 dark:text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-colors mb-8"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        All posts
      </a>

      <!-- Hero image -->
      {post.data.image && (
        <img
          src={post.data.image}
          alt=""
          width="1200"
          height="630"
          class="w-full rounded-2xl mb-8"
        />
      )}

      <!-- Header -->
      <header class="mb-10 space-y-3">
        <time
          datetime={post.data.date}
          class="text-sm text-neutral-400 dark:text-neutral-500"
        >
          {new Date(post.data.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        <h1 class="text-3xl md:text-4xl font-semibold text-neutral-900 dark:text-neutral-100 leading-tight">
          {post.data.title}
        </h1>
      </header>

      <!-- Content -->
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style>
  .prose {
    color: #404040;
    line-height: 1.75;
  }
  :global(.dark) .prose {
    color: #d4d4d4;
  }

  .prose :global(h2) {
    font-size: 1.375rem;
    font-weight: 600;
    color: #171717;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  :global(.dark) .prose :global(h2) {
    color: #f5f5f5;
  }

  .prose :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    color: #262626;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }
  :global(.dark) .prose :global(h3) {
    color: #e5e5e5;
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
  }

  .prose :global(strong) {
    font-weight: 600;
    color: #171717;
  }
  :global(.dark) .prose :global(strong) {
    color: #f5f5f5;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .prose :global(ul) {
    list-style-type: disc;
  }
  .prose :global(ol) {
    list-style-type: decimal;
  }
  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
    margin: 1.5rem 0;
  }

  .prose :global(blockquote) {
    border-left: 3px solid #d4d4d4;
    padding-left: 1rem;
    font-style: italic;
    color: #737373;
    margin-bottom: 1.25rem;
  }
  :global(.dark) .prose :global(blockquote) {
    border-left-color: #525252;
    color: #a3a3a3;
  }
</style>
