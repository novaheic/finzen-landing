---
/**
 * Layout.astro — Base page layout.
 * Every page wraps its content in this layout.
 * Handles: <head> (via SEO), <Header>, <main>, <Footer>.
 *
 * Usage (in any page .astro file):
 *   ---
 *   import Layout from '@/layouts/Layout.astro';
 *   const meta = pages.home; // or whichever page
 *   ---
 *   <Layout title={meta.title} description={meta.description} canonical={`/${meta.slug}`}>
 *     <!-- Page content here -->
 *   </Layout>
 */

import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
}

const { title, description, canonical, ogImage } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <SEO
    title={title}
    description={description}
    canonical={canonical}
    ogImage={ogImage}
  />
</head>
<body>
  <Header />

  <main>
    <slot />
  </main>

  <Footer />
</body>
</html>
