---
/**
 * Layout.astro — Base page layout.
 * Every page wraps its content in this layout.
 * Handles: <head> (via SEO), <Header>, <main>, <Footer>.
 *
 * Usage (in any page .astro file):
 *   ---
 *   import Layout from '@/layouts/Layout.astro';
 *   const meta = pages.home; // or whichever page
 *   ---
 *   <Layout title={meta.title} description={meta.description} canonical={`/${meta.slug}`}>
 *     <!-- Page content here -->
 *   </Layout>
 */

import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  keywords?: string[] | string;
  showHeaderCTA?: boolean;
}

const { title, description, canonical, ogImage, keywords, showHeaderCTA = true } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Prevent flash: set theme before paint -->
  <script is:inline>
    (function() {
      const stored = localStorage.getItem('finzen-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const dark = stored === 'dark' || (stored !== 'light' && prefersDark);
      document.documentElement.classList.toggle('dark', dark);
    })();
  </script>
  <SEO
    title={title}
    description={description}
    canonical={canonical}
    ogImage={ogImage}
    keywords={keywords}
  />
  <!-- Favicon: match browser/OS theme (tab color) via prefers-color-scheme -->
  <link rel="icon" type="image/webp" href="/logo-light.webp" media="(prefers-color-scheme: light)" id="favicon" />
  <link rel="icon" type="image/webp" href="/logo-dark.webp" media="(prefers-color-scheme: dark)" />
  <script is:inline>
    (function() {
      var link = document.getElementById('favicon');
      if (link && window.matchMedia) {
        var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        link.href = dark ? '/logo-dark.webp' : '/logo-light.webp';
        link.removeAttribute('media');
      }
    })();
  </script>
  <!-- Umami analytics (only when PUBLIC_UMAMI_WEBSITE_ID is set) -->
  {import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
    <script
      async
      src={import.meta.env.PUBLIC_UMAMI_SCRIPT_URL || 'https://cloud.umami.is/script.js'}
      data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}
    />
  )}
</head>
<body>
  <Header showCTA={showHeaderCTA} />

  <main class="overflow-x-clip">
    <slot />
  </main>

  <Footer />
</body>
</html>
