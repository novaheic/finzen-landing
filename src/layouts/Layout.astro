---
/**
 * Layout.astro — Base page layout.
 * Every page wraps its content in this layout.
 * Handles: <head> (via SEO), <Header>, <main>, <Footer>.
 *
 * Usage (in any page .astro file):
 *   ---
 *   import Layout from '@/layouts/Layout.astro';
 *   const meta = pages.home; // or whichever page
 *   ---
 *   <Layout title={meta.title} description={meta.description} canonical={`/${meta.slug}`}>
 *     <!-- Page content here -->
 *   </Layout>
 */

import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { UMAMI_SCRIPT_URL, UMAMI_WEBSITE_ID } from '@/config/analytics';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  keywords?: string[] | string;
  showHeaderCTA?: boolean;
}

const { title, description, canonical, ogImage, keywords, showHeaderCTA = true } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Prevent flash: set theme before paint -->
  <script is:inline>
    (function() {
      const stored = localStorage.getItem('finzen-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const dark = stored === 'dark' || (stored !== 'light' && prefersDark);
      document.documentElement.classList.toggle('dark', dark);
    })();
  </script>
  <script is:inline>
    (function() {
      function syncThemedPictures() {
        const isDark = document.documentElement.classList.contains('dark');
        const pictures = document.querySelectorAll('picture');
        pictures.forEach((picture) => {
          const sources = Array.from(picture.querySelectorAll('source'));
          const hasDarkThemeSource = sources.some((source) =>
            (source.getAttribute('media') || '').includes('prefers-color-scheme: dark')
          );
          if (!hasDarkThemeSource) return;

          sources.forEach((source) => {
            if (!source.dataset.themeVariant) {
              const sourceMedia = source.getAttribute('media') || '';
              source.dataset.themeVariant = sourceMedia.includes('prefers-color-scheme: dark') ? 'dark' : 'light';
            }
            const isSourceDark = source.dataset.themeVariant === 'dark';
            source.setAttribute('media', isDark ? (isSourceDark ? 'all' : 'not all') : (isSourceDark ? 'not all' : 'all'));
          });

          const fallbackImg = picture.querySelector('img');
          if (!fallbackImg) return;
          const currentSrc = fallbackImg.getAttribute('src');
          if (!currentSrc) return;
          const darkSrc = currentSrc.replace('_light.', '_dark.');
          const lightSrc = currentSrc.replace('_dark.', '_light.');
          if (isDark && darkSrc !== currentSrc) fallbackImg.setAttribute('src', darkSrc);
          if (!isDark && lightSrc !== currentSrc) fallbackImg.setAttribute('src', lightSrc);
        });
      }

      function initThemePictureSync() {
        syncThemedPictures();
        window.addEventListener('finzen:theme-change', syncThemedPictures);
        const rootObserver = new MutationObserver(syncThemedPictures);
        rootObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initThemePictureSync);
      } else {
        initThemePictureSync();
      }
    })();
  </script>
  <SEO
    title={title}
    description={description}
    canonical={canonical}
    ogImage={ogImage}
    keywords={keywords}
  />
  <slot name="head" />
  <!-- Favicon: match browser/OS theme (tab color) via prefers-color-scheme -->
  <link rel="icon" type="image/webp" href="/logo-light.webp" media="(prefers-color-scheme: light)" id="favicon" />
  <link rel="icon" type="image/webp" href="/logo-dark.webp" media="(prefers-color-scheme: dark)" />
  <script is:inline>
    (function() {
      var link = document.getElementById('favicon');
      if (link && window.matchMedia) {
        var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        link.href = dark ? '/logo-dark.webp' : '/logo-light.webp';
        link.removeAttribute('media');
      }
    })();
  </script>
  <!-- Umami analytics: uses env vars or fallback in src/config/analytics.ts -->
  {UMAMI_WEBSITE_ID ? (
    <>
      <!-- Umami: enabled -->
      <script defer src={UMAMI_SCRIPT_URL} data-website-id={UMAMI_WEBSITE_ID} />
    </>
  ) : null}
</head>
<body>
  <Header showCTA={showHeaderCTA} />

  <main class="overflow-x-clip">
    <slot />
  </main>

  <Footer />
</body>
</html>
